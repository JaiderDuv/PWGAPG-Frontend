@page "/costos-fijos"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@using PWGAPG_Frontend.Components
@inject CosteoApiService Api

<div class="rc-page container py-4">
    <div class="rc-header">
        <div>
            <h2 class="rc-title">Costos fijos del negocio</h2>
            <p class="rc-subtitle">
                Arriendo, servicios, nómina... Son gastos que pagas todos los meses, aunque no vendas.
                Aquí los repartimos entre las preparaciones base que haces al mes para saber cuánto le corresponde a cada una.
            </p>
        </div>
        @if (!mostrarForm)
        {
            <button class="btn btn-primary" @onclick="Nuevo">+ Nuevo costo fijo</button>
        }
    </div>

    <div class="rc-card mb-3">
        <div class="rc-card-header">
            <div>
                <h5 class="mb-0">Preparaciones base al mes</h5>
                <small class="text-muted">Un solo valor para todos los costos fijos del negocio.</small>
            </div>
        </div>
        <div class="rc-card-body">
            <EditForm Model="configModelo" OnValidSubmit="GuardarPreparacionesBaseMes" novalidate>
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="rc-label" for="preparaciones-base-mes">
                            Preparaciones base al mes
                            <span class="campo-ayuda" tabindex="0"
                                  data-tip="Cuenta cada vez que preparas una receta completa (un lote base). Ej.: 5 lotes de masa base + 4 lotes de salsa = 9 preparaciones base. No cuentes porciones individuales.">?</span>
                        </label>
                        <div class="input-group">
                            <InputNumber id="preparaciones-base-mes" class="form-control"
                                         @bind-Value="configModelo.PreparacionesBaseMes"
                                         min="1" step="1" placeholder="Ej.: 60" />
                            <button type="submit" class="btn btn-primary" disabled="@guardandoPreparaciones">
                                @(guardandoPreparaciones ? "Guardando..." : "Guardar")
                            </button>
                        </div>
                        <ValidationMessage For="() => configModelo.PreparacionesBaseMes" class="rc-error" />
                    </div>
                    <div class="col-md-7">
                        <div class="cs-aviso cs-aviso-info mb-0">
                            <div>
                                <strong>¿Qué se cuenta?</strong>
                                Cada vez que preparas una receta completa (un lote base) cuenta como 1.
                                Ejemplo: 5 lotes de masa base + 4 lotes de salsa = 9 preparaciones base.
                                No cuentes porciones individuales: un lote de 12 muffins cuenta como 1, no como 12.
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>

            @if (errorPreparaciones is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@errorPreparaciones</div>
            }

            @if (preparacionesBaseMes is null)
            {
                <div class="cs-aviso cs-aviso-warn mt-3 mb-0">
                    <div>
                        <strong>Aún no has definido este valor.</strong>
                        Mientras no lo guardes, los costos fijos no se incluirán en el costo completo de recetas y productos.
                    </div>
                </div>
            }
            else
            {
                <div class="cs-preview mt-3">
                    <div>
                        <strong>Cuota por preparación:</strong> @Formato.Moneda(CuotaGlobal)
                        <span class="text-muted">(@Formato.Moneda(TotalMensual) de costos fijos activos ÷ @preparacionesBaseMes preparaciones base)</span>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Este mismo valor se usa para todos los costos fijos.
                    </small>
                </div>

                @if (preparacionesBaseMes < 10)
                {
                    <div class="cs-aviso cs-aviso-warn mt-3 mb-0">
                        <div>
                            <strong>Revisa el valor:</strong> con menos de 10 preparaciones base al mes,
                            la cuota puede quedar muy alta. Verifica que corresponda a tu producción real.
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @if (mensajeOk is not null) { <div class="alert alert-success">@mensajeOk</div> }
    @if (error is not null) { <div class="alert alert-danger">@error</div> }

    @if (mostrarForm)
    {
        <div class="rc-card">
            <div class="rc-card-header">
                <h5 class="mb-0">@(editando is null ? "Nuevo costo fijo" : $"Editar costo fijo #{editando.Id}")</h5>
            </div>
            <EditForm Model="modelo" OnValidSubmit="Guardar" class="rc-card-body" novalidate>
                <DataAnnotationsValidator />

                <div class="cs-aviso cs-aviso-info mb-3">
                    <div>
                        <strong>¿Cómo se usa este costo?</strong>
                        El monto mensual se divide entre las preparaciones base al mes que definiste arriba.
                        Así obtenemos una cuota por preparación, que se suma al <strong>costo completo</strong> de recetas y productos.
                        Esa cuota no cambia el costo directo ni el precio sugerido: los costos fijos se cubren con el punto de equilibrio.
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="rc-label">
                            Nombre *
                            <span class="campo-ayuda" tabindex="0"
                                  data-tip="Nombre con el que identificarás el costo fijo. Ej.: Arriendo del local, Nómina, Internet.">?</span>
                        </label>
                        <InputText class="form-control" @bind-Value="modelo.Nombre" maxlength="150"
                                   placeholder="Ej: Arriendo del local" />
                        <ValidationMessage For="() => modelo.Nombre" class="rc-error" />
                    </div>
                    <div class="col-md-6">
                        <label class="rc-label">
                            Categoría *
                            <span class="campo-ayuda" tabindex="0"
                                  data-tip="Agrupa el costo para analizarlo. Puedes elegir una sugerencia o escribir tu propia categoría. Ej.: Arriendo, Servicios, Nómina.">?</span>
                        </label>
                        <InputText class="form-control" @bind-Value="modelo.Categoria" maxlength="50"
                                   list="categorias-costo-fijo" placeholder="Ej: Arriendo" />
                        <datalist id="categorias-costo-fijo">
                            @foreach (var cat in CategoriasBase) { <option value="@cat"></option> }
                        </datalist>
                        <ValidationMessage For="() => modelo.Categoria" class="rc-error" />
                    </div>
                    <div class="col-md-6">
                        <label class="rc-label">
                            Monto mensual *
                            <span class="campo-ayuda" tabindex="0"
                                  data-tip="Valor total que pagas al mes por este costo. Ej.: 1.000.000 de arriendo. No cambia el costo directo de los productos.">?</span>
                        </label>
                        <InputNumber class="form-control" @bind-Value="modelo.MontoMensual" min="0" step="1" />
                        <ValidationMessage For="() => modelo.MontoMensual" class="rc-error" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="cf-activo" @bind-Value="modelo.Activo" />
                            <label class="form-check-label" for="cf-activo">
                                Activo (se incluye en el costo completo)
                                <span class="campo-ayuda" tabindex="0"
                                      data-tip="Si está activo, entra en el costo completo y en el análisis del punto de equilibrio. Desactívalo si ya no pagas ese costo, sin borrar el historial.">?</span>
                            </label>
                        </div>
                    </div>
                </div>

                @if (modelo.MontoMensual > 0 && preparacionesBaseMes is > 0)
                {
                    <div class="cs-preview">
                        <div>
                            <strong>Cuota por preparación:</strong> @Formato.Moneda(modelo.MontoMensual / preparacionesBaseMes.Value)
                            <span class="text-muted">(monto mensual ÷ preparaciones base al mes)</span>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Si produces @preparacionesBaseMes preparaciones base al mes, cada una carga esta cuota en el costo completo.
                            El costo directo del producto no cambia.
                        </small>
                    </div>
                }
                else if (modelo.MontoMensual > 0)
                {
                    <div class="cs-aviso cs-aviso-info mt-2">
                        <div>
                            Define las preparaciones base al mes arriba para ver la cuota de este costo.
                        </div>
                    </div>
                }

                @if (errorForm is not null) { <div class="alert alert-danger mt-3">@errorForm</div> }

                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarForm" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @if (costos is null)
    {
        <p class="text-muted">Cargando...</p>
    }
    else if (costos.Count == 0)
    {
        <div class="rc-empty">
            <p>Aún no tienes costos fijos. Agrega el primero para obtener un costo completo más preciso.</p>
        </div>
    }
    else
    {
        <div class="rc-card">
            <div class="table-responsive">
                <table class="table cs-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th class="text-end">Monto mensual</th>
                            <th class="text-end" title="Monto mensual ÷ preparaciones base al mes. Es la cuota que se suma al costo completo de cada preparación; no es el total mensual del costo.">Cuota por preparación</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in costos)
                    {
                        <tr class="@(c.Activo ? "" : "cs-inactivo")">
                            <td>@c.Nombre</td>
                            <td><span class="badge rounded-pill text-bg-light">@Categoria(c)</span></td>
                            <td class="text-end">@Formato.Moneda(c.MontoMensual)</td>
                            <td class="text-end">
                                @if (Aporte(c) is { } aporte)
                                {
                                    @Formato.Moneda(aporte)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm @(c.Activo ? "btn-outline-success" : "btn-outline-secondary")"
                                        @onclick="() => CambiarEstado(c)">
                                    @(c.Activo ? "Activo" : "Inactivo")
                                </button>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(c)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(c)">Eliminar</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong>Total activos</strong></td>
                            <td></td>
                            <td class="text-end"><strong>@Formato.Moneda(TotalMensual)</strong></td>
                            <td class="text-end"><strong>@(preparacionesBaseMes is > 0 ? Formato.Moneda(CuotaGlobal) : "—")</strong></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="text-muted mt-2 mb-0 px-3 pb-2">
                <small>
                    La cuota por preparación es el monto mensual dividido entre las preparaciones base al mes.
                    El total mensual del costo es la columna "Monto mensual"; la cuota se usa para el costo completo,
                    no para el precio directo.
                </small>
            </p>
        </div>
    }

    @if (costos is not null && costos.Any(c => c.Activo))
    {
        <div class="rc-card mt-3">
            <div class="rc-card-header">
                <h5 class="mb-0">Resumen por categoría</h5>
            </div>
            <div class="rc-card-body">
                <div class="cs-kpis">
                    @foreach (var g in ResumenCategorias)
                    {
                        <div class="cs-kpi">
                            <small>@g.Key</small>
                            <strong>@Formato.Moneda(g.Sum(c => c.MontoMensual))</strong>
                            <em>@g.Count() costo(s)</em>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (costos is not null)
    {
        <div class="rc-card mt-4">
            <div class="rc-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="mb-0">Punto de equilibrio mensual</h5>
                    <small class="text-muted">
                        Cuánto necesitas vender para cubrir tus costos fijos, según el
                        margen de contribución de tus productos (precio − costo directo).
                    </small>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CargarPuntoEquilibrio" disabled="@cargandoEquilibrio">
                    @(cargandoEquilibrio ? "Calculando..." : "Recalcular")
                </button>
            </div>
            <div class="rc-card-body">
                @if (errorEquilibrio is not null)
                {
                    <div class="alert alert-danger mb-0">@errorEquilibrio</div>
                }
                else if (equilibrio is null)
                {
                    <p class="text-muted mb-0">Calculando punto de equilibrio...</p>
                }
                else
                {
                    <div class="cs-kpis">
                        <div class="cs-kpi">
                            <small>Costos fijos mensuales</small>
                            <strong>@Formato.Moneda(equilibrio.CostosFijosMensuales)</strong>
                        </div>
                        <div class="cs-kpi">
                            <small>Margen de contribución promedio</small>
                            <strong>@(equilibrio.MargenContribucionPromedioPorcentaje.HasValue ? equilibrio.MargenContribucionPromedioPorcentaje.Value.ToString("0.##") + " %" : "—")</strong>
                        </div>
                        <div class="cs-kpi cs-kpi-main">
                            <small>Ventas de equilibrio / mes</small>
                            <strong>@(equilibrio.VentasEquilibrioMensuales.HasValue ? Formato.Moneda(equilibrio.VentasEquilibrioMensuales.Value) : "—")</strong>
                        </div>
                    </div>

                    @foreach (var a in equilibrio.Advertencias)
                    {
                        <div class="cs-aviso cs-aviso-info"><div>@a</div></div>
                    }

                    @if (equilibrio.Productos.Count > 0)
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm cs-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Precio</th>
                                        <th class="text-end">Costo directo</th>
                                        <th class="text-end">Margen contribución</th>
                                        <th class="text-end">Margen %</th>
                                        <th class="text-end">Unidades/mes*</th>
                                        <th class="text-end">Ventas/mes*</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in equilibrio.Productos)
                                {
                                    <tr>
                                        <td>@p.Producto</td>
                                        <td class="text-end">@Formato.Moneda(p.PrecioVenta)</td>
                                        <td class="text-end">@Formato.Moneda(p.CostoDirecto)</td>
                                        <td class="text-end">@Formato.Moneda(p.MargenContribucion)</td>
                                        <td class="text-end">@p.MargenContribucionPorcentaje.ToString("0.##") %</td>
                                        <td class="text-end">@(p.UnidadesEquilibrio.HasValue ? p.UnidadesEquilibrio.Value.ToString("0") : "—")</td>
                                        <td class="text-end">@(p.VentasEquilibrio.HasValue ? Formato.Moneda(p.VentasEquilibrio.Value) : "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted mt-2 mb-0">
                            <small>
                                * Unidades y ventas si vendieras únicamente ese producto.
                                El total global usa el margen de contribución promedio y
                                supone un mix uniforme de productos.
                            </small>
                        </p>
                    }
                }
            </div>
        </div>
    }
</div>

<ConfirmDialog Visible="mostrarConfirm"
               Mensaje="@($"¿Eliminar el costo fijo '{aEliminar?.Nombre}' para siempre? Cambiará el costo completo de tus recetas.")"
               OnConfirmar="ConfirmarEliminar"
               OnCancelar="CancelarEliminar" />

@code {
    // Categorías sugeridas en el formulario. El campo es libre: el usuario
    // puede escribir otra y se conserva tal cual.
    private static readonly string[] CategoriasBase =
    {
        "Arriendo", "Nómina", "Servicios", "Equipos", "Marketing",
        "Administración", "Impuestos", "Mantenimiento", "Otros"
    };

    private List<CostoFijoDto>? costos;
    private CostoFijoDto? editando, aEliminar;
    private FormModelo modelo = new();
    private PreparacionesFormModelo configModelo = new();
    private bool mostrarForm, mostrarConfirm, guardando, guardandoPreparaciones;
    private string? error, errorForm, errorPreparaciones, mensajeOk;

    private int? preparacionesBaseMes;

    // Punto de equilibrio: ventas mínimas para cubrir los costos fijos.
    private PuntoEquilibrioDto? equilibrio;
    private bool cargandoEquilibrio;
    private string? errorEquilibrio;

    private decimal? Aporte(CostoFijoDto c) =>
        preparacionesBaseMes is > 0 ? c.MontoMensual / preparacionesBaseMes.Value : null;

    private decimal TotalMensual => costos?.Where(c => c.Activo).Sum(c => c.MontoMensual) ?? 0;
    private decimal CuotaGlobal => preparacionesBaseMes is > 0 ? TotalMensual / preparacionesBaseMes.Value : 0;

    private static string Categoria(CostoFijoDto c) =>
        string.IsNullOrWhiteSpace(c.Categoria) ? "Otros" : c.Categoria;

    private IEnumerable<IGrouping<string, CostoFijoDto>> ResumenCategorias =>
        (costos ?? new List<CostoFijoDto>())
            .Where(c => c.Activo)
            .GroupBy(Categoria, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Sum(c => c.MontoMensual));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        var res = await Api.ObtenerConfiguracionCostosFijosAsync();
        if (res.Exito && res.Datos is not null)
        {
            costos = res.Datos.Costos;
            preparacionesBaseMes = res.Datos.PreparacionesBaseMes;
            configModelo.PreparacionesBaseMes = preparacionesBaseMes;
            error = null;
        }
        else
        {
            costos = new();
            error = res.Mensaje;
        }
        await CargarPuntoEquilibrio();
    }

    // El punto de equilibrio se recalcula cada vez que cambian los costos fijos.
    private async Task CargarPuntoEquilibrio()
    {
        cargandoEquilibrio = true;
        var res = await Api.ObtenerPuntoEquilibrioAsync();
        cargandoEquilibrio = false;
        if (res.Exito) { equilibrio = res.Datos; errorEquilibrio = null; }
        else { equilibrio = null; errorEquilibrio = res.Mensaje; }
    }

    private void Nuevo() { editando = null; modelo = new(); AbrirForm(); }

    private void Editar(CostoFijoDto c)
    {
        editando = c;
        modelo = new FormModelo
        {
            Nombre = c.Nombre,
            Categoria = Categoria(c),
            MontoMensual = c.MontoMensual,
            Activo = c.Activo
        };
        AbrirForm();
    }

    private void AbrirForm() { mensajeOk = error = errorForm = null; mostrarForm = true; }
    private void CerrarForm() => mostrarForm = false;

    private async Task GuardarPreparacionesBaseMes()
    {
        errorPreparaciones = null;
        guardandoPreparaciones = true;
        var res = await Api.ActualizarPreparacionesBaseMesAsync(configModelo.PreparacionesBaseMes);
        guardandoPreparaciones = false;

        if (!res.Exito || res.Datos is null)
        {
            errorPreparaciones = res.Mensaje ?? "No se pudieron actualizar las preparaciones base al mes.";
            return;
        }

        preparacionesBaseMes = res.Datos.PreparacionesBaseMes;
        costos = res.Datos.Costos;
        configModelo.PreparacionesBaseMes = preparacionesBaseMes;
        mensajeOk = "Preparaciones base al mes actualizadas correctamente.";
        error = null;
        await CargarPuntoEquilibrio();
    }

    private async Task Guardar()
    {
        errorForm = null; guardando = true;
        var nombre = modelo.Nombre.Trim();

        var res = editando is null
            ? await Api.CrearCostoFijoAsync(new CrearCostoFijoDto
              {
                  Nombre = nombre,
                  Categoria = modelo.Categoria.Trim(),
                  MontoMensual = modelo.MontoMensual,
                  Activo = modelo.Activo
              })
            : await Api.ActualizarCostoFijoAsync(editando.Id, new ActualizarCostoFijoDto
              {
                  Nombre = nombre,
                  Categoria = modelo.Categoria.Trim(),
                  MontoMensual = modelo.MontoMensual,
                  Activo = modelo.Activo
              });
        guardando = false;

        if (!res.Exito) { errorForm = res.Mensaje; return; }
        mensajeOk = editando is null ? "Costo fijo creado correctamente." : "Costo fijo actualizado correctamente.";
        mostrarForm = false;
        await Cargar();
    }

    private async Task CambiarEstado(CostoFijoDto c)
    {
        var res = await Api.ActualizarCostoFijoAsync(c.Id, new ActualizarCostoFijoDto { Activo = !c.Activo });
        if (res.Exito) { mensajeOk = null; error = null; }
        else { error = res.Mensaje; }
        await Cargar();
    }

    private void PedirEliminar(CostoFijoDto c) { aEliminar = c; mostrarConfirm = true; }
    private void CancelarEliminar() { mostrarConfirm = false; aEliminar = null; }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirm = false;
        var res = await Api.EliminarCostoFijoAsync(aEliminar!.Id);
        if (res.Exito) { mensajeOk = "Costo fijo eliminado correctamente."; error = null; }
        else { error = res.Mensaje; mensajeOk = null; }
        aEliminar = null;
        await Cargar();
    }

    private class FormModelo
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(150, MinimumLength = 3, ErrorMessage = "El nombre debe tener entre 3 y 150 caracteres.")]
        [RegularExpression(@"^(?=.*\p{L})[\p{L}\p{N} .,'\-()&]+$",
            ErrorMessage = "Solo letras, números, espacios y . , ' - ( ) & (debe incluir letras).")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "La categoría es obligatoria.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "La categoría debe tener entre 2 y 50 caracteres.")]
        public string Categoria { get; set; } = "Otros";

        [Range(0.01, 9999999999, ErrorMessage = "El monto debe ser mayor a 0.")]
        public decimal MontoMensual { get; set; }

        public bool Activo { get; set; } = true;
    }

    private class PreparacionesFormModelo
    {
        [Range(1, 1000000, ErrorMessage = "Las preparaciones base al mes deben estar entre 1 y 1.000.000.")]
        public int? PreparacionesBaseMes { get; set; }
    }
}
