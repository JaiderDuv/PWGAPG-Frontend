@page "/insumos/{id:int}/historial"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@inject PWGAPG_Frontend.Services.InsumoService InsumoService
@inject NavigationManager Navigation

<PageTitle>Historial de precios | Chef Metrics</PageTitle>

<div class="insumos-shell">
    <button type="button" class="btn-outline" @onclick='() => Navigation.NavigateTo("insumos")'>
        ← Volver a insumos
    </button>

    @if (cargando)
    {
        <section class="perfil-cargando-card" aria-live="polite" style="margin-top: 16px;">
            <div class="perfil-spinner" aria-hidden="true"></div>
            <h2>Cargando historial</h2>
            <p>Estamos consultando los precios del insumo.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert" style="margin-top: 16px;">@mensajeError</div>
    }
    else if (historial is not null)
    {
        <div class="insumos-heading" style="margin-top: 16px;">
            <div>
                <span class="perfil-kicker">HISTORIAL DE PRECIOS</span>
                <h1>@historial.Nombre</h1>
                @if (historial.InsumoEliminado)
                {
                    <p class="text-muted" style="font-size:0.85rem;">Este insumo fue eliminado. Se conserva su historial de precios.</p>
                }
                <p>
                    @(historial.InsumoEliminado ? "Último precio registrado" : "Precio actual"): <strong>$@historial.PrecioActual.ToString("N2")</strong>
                    @(string.IsNullOrWhiteSpace(historial.ProveedorActual) ? "" : $"· {historial.ProveedorActual}")
                </p>
            </div>
        </div>

        <section class="insumos-toolbar">
            @if (nombresProveedores is null)
            {
                <input class="form-control insumos-buscador"
                       placeholder="Filtrar por proveedor..."
                       value="@filtroProveedor"
                       @oninput="OnFiltroProveedorInput" />
            }
            else
            {
                <select class="form-select insumos-buscador" value="@filtroProveedor" @onchange="OnFiltroProveedorSelect">
                    <option value="">Todos los proveedores</option>
                    @foreach (var nombre in nombresProveedores)
                    {
                        <option value="@nombre">@nombre</option>
                    }
                </select>
            }
        </section>
        @if (nombresProveedores is not null && !nombresProveedores.Any())
        {
            <p class="text-muted" style="font-size:0.85rem;">No hay proveedores registrados.</p>
        }

        @if (!gruposFiltrados.Any())
        {
            <p class="text-muted">@MensajeVacioFiltro</p>
        }
        else
        {
            @foreach (var grupo in gruposFiltrados)
            {
                <h3 class="insumos-grupo-titulo">@grupo.Proveedor</h3>
                <div class="insumos-tabla-wrap" style="margin-bottom: 20px;">
                    <table class="insumos-tabla">
                        <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Precio</th>
                                    <th>Cantidad</th>
                                    <th>P. unitario</th>
                                    <th>Diferencia</th>
                                    <th>Variación vs. anterior</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entrada in grupo.Entradas)
                                {
                                    <tr>
                                        <td>@entrada.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><strong>$@entrada.Precio.ToString("N2")</strong></td>
                                        <td>@(entrada.Cantidad.HasValue ? entrada.Cantidad.Value.ToString("N3") : "—")</td>
                                        <td>@(entrada.PrecioUnitario.HasValue ? $"${entrada.PrecioUnitario.Value:N2}" : "—")</td>
                                        <td>@TextoDiferencia(entrada)</td>
                                        <td>@BadgeVariacion(entrada)</td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private HistorialPreciosDto? historial;
    private bool cargando = true;
    private string? mensajeError;
    private string filtroProveedor = string.Empty;
    private List<string>? nombresProveedores;

    private string MensajeVacioFiltro
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroProveedor))
            {
                return "No hay registros para el filtro indicado.";
            }
            var prov = filtroProveedor.Trim();
            if (nombresProveedores is not null
                && !nombresProveedores.Contains(prov, StringComparer.OrdinalIgnoreCase))
            {
                return $"El proveedor '{prov}' no existe.";
            }
            return $"El proveedor '{prov}' no tiene movimientos en este insumo.";
        }
    }

    private List<GrupoProveedor> gruposFiltrados => (historial?.Precios ?? new())
        .GroupBy(e => string.IsNullOrWhiteSpace(e.Proveedor) ? "Sin proveedor" : e.Proveedor.Trim())
        .Select(g => new GrupoProveedor(
            g.Key,
            g.OrderByDescending(e => e.Fecha)
             .Where(e => CoincideProveedor(e.Proveedor, filtroProveedor))
             .ToList()))
        .Where(g => g.Entradas.Count > 0)
        .OrderBy(g => g.Proveedor)
        .ToList();

    private bool CoincideProveedor(string? valor, string filtro)
    {
        if (string.IsNullOrWhiteSpace(filtro)) return true;
        var v = (valor ?? string.Empty).Trim();
        var f = filtro.Trim();
        // Elegido de la lista: coincidencia exacta; escrito a mano: contiene.
        if (nombresProveedores is not null && nombresProveedores.Contains(f, StringComparer.OrdinalIgnoreCase))
        {
            return string.Equals(v, f, StringComparison.OrdinalIgnoreCase);
        }
        return v.Contains(f, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var provs = await InsumoService.ListarProveedoresNegocioAsync();
            nombresProveedores = provs.Success && provs.Data is not null
                ? provs.Data.Select(p => p.Nombre)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Select(n => n.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList()
                : new List<string>();
        }
        catch
        {
            nombresProveedores = null;
        }

        try
        {
            var resultado = await InsumoService.ObtenerHistorialPreciosAsync(Id);
            if (resultado.Success && resultado.Data is not null)
            {
                historial = resultado.Data;
            }
            else if (resultado.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                mensajeError = resultado.Message ?? "No se encontró el insumo solicitado.";
            }
            else
            {
                mensajeError = resultado.Message ?? "No se pudo cargar el historial de precios.";
            }
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnFiltroProveedorInput(ChangeEventArgs e)
    {
        filtroProveedor = e.Value?.ToString() ?? string.Empty;
    }

    private void OnFiltroProveedorSelect(ChangeEventArgs e)
    {
        filtroProveedor = e.Value?.ToString() ?? string.Empty;
    }

    private static string TextoDiferencia(HistorialPrecioDto entrada)
    {
        if (entrada.Diferencia is null)
        {
            return "—";
        }

        var signo = entrada.Diferencia.Value > 0 ? "+" : "";
        return $"{signo}${entrada.Diferencia.Value:N2}";
    }

    private static RenderFragment BadgeVariacion(HistorialPrecioDto entrada) => builder =>
    {
        if (entrada.VariacionPorcentual is null || entrada.EsSubida is null)
        {
            var texto = entrada.VariacionPorcentual is null
                ? "Precio más antiguo"
                : "Sin cambios";
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "insumos-badge insumos-badge-neutro");
            builder.AddContent(2, texto);
            builder.CloseElement();
            return;
        }

        var subida = entrada.EsSubida.Value;
        var signo = entrada.VariacionPorcentual.Value > 0 ? "+" : "";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class",
            $"insumos-badge {(subida ? "insumos-badge-subida" : "insumos-badge-bajada")}");
        builder.AddContent(2, $"{(subida ? "▲" : "▼")} {signo}{entrada.VariacionPorcentual.Value:N2}%");
        builder.CloseElement();
    };

    private sealed record GrupoProveedor(string Proveedor, List<HistorialPrecioDto> Entradas);
}
