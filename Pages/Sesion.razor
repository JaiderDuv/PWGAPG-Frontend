@page "/login"
@using System.ComponentModel.DataAnnotations
@inject PWGAPG_Frontend.Services.AuthService AuthService
@using PWGAPG_Frontend.Models
@inject NavigationManager Navigation

<div class="auth-card-login">
    <h2 class="auth-titulo">Iniciar Sesión</h2>
    <p class="auth-subtitulo">
        Ingresa tus credenciales para acceder a la plataforma
    </p>

    <!-- Mensaje 1: Confirmación de Cuenta -->
    @if (CuentaConfirmada)
    {
        <div class="alert-exito">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l4.992-6.005a.75.75 0 0 0-.012-1.054z" />
            </svg>
            <span>¡Tu cuenta ha sido confirmada con éxito! Ya puedes iniciar sesión.</span>
        </div>
    }

    <!-- Mensaje 2: Cambio de Contraseña de Éxito (NUEVO) -->
    @if (PasswordCambiada)
    {
        <div class="alert-exito">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l4.992-6.005a.75.75 0 0 0-.012-1.054z" />
            </svg>
            <span>Contraseña guardada correctamente.</span>
        </div>
    }

    @if (CorreoPendiente)
    {
        <div class="alert-exito">
            <span>El correo de la cuenta cambió. Confirma el nuevo correo antes de iniciar sesión.</span>
        </div>
    }

    <EditForm Model="@modelo" OnValidSubmit="@ManejarLogin">
        <DataAnnotationsValidator />

        <!-- 1. Correo Electrónico -->
        <div class="form-group">
            <label class="auth-label">Correo Electrónico *</label>
            <InputText @bind-Value="modelo.CorreoElectronico" class="form-control" type="email" placeholder="ejemplo@correo.com" />
            <ValidationMessage For="@(() => modelo.CorreoElectronico)" class="text-danger msg-error" />
        </div>

        <!-- 2. Contraseña -->
        <div class="form-group-sm">
            <label class="auth-label">Contraseña *</label>
            <div class="campo-password-container">
                <InputText @bind-Value="modelo.Password" type="@tipoCampoPassword" class="form-control input-password" placeholder="••••••••" />

                <button type="button" class="btn-ojo-password" @onclick="AlternarVisibilidadPassword">
                    @if (mostrarPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z" />
                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.709.709zm10.296 8.884-12-12 .708-.708 12 12-.708.707z" />
                        </svg>
                    }
                </button>
            </div>
            <ValidationMessage For="@(() => modelo.Password)" class="text-danger msg-error" />
        </div>

        <div class="recuperar-container">
            <NavLink href="recuperar-contrasena" class="link-recuperar">
                ¿Olvidaste tu contraseña?
            </NavLink>
        </div>

        @if (mensajeErrorLogin != null)
        {
            <div class="text-danger msg-error">@mensajeErrorLogin</div>
        }

        <button type="submit" class="btn-solid btn-full">
            Iniciar Sesión
        </button>
    </EditForm>

    <hr class="divider" />

    <div class="auth-footer">
        ¿Aún no tienes una cuenta?
        <a href="registro" class="link-destacado">
            Regístrate aquí
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "confirmado")]
    public bool CuentaConfirmada { get; set; }

    // NUEVA PROPIEDAD
    [SupplyParameterFromQuery(Name = "passwordCambiada")]
    public bool PasswordCambiada { get; set; }

    [SupplyParameterFromQuery(Name = "correoPendiente")]
    public bool CorreoPendiente { get; set; }

    private LoginDTO modelo = new LoginDTO();
    private bool mostrarPassword = false;
    private string tipoCampoPassword => mostrarPassword ? "text" : "password";

    private void AlternarVisibilidadPassword()
    {
        mostrarPassword = !mostrarPassword;
    }

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("dashboard-empresa", replace: true);
        }
    }

    private string? mensajeErrorLogin;

    private async Task ManejarLogin()
    {
        mensajeErrorLogin = null;

        var resultado = await AuthService.Login(modelo);

        if (resultado is { Exito: true })
        {
            Navigation.NavigateTo("dashboard-empresa");
        }
        else
        {
            mensajeErrorLogin = resultado?.Mensaje ?? "Correo o contraseña incorrectos.";
        }
    }
}
