@page "/editar-perfil"
@attribute [Authorize]
@using System.Net
@using System.ComponentModel.DataAnnotations
@using PWGAPG_Frontend.Components
@using PWGAPG_Frontend.Models
@inject PWGAPG_Frontend.Services.PerfilService PerfilService
@inject PWGAPG_Frontend.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Editar perfil | Chef Metrics</PageTitle>

<NavigationLock OnBeforeInternalNavigation="(context => OnAntesDeNavegar(context))" />

<div class="perfil-edicion-shell">
    <div class="perfil-edicion-heading">
        <div>
            <span class="perfil-kicker">CUENTA Y NEGOCIO</span>
            <h1>Editar perfil</h1>
            <p>Revisa y actualiza la información guardada de tu emprendimiento.</p>
        </div>
        <button type="button" class="btn-outline perfil-cancelar" @onclick="VolverAlDashboard">
            Cancelar
        </button>
    </div>

    @if (fase == FaseEdicion.ConfirmarIdentidad)
    {
        <section class="perfil-verificacion-card">
            <div class="perfil-verificacion-icon" aria-hidden="true">✓</div>
            <span class="perfil-kicker">PASO 1 DE 2</span>
            <h2>Confirma tu identidad</h2>
            <p>Por seguridad, ingresa la contraseña actual de tu cuenta antes de consultar o modificar tus datos.</p>

            <EditForm Model="confirmacion" OnValidSubmit="ConfirmarIdentidadAsync">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label class="auth-label" for="password-edicion">Contraseña actual</label>
                    <div class="campo-password-container">
                        <InputText id="password-edicion"
                                   @bind-Value="confirmacion.Password"
                                   type="@(mostrarPassword ? "text" : "password")"
                                   class="form-control input-password"
                                   autocomplete="off" />
                        <button type="button"
                                class="btn-ojo-password"
                                @onclick="AlternarPassword"
                                aria-label="@(mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                title="@(mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña")">
                            @if (mostrarPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.133 13.133 0 0 1 1.173 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z" />
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                                    <path d="m3.35 5.47-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.709.709zm10.296 8.884-12-12 .708-.708 12 12-.708.707z" />
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => confirmacion.Password)" class="text-danger msg-error" />
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeError))
                {
                    <div class="perfil-alerta perfil-alerta-error" role="alert">@mensajeError</div>
                }

                <button type="submit" class="btn-solid btn-full" disabled="@procesando">
                    @(procesando ? "Verificando..." : "Continuar")
                </button>
            </EditForm>
        </section>
    }
    else if (fase == FaseEdicion.Cargando)
    {
        <section class="perfil-cargando-card" aria-live="polite">
            <div class="perfil-spinner" aria-hidden="true"></div>
            <h2>Cargando tu información</h2>
            <p>Estamos consultando los datos actuales de tu cuenta.</p>
        </section>
    }
    else
    {
        <EditForm Model="perfil" OnValidSubmit="SolicitarGuardarAsync" class="perfil-formulario">
            <DataAnnotationsValidator />

            <div class="perfil-formulario-topline">
                <div>
                    <span class="perfil-kicker">PASO 2 DE 2</span>
                    <h2>Información editable</h2>
                </div>
                <span class="perfil-sello">Datos cargados desde tu cuenta</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensajeError))
            {
                <div class="perfil-alerta perfil-alerta-error" role="alert">@mensajeError</div>
            }

            @if (guardado)
            {
                <div class="perfil-alerta perfil-alerta-exito" role="status">
                    @(mensajeExito ?? "Los cambios se guardaron correctamente.")
                </div>
            }

            <section class="perfil-seccion">
                <div class="perfil-seccion-heading">
                    <div>
                        <span class="perfil-seccion-numero">01</span>
                        <h3>Datos de la cuenta</h3>
                    </div>
                    <span>Identidad y contacto principal</span>
                </div>

                <div class="perfil-grid">
                    <div class="form-group">
                        <label class="auth-label" for="correo-cuenta">Correo de la cuenta</label>
                        <InputText id="correo-cuenta"
                                   @bind-Value="perfil.CorreoCuenta"
                                   type="email"
                                   class="form-control perfil-campo-readonly"
                                   readonly="readonly" />
                        <ValidationMessage For="@(() => perfil.CorreoCuenta)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group">
                        <label class="auth-label" for="correo-contacto">Correo electrónico de contacto</label>
                        <InputText id="correo-contacto" @bind-Value="perfil.CorreoContacto" type="email" class="form-control" />
                        <ValidationMessage For="@(() => perfil.CorreoContacto)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group">
                        <label class="auth-label" for="telefono-contacto">Teléfono de contacto</label>
                        <InputText id="telefono-contacto" @bind-Value="perfil.TelefonoContacto" type="tel" class="form-control" />
                        <ValidationMessage For="@(() => perfil.TelefonoContacto)" class="text-danger msg-error" />
                    </div>
                </div>
            </section>

            <section class="perfil-seccion">
                <div class="perfil-seccion-heading">
                    <div>
                        <span class="perfil-seccion-numero">02</span>
                        <h3>Datos del emprendimiento</h3>
                    </div>
                    <span>Información comercial</span>
                </div>
                <div class="perfil-grid">
                    <div class="form-group perfil-switch-group">
                        <label class="auth-label" for="formalizado">¿Está formalizado?</label>
                        <InputSelect id="formalizado" @bind-Value="perfil.Formalizado" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label class="auth-label" for="nombre-emprendimiento">Nombre del emprendimiento</label>
                        <InputText id="nombre-emprendimiento" @bind-Value="perfil.NombreEmprendimiento" class="form-control" />
                        <ValidationMessage For="@(() => perfil.NombreEmprendimiento)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group">
                        <label class="auth-label" for="categoria">Categoría del negocio</label>
                        <InputSelect id="categoria" @bind-Value="perfil.CategoriaNegocio" class="form-select">
                            <option value="">Selecciona una categoría</option>
                            <option value="Gastronomía">Gastronomía</option>
                            <option value="Repostería">Repostería</option>
                            <option value="Cafetería">Cafetería</option>
                            <option value="Productos Frescos">Productos frescos</option>
                            <option value="Otros">Otros</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => perfil.CategoriaNegocio)" class="text-danger msg-error" />
                    </div>
                    @if (perfil.Formalizado)
                    {
                        <div class="form-group">
                            <label class="auth-label" for="nit">NIT</label>
                            <InputText id="nit" @bind-Value="perfil.Nit" class="form-control" />
                            <ValidationMessage For="@(() => perfil.Nit)" class="text-danger msg-error" />
                        </div>
                        <div class="form-group">
                            <label class="auth-label" for="razon-social">Razón social</label>
                            <InputText id="razon-social" @bind-Value="perfil.RazonSocial" class="form-control" />
                            <ValidationMessage For="@(() => perfil.RazonSocial)" class="text-danger msg-error" />
                        </div>
                        <div class="form-group">
                            <label class="auth-label" for="rues">RUES</label>
                            <InputText id="rues" @bind-Value="perfil.Rues" class="form-control" />
                            <ValidationMessage For="@(() => perfil.Rues)" class="text-danger msg-error" />
                        </div>
                    }
                    @if (!perfil.Formalizado)
                    {
                        <div class="form-group">
                            <label class="auth-label" for="tipo-documento">Tipo de documento *</label>
                            <InputSelect id="tipo-documento" @bind-Value="perfil.TipoDocumento" class="form-select">
                                <option value="">Selecciona...</option>
                                <option value="CC">CC</option>
                                <option value="CE">CE</option>
                                <option value="TI">TI</option>
                                <option value="PA">PA</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => perfil.TipoDocumento)" class="text-danger msg-error" />
                        </div>
                        <div class="form-group">
                            <label class="auth-label" for="numero-documento">Documento de identidad *</label>
                            <InputText id="numero-documento" @bind-Value="perfil.NumeroDocumento" class="form-control" />
                            <ValidationMessage For="@(() => perfil.NumeroDocumento)" class="text-danger msg-error" />
                        </div>
                    }
                    <div class="form-group">
                        <label class="auth-label" for="correo-empresa">Correo electrónico de la empresa</label>
                        <InputText id="correo-empresa" @bind-Value="perfil.CorreoEmpresa" type="email" class="form-control" />
                        <ValidationMessage For="@(() => perfil.CorreoEmpresa)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group perfil-switch-group">
                        <label class="auth-label" for="sitio-fisico">¿Tiene sitio físico?</label>
                        <InputSelect id="sitio-fisico" @bind-Value="perfil.TieneSitioFisico" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </InputSelect>
                    </div>
                    @if (perfil.TieneSitioFisico)
                    {
                        <div class="form-group perfil-direccion-group">
                            <label class="auth-label" for="direccion">Dirección del sitio físico</label>
                            <InputText id="direccion" @bind-Value="perfil.Direccion" class="form-control" />
                            <ValidationMessage For="@(() => perfil.Direccion)" class="text-danger msg-error" />
                        </div>
                    }
                </div>

                @if (!formalizadoOriginal && perfil.Formalizado)
                {
                    <div class="perfil-alerta perfil-alerta-exito" role="status">
                        Guarda tus datos para tener los privilegios.
                    </div>
                }
            </section>

            @if (formalizadoOriginal)
            {
            <section class="perfil-seccion">
                <div class="perfil-seccion-heading">
                    <div>
                        <span class="perfil-seccion-numero">03</span>
                        <h3>Empleados del negocio</h3>
                    </div>
                    <button type="button" class="btn-outline btn-small" @onclick="IniciarNuevoEmpleado">+ Invitar empleado</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(rolesError))
                {
                    <div class="perfil-alerta perfil-alerta-error" role="alert">@rolesError</div>
                }

                @if (perfil.Empleados.Count == 0)
                {
                    <div class="perfil-empty-state">No hay empleados registrados. Invita por correo a quienes trabajan en tu negocio y asígnales un rol.</div>
                }
                else
                {
                    <div class="perfil-socios-lista">
                        @foreach (var empleado in perfil.Empleados)
                        {
                            <div class="perfil-socio-row">
                                <div>
                                    <strong>@empleado.CorreoInvitado</strong>
                                    <span>@NombreRol(empleado) · @(string.IsNullOrWhiteSpace(empleado.EstadoInvitacion) ? "pendiente" : empleado.EstadoInvitacion)</span>
                                </div>
                                <div class="perfil-socio-acciones">
                                    <button type="button" class="btn-texto" @onclick="() => EditarEmpleado(empleado)">Editar</button>
                                    <button type="button" class="btn-texto btn-texto-peligro" @onclick="() => EliminarEmpleado(empleado)">Eliminar</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (empleadoEnEdicion is not null)
                {
                    <div class="perfil-socio-editor">
                        <div class="perfil-socio-editor-heading">
                            <strong>@(empleadoEditando ? "Editar empleado" : "Nuevo empleado")</strong>
                            <button type="button" class="btn-texto" @onclick="CancelarEmpleado">Cancelar</button>
                        </div>
                        <div class="perfil-grid">
                            <div class="form-group">
                                <label class="auth-label">Correo del empleado</label>
                                <InputText @bind-Value="empleadoEnEdicion.CorreoInvitado" type="email" class="form-control" placeholder="empleado@correo.com" />
                            </div>
                            <div class="form-group">
                                <label class="auth-label">Rol</label>
                                <InputSelect @bind-Value="empleadoEnEdicion.RolId" class="form-select">
                                    <option value="0">Selecciona un rol</option>
                                    @foreach (var rol in roles)
                                    {
                                        <option value="@rol.Id">@rol.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(mensajeEmpleado))
                        {
                            <div class="text-danger msg-error">@mensajeEmpleado</div>
                        }
                        <button type="button" class="btn-solid btn-small" @onclick="GuardarEmpleado">Guardar empleado</button>
                    </div>
                }
            </section>
            }

            <div class="perfil-formulario-acciones">
                <button type="button" class="btn-outline" @onclick="VolverAlDashboard">Cancelar</button>
                <button type="submit" class="btn-solid" disabled="@procesando">
                    @(procesando ? "Guardando..." : "Guardar cambios")
                </button>
            </div>
        </EditForm>

        @if (mostrarConfirmDesformalizar)
        {
            <div class="confirm-overlay">
                <div class="confirm-box confirm-box-advertencia">
                    <div class="confirm-icono-advertencia" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                        </svg>
                    </div>
                    <h3 class="confirm-titulo-advertencia">Pasar a no formalizado</h3>
                    <p class="confirm-mensaje">¿Estás seguro de querer pasar el emprendimiento a <strong>no formalizado</strong>?</p>
                    <ul class="confirm-lista-advierte">
                        <li>Se revocarán los privilegios de formalizado.</li>
                        <li>Se eliminarán el NIT, la razón social y el RUES registrados.</li>
                        <li>Se eliminarán los empleados del negocio.</li>
                    </ul>
                    <div class="confirm-acciones">
                        <button type="button" class="btn-outline" @onclick="() => mostrarConfirmDesformalizar = false">Cancelar</button>
                        <button type="button" class="btn-solid btn-confirmar-peligro" @onclick="ConfirmarDesformalizacion">Sí, continuar</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private enum FaseEdicion
    {
        ConfirmarIdentidad,
        Cargando,
        Formulario
    }

    private FaseEdicion fase = FaseEdicion.ConfirmarIdentidad;
    private ConfirmarEdicionPerfilDto confirmacion = new();
    private PerfilEmprendedorDto perfil = new();
    private bool formalizadoOriginal;
    private EmpleadoDto? empleadoEnEdicion;
    private bool empleadoEditando;
    private List<RolDto> roles = new();
    private bool mostrarPassword;
    private bool procesando;
    private bool guardado;
    private string? editToken;
    private string? mensajeError;
    private string? mensajeExito;
    private string? mensajeEmpleado;
    private string? rolesError;
    private bool mostrarConfirmDesformalizar;

    protected override void OnInitialized()
    {
        confirmacion = new ConfirmarEdicionPerfilDto();
        editToken = null;
        formalizadoOriginal = false;
        fase = FaseEdicion.ConfirmarIdentidad;
    }

    private void AlternarPassword() => mostrarPassword = !mostrarPassword;

    private async Task ConfirmarIdentidadAsync()
    {
        procesando = true;
        mensajeError = null;
        StateHasChanged();

        try
        {
            var resultado = await PerfilService.ConfirmarIdentidadAsync(confirmacion);
            if (!resultado.Success || string.IsNullOrWhiteSpace(resultado.Data?.EditToken))
            {
                mensajeError = resultado.Message ?? "No se pudo validar la contraseña actual.";
                return;
            }

            editToken = resultado.Data.EditToken;
            fase = FaseEdicion.Cargando;
            StateHasChanged();

            var perfilResultado = await PerfilService.ObtenerPerfilAsync(editToken);
            if (!perfilResultado.Success || perfilResultado.Data is null)
            {
                fase = FaseEdicion.ConfirmarIdentidad;
                mensajeError = perfilResultado.Message ?? "No se pudo cargar la información del perfil.";
                return;
            }

            perfil = perfilResultado.Data;
            formalizadoOriginal = perfil.Formalizado;
            fase = FaseEdicion.Formulario;
            if (formalizadoOriginal)
            {
                await CargarRolesAsync();
            }
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private bool Deformalizando => formalizadoOriginal && !perfil.Formalizado;

    private async Task SolicitarGuardarAsync()
    {
        if (Deformalizando && !mostrarConfirmDesformalizar)
        {
            mostrarConfirmDesformalizar = true;
            return;
        }

        await GuardarAsync();
    }

    private async Task ConfirmarDesformalizacion()
    {
        mostrarConfirmDesformalizar = false;
        await GuardarAsync();
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(editToken))
        {
            fase = FaseEdicion.ConfirmarIdentidad;
            mensajeError = "La autorización de edición expiró. Confirma nuevamente tu identidad.";
            return;
        }

        if (perfil.Formalizado)
        {
            if (string.IsNullOrWhiteSpace(perfil.Nit))
            {
                mensajeError = "El NIT es obligatorio si el negocio está formalizado.";
                return;
            }
            if (string.IsNullOrWhiteSpace(perfil.RazonSocial))
            {
                mensajeError = "La razón social es obligatoria si el negocio está formalizado.";
                return;
            }
        }
        else
        {
            var tiposValidos = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "CC", "CE", "TI", "PA" };
            if (string.IsNullOrWhiteSpace(perfil.TipoDocumento) || !tiposValidos.Contains(perfil.TipoDocumento.Trim()))
            {
                mensajeError = "Selecciona un tipo de documento válido (CC, CE, TI o PA).";
                return;
            }
            if (string.IsNullOrWhiteSpace(perfil.NumeroDocumento))
            {
                mensajeError = "El documento de identidad es obligatorio si el negocio no está formalizado.";
                return;
            }
            perfil.TipoDocumento = perfil.TipoDocumento.Trim().ToUpperInvariant();
            perfil.NumeroDocumento = perfil.NumeroDocumento.Trim();
            perfil.Nit = string.Empty;
            perfil.RazonSocial = string.Empty;
            perfil.Rues = string.Empty;
        }

        if (perfil.TieneSitioFisico && string.IsNullOrWhiteSpace(perfil.Direccion))
        {
            mensajeError = "La dirección es obligatoria si el negocio tiene sitio físico.";
            return;
        }

        if (string.IsNullOrWhiteSpace(perfil.TelefonoContacto) || perfil.TelefonoContacto.Trim().Length < 7)
        {
            mensajeError = "El teléfono de contacto debe tener al menos 7 dígitos.";
            return;
        }

        if (!perfil.TieneSitioFisico)
        {
            perfil.Direccion = string.Empty;
        }

        procesando = true;
        guardado = false;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var resultado = await PerfilService.ActualizarPerfilAsync(perfil, editToken);
            if (!resultado.Success)
            {
                if (resultado.StatusCode == HttpStatusCode.Unauthorized)
                {
                    editToken = null;
                    fase = FaseEdicion.ConfirmarIdentidad;
                    mensajeError = "La autorización de edición expiró. Confirma nuevamente tu identidad.";
                    return;
                }

                mensajeError = resultado.Message ?? "No se pudieron guardar los cambios.";
                return;
            }

            if (resultado.Data?.RequiereConfirmacionCorreo == true)
            {
                await AuthService.CerrarSesionAsync();
                Navigation.NavigateTo("login?correoPendiente=true", replace: true);
                return;
            }

            guardado = true;
            mensajeExito = resultado.Data?.Mensaje;
            Navigation.NavigateTo("/", replace: true);
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task CargarRolesAsync()
    {
        rolesError = null;

        try
        {
            var resultado = await PerfilService.ObtenerRolesAsync();
            if (resultado.Success && resultado.Data is not null)
            {
                roles = resultado.Data;
            }
            else
            {
                rolesError = resultado.Message ?? "No se pudieron cargar los roles de empleado.";
            }
        }
        catch (HttpRequestException)
        {
            rolesError = "No fue posible cargar los roles de empleado.";
        }
        catch (Exception)
        {
            rolesError = "Ocurrió un error al cargar los roles de empleado.";
        }
    }

    private string NombreRol(EmpleadoDto empleado)
    {
        if (!string.IsNullOrWhiteSpace(empleado.NombreRol))
        {
            return empleado.NombreRol;
        }

        return roles.FirstOrDefault(r => r.Id == empleado.RolId)?.Nombre ?? "Rol sin asignar";
    }

    private void IniciarNuevoEmpleado()
    {
        empleadoEditando = false;
        empleadoEnEdicion = new EmpleadoDto();
        mensajeEmpleado = null;
    }

    private void EditarEmpleado(EmpleadoDto empleado)
    {
        empleadoEditando = true;
        empleadoEnEdicion = new EmpleadoDto
        {
            Id = empleado.Id,
            CorreoInvitado = empleado.CorreoInvitado,
            RolId = empleado.RolId,
            NombreRol = empleado.NombreRol,
            EstadoInvitacion = empleado.EstadoInvitacion
        };
        mensajeEmpleado = null;
    }

    private void GuardarEmpleado()
    {
        if (empleadoEnEdicion is null)
        {
            return;
        }

        var correo = empleadoEnEdicion.CorreoInvitado.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(correo))
        {
            mensajeEmpleado = "El correo del empleado es obligatorio.";
            return;
        }

        if (!new EmailAddressAttribute().IsValid(correo))
        {
            mensajeEmpleado = "Ingresa un correo válido para el empleado.";
            return;
        }

        if (empleadoEnEdicion.RolId <= 0)
        {
            mensajeEmpleado = "Selecciona el rol del empleado.";
            return;
        }

        var repetido = perfil.Empleados.Any(e =>
            string.Equals(e.CorreoInvitado.Trim(), correo, StringComparison.OrdinalIgnoreCase) &&
            e.Id != empleadoEnEdicion.Id);
        if (repetido)
        {
            mensajeEmpleado = "Ya invitaste a ese correo en tu negocio.";
            return;
        }

        empleadoEnEdicion.CorreoInvitado = correo;

        if (empleadoEditando && empleadoEnEdicion.Id.HasValue)
        {
            var indice = perfil.Empleados.FindIndex(e => e.Id == empleadoEnEdicion.Id);
            if (indice >= 0)
            {
                perfil.Empleados[indice] = empleadoEnEdicion;
            }
        }
        else
        {
            perfil.Empleados.Add(empleadoEnEdicion);
        }

        empleadoEnEdicion = null;
        mensajeEmpleado = null;
    }

    private void CancelarEmpleado()
    {
        empleadoEnEdicion = null;
        mensajeEmpleado = null;
    }

    private void EliminarEmpleado(EmpleadoDto empleado)
    {
        perfil.Empleados.Remove(empleado);
    }

    private void VolverAlDashboard()
    {
        Navigation.NavigateTo("dashboard-empresa");
    }

    private async Task OnAntesDeNavegar(LocationChangingContext context)
    {
        if (!string.IsNullOrWhiteSpace(editToken))
        {
            editToken = null;
            await PerfilService.RevocarPermisoAsync();
        }
    }
}
