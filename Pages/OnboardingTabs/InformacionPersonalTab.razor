@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@inject HttpClient Http
@inject PWGAPG_Frontend.Services.AuthService AuthService

<EditForm Model="@duenio" OnValidSubmit="@GuardarTodo">
    <DataAnnotationsValidator />

    <div class="foto-perfil-container">
        <InputFile id="fotoDuenio" OnChange="@(e => CargarFoto(e, duenio))" class="foto-perfil-input" accept="image/*"
                   aria-label="Foto de perfil (opcional)" />
        <label class="foto-perfil-label" for="fotoDuenio">
            @if (!string.IsNullOrEmpty(duenio.FotoPerfilBase64))
            {
                <img src="@duenio.FotoPerfilBase64" class="foto-perfil-preview" alt="Vista previa de la foto de perfil" />
            }
            else
            {
                <span class="foto-perfil-placeholder" aria-hidden="true">+</span>
            }
        </label>
        <span class="foto-perfil-texto">Foto de perfil (opcional)</span>
    </div>

    <div class="onb-grid">
        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-nombres">Nombres *</label>
            <InputText id="onboarding-nombres" @bind-Value="duenio.Nombres" class="form-control" autocomplete="given-name" aria-required="true" aria-describedby="onboarding-nombres-error" />
            <div id="onboarding-nombres-error"><ValidationMessage For="@(() => duenio.Nombres)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-apellidos">Apellidos *</label>
            <InputText id="onboarding-apellidos" @bind-Value="duenio.Apellidos" class="form-control" autocomplete="family-name" aria-required="true" aria-describedby="onboarding-apellidos-error" />
            <div id="onboarding-apellidos-error"><ValidationMessage For="@(() => duenio.Apellidos)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-tipo-documento">Tipo de Documento *</label>
            <InputSelect id="onboarding-tipo-documento" @bind-Value="duenio.TipoDocumento" class="form-select" aria-required="true" aria-describedby="onboarding-tipo-documento-error">
                <option value="">-- Seleccione --</option>
                <option value="CC">Cédula de Ciudadanía</option>
                <option value="CE">Cédula de Extranjería</option>
                <option value="TI">Tarjeta de Identidad</option>
                <option value="PA">Pasaporte</option>
            </InputSelect>
            <div id="onboarding-tipo-documento-error"><ValidationMessage For="@(() => duenio.TipoDocumento)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-documento">Número de Documento *</label>
            <InputText id="onboarding-documento" @bind-Value="duenio.NumeroDocumento" class="form-control" aria-required="true" aria-describedby="onboarding-documento-error" />
            <div id="onboarding-documento-error"><ValidationMessage For="@(() => duenio.NumeroDocumento)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-telefono">Teléfono *</label>
            <InputText id="onboarding-telefono" @bind-Value="duenio.Telefono" class="form-control" type="tel" autocomplete="tel" aria-required="true" aria-describedby="onboarding-telefono-error" />
            <div id="onboarding-telefono-error"><ValidationMessage For="@(() => duenio.Telefono)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-correo">Correo Electrónico *</label>
            <InputText id="onboarding-correo" @bind-Value="duenio.CorreoElectronico" class="form-control" type="email" autocomplete="email" readonly="true" aria-describedby="onboarding-correo-ayuda onboarding-correo-error" />
            <small id="onboarding-correo-ayuda" class="text-muted">El correo de acceso se administra desde tu perfil.</small>
            <div id="onboarding-correo-error"><ValidationMessage For="@(() => duenio.CorreoElectronico)" class="text-danger msg-error" /></div>
        </div>
    </div>

    <div class="text-danger msg-error" role="status">@mensajeErrorGeneral</div>

    <div class="onboarding-acciones">
        <button type="submit" class="btn-solid btn-full">Continuar</button>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }

    private DuenioDTO duenio = new();

    private string? mensajeErrorGeneral;

    protected override async Task OnInitializedAsync()
    {
        // Autocompleta la pestaña de información personal con lo guardado en BD.
        try
        {
            var datos = await Http.GetFromJsonAsync<OnboardingPersonalDto>("api/onboarding/datos-personales");
            if (datos is not null)
            {
                duenio.Nombres = datos.Nombres ?? string.Empty;
                duenio.Apellidos = datos.Apellidos ?? string.Empty;
                duenio.TipoDocumento = datos.TipoDocumento ?? string.Empty;
                duenio.NumeroDocumento = datos.NumeroDocumento ?? string.Empty;
                duenio.CorreoElectronico = datos.CorreoElectronico ?? string.Empty;
                duenio.Telefono = datos.TelefonoContacto ?? string.Empty;
                duenio.FotoPerfilBase64 = datos.FotoPerfilUrl;
            }
        }
        catch
        {
            // Si falla la red, se deja el formulario vacío.
        }
    }

    private async Task CargarFoto(InputFileChangeEventArgs e, DuenioDTO destino)
    {
        var archivo = e.File;
        if (archivo == null) return;

        using var stream = archivo.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024); // 2 MB máx
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        destino.FotoPerfilBase64 = $"data:{archivo.ContentType};base64,{base64}";

        try
        {
            await Http.PostAsJsonAsync("api/onboarding/foto-perfil", new { FotoPerfilUrl = destino.FotoPerfilBase64 });
            AuthService.ActualizarFotoPerfil(destino.FotoPerfilBase64);
        }
        catch
        {
            // Si falla la red/persistencia, la vista previa local se mantiene.
        }
    }

    private async Task GuardarTodo()
    {
        mensajeErrorGeneral = null;

        try
        {
            var resp = await Http.PostAsJsonAsync("api/onboarding/datos-personales", duenio);
            if (!resp.IsSuccessStatusCode)
            {
                mensajeErrorGeneral = "No se pudo guardar la información. Revisa los datos e intenta de nuevo.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            mensajeErrorGeneral = "No fue posible conectar con el servidor.";
            return;
        }

        await OnGuardado.InvokeAsync();
    }
}
