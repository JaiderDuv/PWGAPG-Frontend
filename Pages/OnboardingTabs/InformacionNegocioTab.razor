@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@inject HttpClient Http

<EditForm Model="@negocio" OnValidSubmit="@GuardarYContinuar">
    <DataAnnotationsValidator />

    <h3 class="onboarding-subtitulo">Información del negocio</h3>

    <ImageUpload @bind-ImagenBase64="negocio.LogoBase64" Forma="cuadrado" Texto="Logo de la empresa (opcional)" InputId="logoEmpresa" />

    <div class="onb-grid">
        <div class="form-group-sm">
            <label class="auth-label">Nombre de la Empresa *</label>
            <InputText @bind-Value="negocio.NombreEmpresa" class="form-control" />
            <ValidationMessage For="@(() => negocio.NombreEmpresa)" class="text-danger msg-error" />
        </div>

        <div class="form-group-sm">
            <label class="auth-label">¿Tu emprendimiento está formalizado? *</label>
            <InputSelect @bind-Value="negocio.Formalizado" class="form-select" TValue="bool">
                <option value="false">No</option>
                <option value="true">Sí</option>
            </InputSelect>
        </div>

        @if (negocio.Formalizado)
        {
            <div class="form-group-sm">
                <label class="auth-label">NIT</label>
                <InputText @bind-Value="negocio.Nit" class="form-control" placeholder="Si aplica" />
            </div>

            <div class="form-group-sm">
                <label class="auth-label">Razón Social</label>
                <InputText @bind-Value="negocio.RazonSocial" class="form-control" placeholder="Si aplica" />
            </div>

            <div class="form-group-sm">
                <label class="auth-label">RUES *</label>
                <InputText @bind-Value="negocio.Rues" class="form-control" placeholder="Número de registro RUES" />
                <ValidationMessage For="@(() => negocio.Rues)" class="text-danger msg-error" />
                @if (mensajeErrorRues != null)
                {
                    <span class="text-danger msg-error">@mensajeErrorRues</span>
                }
            </div>
        }

        <div class="form-group-sm">
            <label class="auth-label">Correo Electrónico de la Empresa *</label>
            <InputText @bind-Value="negocio.CorreoEmpresa" class="form-control" type="email" />
            <ValidationMessage For="@(() => negocio.CorreoEmpresa)" class="text-danger msg-error" />
        </div>

        <div class="form-group-sm">
            <label class="auth-label">Teléfono de la Empresa *</label>
            <InputText @bind-Value="negocio.TelefonoEmpresa" class="form-control" />
            <ValidationMessage For="@(() => negocio.TelefonoEmpresa)" class="text-danger msg-error" />
        </div>

        <div class="form-group-sm">
            <label class="auth-label">¿Tiene sitio físico? *</label>
            <InputSelect @bind-Value="negocio.TieneSitioFisico" class="form-select" TValue="bool">
                <option value="false">No</option>
                <option value="true">Sí</option>
            </InputSelect>
        </div>

        @if (negocio.TieneSitioFisico)
        {
            <div class="form-group-sm">
                <label class="auth-label">Dirección *</label>
                <InputText @bind-Value="negocio.Direccion" class="form-control" placeholder="Dirección del local" />
                @if (mensajeErrorDireccion != null)
                {
                    <span class="text-danger msg-error">@mensajeErrorDireccion</span>
                }
            </div>
        }
    </div>

    @if (mensajeErrorGeneral != null)
    {
        <div class="text-danger msg-error">@mensajeErrorGeneral</div>
    }

    <div class="onboarding-acciones">
        <button type="submit" class="btn-solid btn-full">Finalizar configuración</button>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }

    private NegocioDTO negocio = new();
    private string? mensajeErrorDireccion;
    private string? mensajeErrorGeneral;
    private string? mensajeErrorRues;

    protected override async Task OnInitializedAsync()
    {
        // Autocompleta el formulario con los datos ya registrados del negocio.
        try
        {
            var datos = await Http.GetFromJsonAsync<OnboardingNegocioDto>("api/onboarding/datos-negocio");
            if (datos is not null)
            {
                negocio.NombreEmpresa = datos.NombreEmprendimiento ?? string.Empty;
                negocio.Nit = datos.Nit;
                negocio.RazonSocial = datos.RazonSocial;
                negocio.Rues = datos.Rues ?? string.Empty;
                negocio.CorreoEmpresa = datos.CorreoEmpresa ?? string.Empty;
                negocio.TelefonoEmpresa = datos.TelefonoContacto ?? string.Empty;
                negocio.TieneSitioFisico = datos.TieneSitioFisico;
                negocio.Direccion = datos.Direccion;
                negocio.LogoBase64 = datos.LogoUrl;
                negocio.Formalizado = string.Equals(datos.TipoFormalizacion, "formalizado", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch
        {
            // Si falla la red o no hay datos, se deja el formulario vacío.
        }
    }

    private async Task GuardarYContinuar()
    {
        mensajeErrorDireccion = null;
        mensajeErrorGeneral = null;
        mensajeErrorRues = null;

        if (negocio.TieneSitioFisico && string.IsNullOrWhiteSpace(negocio.Direccion))
        {
            mensajeErrorDireccion = "La dirección es obligatoria si tienes sitio físico.";
            return;
        }

        if (negocio.Formalizado && string.IsNullOrWhiteSpace(negocio.Rues))
        {
            mensajeErrorRues = "El RUES es obligatorio para negocios formalizados.";
            return;
        }

        if (!negocio.Formalizado)
        {
            // Los datos de formalización (NIT/Razón Social/RUES) no aplican: no se enviarán.
            negocio.Nit = null;
            negocio.RazonSocial = null;
            negocio.Rues = null;
        }

        try
        {
            var resp = await Http.PostAsJsonAsync("api/onboarding/datos-negocio", negocio);
            if (!resp.IsSuccessStatusCode)
            {
                mensajeErrorGeneral = "No se pudo guardar la información. Revisa los datos e intenta de nuevo.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            mensajeErrorGeneral = "No fue posible conectar con el servidor.";
            return;
        }

        await OnGuardado.InvokeAsync();
    }
}