@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@inject HttpClient Http

<EditForm Model="@negocio" OnValidSubmit="@GuardarYContinuar">
    <DataAnnotationsValidator />

    <ImageUpload @bind-ImagenBase64="negocio.LogoBase64" Forma="cuadrado" Texto="Logo de la empresa (opcional)"
                 DescripcionImagen="Vista previa del logo de la empresa" InputId="logoEmpresa" />

    <div class="onb-grid">
        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-empresa">Nombre de la Empresa *</label>
            <InputText id="onboarding-empresa" @bind-Value="negocio.NombreEmpresa" class="form-control" autocomplete="organization" aria-required="true" aria-describedby="onboarding-empresa-error" />
            <div id="onboarding-empresa-error"><ValidationMessage For="@(() => negocio.NombreEmpresa)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-formalizado">¿Tu emprendimiento está formalizado? *</label>
            <InputSelect id="onboarding-formalizado" @bind-Value="negocio.Formalizado" class="form-select" TValue="bool">
                <option value="false">No</option>
                <option value="true">Sí</option>
            </InputSelect>
        </div>

        @if (negocio.Formalizado)
        {
            <div class="form-group-sm">
                <label class="auth-label" for="onboarding-nit">NIT</label>
                <InputText id="onboarding-nit" @bind-Value="negocio.Nit" class="form-control" placeholder="Si aplica" />
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="onboarding-razon-social">Razón Social</label>
                <InputText id="onboarding-razon-social" @bind-Value="negocio.RazonSocial" class="form-control" placeholder="Si aplica" />
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="onboarding-rues">RUES *</label>
                <InputText id="onboarding-rues" @bind-Value="negocio.Rues" class="form-control" aria-required="true" aria-describedby="onboarding-rues-error" />
                <div id="onboarding-rues-error" role="status" class="text-danger msg-error">
                    <ValidationMessage For="@(() => negocio.Rues)" />
                    @mensajeErrorRues
                </div>
            </div>
        }

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-correo-empresa">Correo Electrónico de la Empresa *</label>
            <InputText id="onboarding-correo-empresa" @bind-Value="negocio.CorreoEmpresa" class="form-control" type="email" autocomplete="section-empresa email" aria-required="true" aria-describedby="onboarding-correo-empresa-error" />
            <div id="onboarding-correo-empresa-error"><ValidationMessage For="@(() => negocio.CorreoEmpresa)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-telefono-empresa">Teléfono de la Empresa *</label>
            <InputText id="onboarding-telefono-empresa" @bind-Value="negocio.TelefonoEmpresa" class="form-control" type="tel" autocomplete="section-empresa tel" aria-required="true" aria-describedby="onboarding-telefono-empresa-error" />
            <div id="onboarding-telefono-empresa-error"><ValidationMessage For="@(() => negocio.TelefonoEmpresa)" class="text-danger msg-error" /></div>
        </div>

        <div class="form-group-sm">
            <label class="auth-label" for="onboarding-sitio-fisico">¿Tiene sitio físico? *</label>
            <InputSelect id="onboarding-sitio-fisico" @bind-Value="negocio.TieneSitioFisico" class="form-select" TValue="bool">
                <option value="false">No</option>
                <option value="true">Sí</option>
            </InputSelect>
        </div>

        @if (negocio.TieneSitioFisico)
        {
            <div class="form-group-sm">
                <label class="auth-label" for="onboarding-direccion">Dirección *</label>
                <InputText id="onboarding-direccion" @bind-Value="negocio.Direccion" class="form-control" autocomplete="section-empresa street-address" aria-required="true" aria-describedby="onboarding-direccion-error" />
                <div id="onboarding-direccion-error" class="text-danger msg-error" role="status">@mensajeErrorDireccion</div>
            </div>
        }
    </div>

    <div class="text-danger msg-error" role="status">@mensajeErrorGeneral</div>

    <div class="onboarding-acciones">
        <button type="submit" class="btn-solid btn-full">Finalizar configuración</button>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }

    private NegocioDTO negocio = new();
    private string? mensajeErrorDireccion;
    private string? mensajeErrorGeneral;
    private string? mensajeErrorRues;

    protected override async Task OnInitializedAsync()
    {
        // Autocompleta el formulario con los datos ya registrados del negocio.
        try
        {
            var datos = await Http.GetFromJsonAsync<OnboardingNegocioDto>("api/onboarding/datos-negocio");
            if (datos is not null)
            {
                negocio.NombreEmpresa = datos.NombreEmprendimiento ?? string.Empty;
                negocio.Nit = datos.Nit;
                negocio.RazonSocial = datos.RazonSocial;
                negocio.Rues = datos.Rues ?? string.Empty;
                negocio.CorreoEmpresa = datos.CorreoEmpresa ?? string.Empty;
                negocio.TelefonoEmpresa = datos.TelefonoContacto ?? string.Empty;
                negocio.TieneSitioFisico = datos.TieneSitioFisico;
                negocio.Direccion = datos.Direccion;
                negocio.LogoBase64 = datos.LogoUrl;
                negocio.Formalizado = string.Equals(datos.TipoFormalizacion, "formalizado", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch
        {
            // Si falla la red o no hay datos, se deja el formulario vacío.
        }
    }

    private async Task GuardarYContinuar()
    {
        mensajeErrorDireccion = null;
        mensajeErrorGeneral = null;
        mensajeErrorRues = null;

        if (negocio.TieneSitioFisico && string.IsNullOrWhiteSpace(negocio.Direccion))
        {
            mensajeErrorDireccion = "La dirección es obligatoria si tienes sitio físico.";
            return;
        }

        if (negocio.Formalizado && string.IsNullOrWhiteSpace(negocio.Rues))
        {
            mensajeErrorRues = "El RUES es obligatorio para negocios formalizados.";
            return;
        }

        if (!negocio.Formalizado)
        {
            // Los datos de formalización (NIT/Razón Social/RUES) no aplican: no se enviarán.
            negocio.Nit = null;
            negocio.RazonSocial = null;
            negocio.Rues = null;
        }

        try
        {
            var resp = await Http.PostAsJsonAsync("api/onboarding/datos-negocio", negocio);
            if (!resp.IsSuccessStatusCode)
            {
                mensajeErrorGeneral = "No se pudo guardar la información. Revisa los datos e intenta de nuevo.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            mensajeErrorGeneral = "No fue posible conectar con el servidor.";
            return;
        }

        await OnGuardado.InvokeAsync();
    }
}
