@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="onboarding-subtitulo">Empleados (opcional)</h3>
<p class="text-muted" style="margin-top: -8px; margin-bottom: 18px;">
    Registra a tu equipo de trabajo, o continúa sin agregar empleados por ahora.
</p>

<div class="socios-header">
    <span></span>
    @if (negocioFormalizado)
    {
        <button type="button" class="btn-outline" @onclick="AbrirFormularioNuevoEmpleado">+ Añadir empleado</button>
    }
</div>

@if (!negocioFormalizado)
{
    <div class="perfil-alerta perfil-alerta-error" role="alert">
        Solo los negocios formalizados pueden añadir empleados. Completa la formalización (NIT/RUES) en la pestaña "Información del Negocio".
    </div>
}

@if (negocioFormalizado && empleados.Any())
{
    <div class="socios-lista">
        @foreach (var empleado in empleados)
        {
            <div class="socio-item">
                <div class="socio-info">
                    <strong>@empleado.Nombres @empleado.Apellidos</strong>
                    <span>@empleado.Rol · @empleado.TipoDocumento @empleado.NumeroDocumento · @empleado.CorreoElectronico</span>
                </div>
                <div class="socio-acciones">
                    <button type="button" class="btn-mini-editar" @onclick="() => EditarEmpleado(empleado)">Editar</button>
                    <button type="button" class="btn-mini-eliminar" @onclick="() => PedirEliminarEmpleado(empleado)">Eliminar</button>
                </div>
            </div>
        }
    </div>
}
else if (negocioFormalizado)
{
    <p class="text-muted">Aún no has añadido empleados.</p>
}

@if (mensajeErrorGeneral != null)
{
    <div class="text-danger msg-error">@mensajeErrorGeneral</div>
}

<div class="onboarding-acciones onboarding-acciones-dobles">
    <button type="button" class="btn-outline" @onclick="Omitir">Omitir</button>
    <button type="button" class="btn-solid" @onclick="GuardarYContinuar">Guardar</button>
</div>

@if (mostrarFormularioEmpleado)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">@(empleadoEditando != null ? "Editar empleado" : "Nuevo empleado")</h3>

            <EditForm Model="@empleadoTemporal" OnValidSubmit="@GuardarEmpleado">
                <DataAnnotationsValidator />

                <ImageUpload @bind-ImagenBase64="empleadoTemporal.FotoPerfilBase64" Forma="circular" InputId="fotoEmpleado" />

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Nombres *</label>
                        <InputText @bind-Value="empleadoTemporal.Nombres" class="form-control" />
                        <ValidationMessage For="@(() => empleadoTemporal.Nombres)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Apellidos *</label>
                        <InputText @bind-Value="empleadoTemporal.Apellidos" class="form-control" />
                        <ValidationMessage For="@(() => empleadoTemporal.Apellidos)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Tipo de Documento *</label>
                        <InputSelect @bind-Value="empleadoTemporal.TipoDocumento" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="CC">Cédula de Ciudadanía</option>
                            <option value="CE">Cédula de Extranjería</option>
                            <option value="PP">Pasaporte</option>
                            <option value="PEP">Permiso Especial de Permanencia</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => empleadoTemporal.TipoDocumento)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Número de Documento *</label>
                        <InputText @bind-Value="empleadoTemporal.NumeroDocumento" class="form-control" />
                        <ValidationMessage For="@(() => empleadoTemporal.NumeroDocumento)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Teléfono *</label>
                        <InputText @bind-Value="empleadoTemporal.Telefono" class="form-control" />
                        <ValidationMessage For="@(() => empleadoTemporal.Telefono)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Correo Electrónico *</label>
                        <InputText @bind-Value="empleadoTemporal.CorreoElectronico" class="form-control" type="email" />
                        <ValidationMessage For="@(() => empleadoTemporal.CorreoElectronico)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Rol *</label>
                        <InputSelect @bind-Value="empleadoTemporal.Rol" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="Mesero">Mesero</option>
                            <option value="Chef">Chef</option>
                            <option value="Cajero">Cajero</option>
                            <option value="Repartidor">Repartidor</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => empleadoTemporal.Rol)" class="text-danger msg-error" />
                    </div>
                </div>

                <div class="confirm-acciones" style="margin-top: 16px;">
                    <button type="button" class="btn-outline" @onclick="CerrarFormularioEmpleado">Cancelar</button>
                    <button type="submit" class="btn-solid">Guardar empleado</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="¿Estás seguro de eliminar a este empleado?"
               OnConfirmar="ConfirmarEliminarEmpleado"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }

    private List<EmpleadoDTO> empleados = new();

    private bool mostrarFormularioEmpleado = false;
    private EmpleadoDTO empleadoTemporal = new();
    private EmpleadoDTO? empleadoEditando = null;

    private bool mostrarConfirmEliminar = false;
    private EmpleadoDTO? empleadoAEliminar = null;

    private string? mensajeErrorGeneral;
    private bool negocioFormalizado = false;

    protected override async Task OnInitializedAsync()
    {
        // Si el negocio no está formalizado, no se pueden añadir empleados.
        try
        {
            var datos = await Http.GetFromJsonAsync<OnboardingNegocioDto>("api/onboarding/datos-negocio");
            negocioFormalizado = datos is not null &&
                string.Equals(datos.TipoFormalizacion, "formalizado", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            negocioFormalizado = false;
        }
    }

    private void AbrirFormularioNuevoEmpleado()
    {
        if (!negocioFormalizado) return;
        empleadoEditando = null;
        empleadoTemporal = new EmpleadoDTO();
        mostrarFormularioEmpleado = true;
    }

    private void EditarEmpleado(EmpleadoDTO empleado)
    {
        empleadoEditando = empleado;
        empleadoTemporal = new EmpleadoDTO
        {
            Id = empleado.Id,
            FotoPerfilBase64 = empleado.FotoPerfilBase64,
            Nombres = empleado.Nombres,
            Apellidos = empleado.Apellidos,
            TipoDocumento = empleado.TipoDocumento,
            NumeroDocumento = empleado.NumeroDocumento,
            Telefono = empleado.Telefono,
            CorreoElectronico = empleado.CorreoElectronico,
            Rol = empleado.Rol
        };
        mostrarFormularioEmpleado = true;
    }

    private void GuardarEmpleado()
    {
        if (empleadoEditando != null)
        {
            var index = empleados.FindIndex(emp => emp.Id == empleadoEditando.Id);
            if (index >= 0) empleados[index] = empleadoTemporal;
        }
        else
        {
            empleados.Add(empleadoTemporal);
        }

        CerrarFormularioEmpleado();
    }

    private void CerrarFormularioEmpleado()
    {
        mostrarFormularioEmpleado = false;
        empleadoEditando = null;
    }

    private void PedirEliminarEmpleado(EmpleadoDTO empleado)
    {
        empleadoAEliminar = empleado;
        mostrarConfirmEliminar = true;
    }

    private void ConfirmarEliminarEmpleado()
    {
        if (empleadoAEliminar != null)
        {
            empleados.Remove(empleadoAEliminar);
        }
        mostrarConfirmEliminar = false;
        empleadoAEliminar = null;
    }

    private async Task GuardarYContinuar()
    {
        mensajeErrorGeneral = null;

        // Cuando el backend tenga el endpoint listo, descomenta esto:
        // var resp = await Http.PostAsJsonAsync("api/onboarding/empleados", empleados);
        // if (!resp.IsSuccessStatusCode)
        // {
        //     mensajeErrorGeneral = "No se pudo guardar la información. Intenta de nuevo.";
        //     return;
        // }

        await OnGuardado.InvokeAsync();
    }

    private async Task Omitir()
    {
        await OnGuardado.InvokeAsync();
    }
}