@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http

<h3 class="onboarding-subtitulo">Productos (opcional)</h3>
<p class="text-muted" style="margin-top: -8px; margin-bottom: 18px;">
    Agrega los productos que vas a vender, o continúa sin registrarlos por ahora.
</p>

<div class="socios-header">
    <span></span>
    <button type="button" class="btn-outline" @onclick="AbrirFormularioNuevoProducto">+ Añadir producto</button>
</div>

@if (productos.Any())
{
    <div class="socios-lista">
        @foreach (var producto in productos)
        {
            <div class="socio-item">
                <div class="socio-info">
                    <strong>@producto.Nombre</strong>
                    <span>Cantidad: @producto.Cantidad · Precio: $@producto.Precio.ToString("N0") · @producto.Ingredientes.Count ingrediente(s)</span>
                </div>
                <div class="socio-acciones">
                    <button type="button" class="btn-mini-editar" @onclick="() => EditarProducto(producto)">Editar</button>
                    <button type="button" class="btn-mini-eliminar" @onclick="() => PedirEliminarProducto(producto)">Eliminar</button>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">Aún no has añadido productos.</p>
}

@if (mensajeErrorGeneral != null)
{
    <div class="text-danger msg-error">@mensajeErrorGeneral</div>
}

<div class="onboarding-acciones onboarding-acciones-dobles">
    <button type="button" class="btn-outline" @onclick="Omitir">Omitir</button>
    <button type="button" class="btn-solid" @onclick="GuardarYContinuar">Guardar</button>
</div>

@if (mostrarFormularioProducto)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">@(productoEditando != null ? "Editar producto" : "Nuevo producto")</h3>

            <EditForm Model="@productoTemporal" OnValidSubmit="@GuardarProducto">
                <DataAnnotationsValidator />

                <ImageUpload @bind-ImagenBase64="productoTemporal.ImagenBase64" Forma="cuadrado" InputId="fotoProducto" />

                <div class="form-group-sm">
                    <label class="auth-label">Nombre del Producto *</label>
                    <InputText @bind-Value="productoTemporal.Nombre" class="form-control" />
                    <ValidationMessage For="@(() => productoTemporal.Nombre)" class="text-danger msg-error" />
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Ingredientes</label>
                    <div class="chip-input-row">
                        <input type="text" class="form-control" placeholder="Ej: Harina" @bind="ingredienteNuevo" @bind:event="oninput" @onkeydown="AgregarIngredienteConEnter" />
                        <button type="button" class="btn-outline btn-chip-add" @onclick="AgregarIngrediente">Añadir</button>
                    </div>
                    @if (productoTemporal.Ingredientes.Any())
                    {
                        <div class="chips-container">
                            @foreach (var ingrediente in productoTemporal.Ingredientes)
                            {
                                <span class="chip">
                                    @ingrediente
                                    <button type="button" class="chip-remove" @onclick="() => QuitarIngrediente(ingrediente)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Receta *</label>
                    <InputTextArea @bind-Value="productoTemporal.Receta" class="form-control" rows="3" placeholder="Describe la preparación paso a paso" />
                    <ValidationMessage For="@(() => productoTemporal.Receta)" class="text-danger msg-error" />
                </div>

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Cantidad disponible *</label>
                        <InputNumber @bind-Value="productoTemporal.Cantidad" class="form-control" />
                        <ValidationMessage For="@(() => productoTemporal.Cantidad)" class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Precio *</label>
                        <InputNumber @bind-Value="productoTemporal.Precio" class="form-control" />
                        <ValidationMessage For="@(() => productoTemporal.Precio)" class="text-danger msg-error" />
                    </div>
                </div>

                <div class="confirm-acciones" style="margin-top: 16px;">
                    <button type="button" class="btn-outline" @onclick="CerrarFormularioProducto">Cancelar</button>
                    <button type="submit" class="btn-solid">Guardar producto</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="¿Estás seguro de eliminar este producto?"
               OnConfirmar="ConfirmarEliminarProducto"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public EventCallback<List<ProductoDTO>> OnProductosActualizados { get; set; }

    private List<ProductoDTO> productos = new();

    private bool mostrarFormularioProducto = false;
    private ProductoDTO productoTemporal = new();
    private ProductoDTO? productoEditando = null;
    private string ingredienteNuevo = string.Empty;

    private bool mostrarConfirmEliminar = false;
    private ProductoDTO? productoAEliminar = null;

    private string? mensajeErrorGeneral;

    private void AbrirFormularioNuevoProducto()
    {
        productoEditando = null;
        productoTemporal = new ProductoDTO();
        ingredienteNuevo = string.Empty;
        mostrarFormularioProducto = true;
    }

    private void EditarProducto(ProductoDTO producto)
    {
        productoEditando = producto;
        productoTemporal = new ProductoDTO
        {
            Id = producto.Id,
            ImagenBase64 = producto.ImagenBase64,
            Nombre = producto.Nombre,
            Ingredientes = new List<string>(producto.Ingredientes),
            Receta = producto.Receta,
            Cantidad = producto.Cantidad,
            Precio = producto.Precio
        };
        ingredienteNuevo = string.Empty;
        mostrarFormularioProducto = true;
    }

    private void AgregarIngrediente()
    {
        var valor = ingredienteNuevo.Trim();
        if (!string.IsNullOrWhiteSpace(valor) && !productoTemporal.Ingredientes.Contains(valor))
        {
            productoTemporal.Ingredientes.Add(valor);
        }
        ingredienteNuevo = string.Empty;
    }

    private void AgregarIngredienteConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AgregarIngrediente();
        }
    }

    private void QuitarIngrediente(string ingrediente)
    {
        productoTemporal.Ingredientes.Remove(ingrediente);
    }

    private void GuardarProducto()
    {
        if (productoEditando != null)
        {
            var index = productos.FindIndex(p => p.Id == productoEditando.Id);
            if (index >= 0) productos[index] = productoTemporal;
        }
        else
        {
            productos.Add(productoTemporal);
        }

        CerrarFormularioProducto();
    }

    private void CerrarFormularioProducto()
    {
        mostrarFormularioProducto = false;
        productoEditando = null;
    }

    private void PedirEliminarProducto(ProductoDTO producto)
    {
        productoAEliminar = producto;
        mostrarConfirmEliminar = true;
    }

    private void ConfirmarEliminarProducto()
    {
        if (productoAEliminar != null)
        {
            productos.Remove(productoAEliminar);
        }
        mostrarConfirmEliminar = false;
        productoAEliminar = null;
    }

    private async Task GuardarYContinuar()
    {
        mensajeErrorGeneral = null;

        // Cuando el backend tenga el endpoint listo, descomenta esto:
        // var resp = await Http.PostAsJsonAsync("api/onboarding/productos", productos);
        // if (!resp.IsSuccessStatusCode)
        // {
        //     mensajeErrorGeneral = "No se pudo guardar la información. Intenta de nuevo.";
        //     return;
        // }

        await OnProductosActualizados.InvokeAsync(productos);
        await OnGuardado.InvokeAsync();
    }

    private async Task Omitir()
    {
        await OnGuardado.InvokeAsync();
    }
}