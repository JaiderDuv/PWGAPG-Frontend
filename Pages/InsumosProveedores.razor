@page "/insumos-proveedores"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using System.Net.Http.Json
@using System.Globalization
@using System.Text
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@using PWGAPG_Frontend.Components

<div class="inventario-container">
    <button type="button" class="btn-outline" @onclick='() => Navigation.NavigateTo("proveedores")'>
        ← Volver a proveedores
    </button>

    <div class="inventario-header" style="margin-top: 16px;">
        <div>
            <span class="inventario-eyebrow">PROVEEDORES</span>
            <h1 class="inventario-titulo">Asignar proveedor a un insumo</h1>
            <p class="inventario-subtitulo">Busca el insumo y entra a gestionar sus proveedores y precios.</p>
        </div>
    </div>

    <section class="insumos-toolbar pm-toolbar">
        <div class="pm-filtro-item pm-filtro-busqueda">
            <label class="pm-filtro-label">Buscar</label>
            <input class="form-control insumos-buscador"
                   placeholder="Nombre o proveedor..."
                   value="@textoBusqueda"
                   @oninput="e => textoBusqueda = e.Value?.ToString() ?? string.Empty" />
        </div>

        <div class="pm-filtro-item">
            <label class="pm-filtro-label">Unidad</label>
            <select class="form-select" @bind="unidadFiltro">
                <option value="">Todas las unidades</option>
                <option value="g">g</option>
                <option value="kg">kg</option>
                <option value="l">l</option>
                <option value="ml">ml</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
                <option value="unidad">unidad</option>
                <option value="taza">taza</option>
            </select>
        </div>

        <div class="pm-filtro-item">
            <label class="pm-filtro-label">Costo mín.</label>
            <input type="number" class="form-control pm-input-numero" min="0" step="1" @bind="costoMin" @bind:event="oninput" />
        </div>
        <div class="pm-filtro-item">
            <label class="pm-filtro-label">Costo máx.</label>
            <input type="number" class="form-control pm-input-numero" min="0" step="1" @bind="costoMax" @bind:event="oninput" />
        </div>

        <div class="pm-filtro-item pm-filtro-acciones">
            <label class="pm-filtro-label">&nbsp;</label>
            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltrosLocales">Limpiar</button>
        </div>
    </section>

    @if (mensajeError != null)
    {
        <div class="text-danger msg-error">@mensajeError</div>
    }

    @if (cargando && !insumos.Any())
    {
        <p class="text-muted">Cargando...</p>
    }
    else
    {
        <p class="text-muted small-texto">
            Mostrando @insumosFiltrados.Count de @insumos.Count insumo(s) en esta página (@total en total).
        </p>

        <div class="inventario-tabla-wrap">
            <table class="inventario-tabla">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cantidad</th>
                        <th>Unidad</th>
                        <th>Proveedor actual</th>
                        <th>Costo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (insumosFiltrados.Any())
                    {
                        @foreach (var i in insumosFiltrados)
                        {
                            <tr>
                                <td><strong>@i.Nombre</strong></td>
                                <td class="text-muted">
                                    @(i.Cantidad.HasValue? i.Cantidad.Value.ToString("0.###") : "—")
                                </td>
                                <td class="text-muted">@i.UnidadMedida</td>
                                <td class="text-muted">@(i.Proveedor ?? "—")</td>
                                <td class="text-muted">$@i.CostoUnitario.ToString("N0")</td>
                                <td>
                                    <button type="button" class="btn-mini-editar"
                                            @onclick="() => IrAProveedores(i.Id)">
                                        Gestionar proveedores
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted" style="text-align:center; padding:24px;">
                                @(insumos.Any()
                                                        ? "Ningún insumo de esta página coincide con los filtros."
                                                        : (string.IsNullOrWhiteSpace(textoBusqueda)
                                                        ? "Aún no tienes insumos registrados."
                                                        : "No hay insumos que coincidan con la búsqueda."))
                    </td>
                </tr>
                                }
                </tbody>
            </table>
        </div>
        <Paginador Pagina="pagina" Total="total" TamanoPagina="TamanoPagina" PaginaChanged="CambiarPagina" />
    }
</div>

@code {
    private bool cargando = true;
    private string? mensajeError;

    private int pagina = 1;
    private int total = 0;
    private const int TamanoPagina = 50;

    private string _textoBusqueda = string.Empty;
    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            if (_textoBusqueda == value) return;
            _textoBusqueda = value;
            pagina = 1;
            _ = ReiniciarDebounceAsync();
        }
    }

    // ---------- Filtros locales (sobre la página ya cargada) ----------
    private string unidadFiltro = string.Empty;
    private decimal? costoMin;
    private decimal? costoMax;

    private List<InsumoApiDto> insumos = new();
    private CancellationTokenSource? debounceCts;

    private List<InsumoApiDto> insumosFiltrados
    {
        get
        {
            var termino = Normalizar(textoBusqueda);

            return insumos.Where(i =>
            {
                if (!string.IsNullOrWhiteSpace(unidadFiltro) &&
                    !string.Equals(i.UnidadMedida, unidadFiltro, StringComparison.OrdinalIgnoreCase))
                    return false;

                if (!string.IsNullOrWhiteSpace(termino) &&
                    !Normalizar(i.Nombre).Contains(termino) &&
                    !Normalizar(i.Proveedor).Contains(termino))
                    return false;

                if (costoMin.HasValue && i.CostoUnitario < costoMin.Value) return false;
                if (costoMax.HasValue && i.CostoUnitario > costoMax.Value) return false;

                return true;
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    private async Task ReiniciarDebounceAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        try
        {
            await Task.Delay(400, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await Buscar();
        StateHasChanged();
    }

    private async Task Buscar()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var url = $"api/insumos?pagina={pagina}&tamanoPagina={TamanoPagina}";
            if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                url += $"&busqueda={Uri.EscapeDataString(textoBusqueda)}";
            }

            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var resultado = await resp.Content.ReadFromJsonAsync<ListaPaginadaDto<InsumoApiDto>>();
                insumos = resultado?.Datos ?? new();
                total = resultado?.Total ?? 0;
            }
            else
            {
                mensajeError = $"No se pudo cargar la lista de insumos ({(int)resp.StatusCode}).";
            }
        }
        catch
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        pagina = nuevaPagina;
        await Buscar();
    }

    private void LimpiarFiltrosLocales()
    {
        unidadFiltro = string.Empty;
        costoMin = null;
        costoMax = null;
    }

    private void IrAProveedores(int insumoId)
    {
        Navigation.NavigateTo($"insumos/{insumoId}/proveedores");
    }

    // Quita tildes/diacríticos y pasa a minúsculas (mismo patrón usado en EvaluacionMenu.razor).
    private static string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;

        var formaD = texto.Trim().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder();

        foreach (var c in formaD)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }

        return sb.ToString().Normalize(NormalizationForm.FormC).ToLowerInvariant();
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}