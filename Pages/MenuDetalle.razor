@page "/menu/{Id:int}"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@inject MenuApiService Api
@inject NavigationManager Navigation

<div class="rc-page container py-4">
    <div class="d-flex gap-2 flex-wrap mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick='() => Navigation.NavigateTo("menu")'>← Volver al menú</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ActualizarCostosAsync"
                disabled="@cargando"
                title="Recalcula el costo directo y el margen con los precios actuales de los insumos. No modifica el precio de venta.">
            @(cargando ? "Actualizando..." : "Actualizar costos")
        </button>
    </div>

    @if (mensajeOk is not null)
    {
        <div class="alert alert-success py-2" role="status">@mensajeOk</div>
    }

    @if (cargando)
    {
        <p class="text-muted">Cargando...</p>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (producto is not null)
    {
        <div class="rc-header">
            <div>
                <h2 class="rc-title">@producto.Nombre</h2>
                <p class="rc-subtitle">
                    @(producto.Activo ? "Vigente en el menú" : "Inactivo: no hace parte del menú vigente")
                    · @producto.NumRecetas receta(s)
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="btn @(producto.Activo ? "btn-outline-success" : "btn-outline-secondary") disabled" aria-disabled="true">
                    @(producto.Activo ? "Activo" : "Inactivo")
                </span>
            </div>
        </div>

        <div class="rc-card mt-3 @(producto.Activo ? "" : "cs-inactivo")">
            <div class="rc-card-body">
                <div class="cs-grid">
                    <div><small>Precio venta</small><strong>@(producto.PrecioVenta.HasValue ? Formato.Moneda(producto.PrecioVenta.Value) : "—")</strong></div>
                    <div><small>Costo recetas</small><strong>@Formato.Moneda(producto.CostoRecetas)</strong></div>
                    <div><small>Empaques directos</small><strong>@Formato.Moneda(producto.CostoInsumosDirectos)</strong></div>
                    <div><small>Costo directo</small><strong>@Formato.Moneda(producto.CostoDirecto)</strong></div>
                    <div><small>Margen directo</small><strong>@(producto.MargenDirecto.HasValue ? producto.MargenDirecto.Value.ToString("0.##") + " %" : "—")</strong></div>
                </div>

                <p class="text-muted mt-2 mb-0">
                    <small>
                        El costo directo es la base para fijar el precio. Los costos fijos se cubren con el
                        punto de equilibrio y no se cargan completos a este producto.
                    </small>
                </p>

                <details class="mt-3">
                    <summary>Análisis con costos fijos (opcional)</summary>
                    <div class="cs-grid mt-2">
                        <div><small>Costos fijos asignados</small><strong>@Formato.Moneda(producto.CostoFijoProrrateado)</strong></div>
                        <div><small>Costo completo (con fijos)</small><strong>@Formato.Moneda(producto.CostoTotal)</strong></div>
                        <div><small>Margen con fijos</small><strong>@(producto.MargenReal.HasValue ? producto.MargenReal.Value.ToString("0.##") + " %" : "—")</strong></div>
                    </div>
                    <p class="text-muted mt-2 mb-0">
                        <small>
                            Esta referencia reparte los costos fijos entre las preparaciones del negocio.
                            No modifica el precio ni el margen directo del producto.
                        </small>
                    </p>
                </details>

                <h6 class="rc-section-title mt-3">Recetas que lo componen</h6>
                <div class="table-responsive">
                    <table class="table rc-table align-middle">
                        <thead>
                            <tr>
                                <th>Receta</th>
                                <th class="text-end">Porciones</th>
                                <th class="text-end">Costo por porción</th>
                                <th class="text-end">Costo aportado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in producto.Recetas)
                            {
                                <tr>
                                    <td>@r.Nombre</td>
                                    <td class="text-end">@r.Cantidad.ToString("0.###")</td>
                                    <td class="text-end">@Formato.Moneda(r.CostoUnitario)</td>
                                    <td class="text-end">@Formato.Moneda(r.CostoAportado)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (producto.InsumosDirectos.Any())
                {
                    <h6 class="rc-section-title mt-3">Empaques directos</h6>
                    <ul class="rc-ingredients">
                        @foreach (var i in producto.InsumosDirectos)
                        {
                            <li><span>@i.Nombre (@i.Cantidad.ToString("0.###") @i.UnidadReceta)</span><span>@Formato.Moneda(i.CostoAportado)</span></li>
                        }
                    </ul>
                }

                @if (producto.Advertencias.Any())
                {
                    <div class="mt-2">
                        @foreach (var a in producto.Advertencias)
                        {
                            <div class="alert alert-warning py-1">@a</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProductoMenuDetalleDto? producto;
    private bool cargando = true;
    private string? error, mensajeOk;

    protected override async Task OnParametersSetAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true; error = null;
        try
        {
            var res = await Api.ObtenerAsync(Id);
            if (!res.Exito) { error = res.Mensaje; producto = null; return; }
            producto = res.Datos;
        }
        catch
        {
            error = "No se pudo cargar el producto. Intenta de nuevo.";
            producto = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ActualizarCostosAsync()
    {
        mensajeOk = null;
        await Cargar();
        if (error is null)
        {
            mensajeOk = "Costos actualizados con los precios actuales de los insumos.";
        }
    }
}
