@page "/menu/{Id:int}"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@inject MenuApiService Api
@inject NavigationManager Navigation

<div class="mn-page">
    @if (mensajeOk is not null)
    {
        <div class="mn-alert mn-alert-ok" role="status">@mensajeOk</div>
    }

    @if (cargando)
    {
        <p class="text-muted">Cargando producto...</p>
    }
    else if (error is not null)
    {
        <div class="mn-alert mn-alert-error">@error</div>
        <button type="button" class="mn-btn mn-btn-ghost" @onclick='() => Navigation.NavigateTo("menu")'>
            ← Volver al menú
        </button>
    }
    else if (producto is not null)
    {
        <section class="mn-detail-hero @(producto.Activo ? "" : "mn-detail-inactive")">
            <div class="mn-detail-media">
                @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                {
                    <img src="@Api.UrlImagen(producto.ImagenUrl)" alt="@producto.Nombre" />
                }
                else
                {
                    <div class="mn-card-placeholder">
                        <span>🍽️</span>
                        <small>Sin foto</small>
                    </div>
                }
            </div>
            <div class="mn-detail-copy">
                <div class="mn-detail-meta">
                    <span class="mn-eyebrow">PRODUCTO #@producto.Id</span>
                    <span class="mn-badge @(producto.Activo ? "mn-badge-active" : "mn-badge-inactive")">
                        @(producto.Activo ? "Activo" : "Inactivo")
                    </span>
                </div>
                <h1 class="mn-title">@producto.Nombre</h1>
                <p class="mn-subtitle">
                    @producto.NumRecetas receta(s) en su composición
                    · @(producto.Activo ? "vigente en el menú" : "no hace parte del menú vigente")
                </p>
                <div class="mn-detail-actions">
                    <button type="button" class="mn-btn mn-btn-ghost" @onclick='() => Navigation.NavigateTo("menu")'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                        Volver al menú
                    </button>
                    <button type="button" class="mn-btn mn-btn-ghost" @onclick="ActualizarCostosAsync"
                            disabled="@cargando"
                            title="Recalcula el costo directo y el margen con los precios actuales de los insumos. No modifica el precio de venta.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 11a8 8 0 1 0-2.3 5.7" />
                            <path d="M20 4v7h-7" />
                        </svg>
                        @(cargando ? "Actualizando..." : "Actualizar costos")
                    </button>
                </div>
            </div>
        </section>

        <div class="mn-detail-kpis">
            <div class="mn-detail-kpi">
                <small>Precio venta</small>
                <strong>@(producto.PrecioVenta.HasValue ? Formato.Moneda(producto.PrecioVenta.Value) : "—")</strong>
                <span>Precio publicado en la carta</span>
            </div>
            <div class="mn-detail-kpi">
                <small>Costo recetas</small>
                <strong>@Formato.Moneda(producto.CostoRecetas)</strong>
                <span>Ingredientes de las recetas</span>
            </div>
            <div class="mn-detail-kpi">
                <small>Empaques directos</small>
                <strong>@Formato.Moneda(producto.CostoInsumosDirectos)</strong>
                <span>Caja, bolsa o etiqueta</span>
            </div>
            <div class="mn-detail-kpi mn-detail-kpi-main">
                <small>Costo directo</small>
                <strong>@Formato.Moneda(producto.CostoDirecto)</strong>
                <span>Base para fijar el precio</span>
            </div>
            <div class="mn-detail-kpi">
                <small>Margen directo</small>
                <strong class="@ClaseMargen(producto.MargenDirecto)">
                    @(producto.MargenDirecto.HasValue ? $"{producto.MargenDirecto.Value:0.##} %" : "—")
                </strong>
                <span>Sobre el precio de venta</span>
            </div>
        </div>

        <div class="mn-detail-grid">
            <section class="mn-detail-panel">
                <div class="mn-panel-head">
                    <h2>Recetas que lo componen</h2>
                    <span>@producto.Recetas.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table rc-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Receta</th>
                                <th class="text-end">Porciones</th>
                                <th class="text-end">Costo por porción</th>
                                <th class="text-end">Costo aportado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in producto.Recetas)
                            {
                                <tr>
                                    <td>@r.Nombre</td>
                                    <td class="text-end">@r.Cantidad.ToString("0.###")</td>
                                    <td class="text-end">@Formato.Moneda(r.CostoUnitario)</td>
                                    <td class="text-end">@Formato.Moneda(r.CostoAportado)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <aside class="mn-detail-panel">
                <div class="mn-panel-head">
                    <h2>Empaques directos</h2>
                    <span>@producto.InsumosDirectos.Count</span>
                </div>
                @if (producto.InsumosDirectos.Any())
                {
                    <ul class="mn-ingredients">
                        @foreach (var i in producto.InsumosDirectos)
                        {
                            <li>
                                <span>@i.Nombre (@i.Cantidad.ToString("0.###") @i.UnidadReceta)</span>
                                <strong>@Formato.Moneda(i.CostoAportado)</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mn-panel-empty">Este producto no tiene empaques directos.</p>
                }

                <details class="mn-detail-analysis">
                    <summary>Análisis con costos fijos (opcional)</summary>
                    <div class="mn-detail-analysis-grid">
                        <div>
                            <small>Costos fijos asignados</small>
                            <strong>@Formato.Moneda(producto.CostoFijoProrrateado)</strong>
                        </div>
                        <div>
                            <small>Costo completo (con fijos)</small>
                            <strong>@Formato.Moneda(producto.CostoTotal)</strong>
                        </div>
                        <div>
                            <small>Margen con fijos</small>
                            <strong class="@ClaseMargen(producto.MargenReal)">
                                @(producto.MargenReal.HasValue ? $"{producto.MargenReal.Value:0.##} %" : "—")
                            </strong>
                        </div>
                    </div>
                    <p class="mn-panel-empty">
                        Esta referencia reparte los costos fijos entre las preparaciones del negocio.
                        No modifica el precio ni el margen directo del producto.
                    </p>
                </details>
            </aside>
        </div>

        @if (producto.Advertencias.Any())
        {
            <div class="mn-detail-warnings">
                @foreach (var a in producto.Advertencias)
                {
                    <div class="mn-alert mn-alert-error">@a</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProductoMenuDetalleDto? producto;
    private bool cargando = true;
    private string? error, mensajeOk;

    protected override async Task OnParametersSetAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true; error = null;
        try
        {
            var res = await Api.ObtenerAsync(Id);
            if (!res.Exito) { error = res.Mensaje; producto = null; return; }
            producto = res.Datos;
        }
        catch
        {
            error = "No se pudo cargar el producto. Intenta de nuevo.";
            producto = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ActualizarCostosAsync()
    {
        mensajeOk = null;
        await Cargar();
        if (error is null)
        {
            mensajeOk = "Costos actualizados con los precios actuales de los insumos.";
        }
    }

    private static string ClaseMargen(decimal? margen) => margen switch
    {
        null => "mn-value-muted",
        < 0 => "mn-value-danger",
        < 15 => "mn-value-warning",
        _ => "mn-value-success"
    };
}
