@page "/nueva-contraseña"
@using System.ComponentModel.DataAnnotations
@using PWGAPG_Frontend.Models
@inject NavigationManager Navigation

<div class="auth-card-login">
    <h2 class="auth-titulo">Restablecer Contraseña</h2>
    <p class="auth-subtitulo">Ingresa y confirma tu nueva contraseña</p>

    <EditForm Model="@modelo" OnValidSubmit="@ManejarCambioPassword">
        <DataAnnotationsValidator />

        <!-- Campo 1: Nueva Contraseña -->
        <div class="form-group-sm">
            <label class="auth-label">Nueva Contraseña *</label>
            <div class="campo-password-container">
                <InputText @bind-Value="modelo.NuevaPassword" type="@tipoCampoPassword1" class="form-control input-password" placeholder="••••••••" />
                <button type="button" class="btn-ojo-password" @onclick="AlternarVisibilidad1">
                    <i class="bi @(mostrarPassword1 ? "bi-eye" : "bi-eye-slash")"></i>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        @if (mostrarPassword1)
                        {
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                        }
                        else
                        {
                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z" />
                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.709.709zm10.296 8.884-12-12 .708-.708 12 12-.708.707z" />
                        }
                    </svg>
                </button>
            </div>
            <ValidationMessage For="@(() => modelo.NuevaPassword)" class="text-danger msg-error" />
        </div>

        <!-- Campo 2: Confirmar Contraseña -->
        <div class="form-group">
            <label class="auth-label">Confirmar Nueva Contraseña *</label>
            <div class="campo-password-container">
                <InputText @bind-Value="modelo.ConfirmarPassword" type="@tipoCampoPassword2" class="form-control input-password" placeholder="••••••••" />
                <button type="button" class="btn-ojo-password" @onclick="AlternarVisibilidad2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        @if (mostrarPassword2)
                        {
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                        }
                        else
                        {
                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z" />
                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.709.709zm10.296 8.884-12-12 .708-.708 12 12-.708.707z" />
                        }
                    </svg>
                </button>
            </div>
            <ValidationMessage For="@(() => modelo.ConfirmarPassword)" class="text-danger msg-error" />
        </div>

        <!-- Botones de Acción -->
        <div class="acciones-form-container">
            <button type="submit" class="btn-solid btn-full">
                Aceptar
            </button>
            <button type="button" class="btn-outline btn-full" @onclick="Cancelar">
                Cancelar
            </button>
        </div>
    </EditForm>
</div>

@code {
    private CambiarPasswordDTO modelo = new CambiarPasswordDTO();

    private bool mostrarPassword1 = false;
    private bool mostrarPassword2 = false;

    private string tipoCampoPassword1 => mostrarPassword1 ? "text" : "password";
    private string tipoCampoPassword2 => mostrarPassword2 ? "text" : "password";

    private void AlternarVisibilidad1() => mostrarPassword1 = !mostrarPassword1;
    private void AlternarVisibilidad2() => mostrarPassword2 = !mostrarPassword2;

    private void ManejarCambioPassword()
    {
        // Redirige al login pasando el parámetro de cambio exitoso
        Navigation.NavigateTo("login?passwordCambiada=true");
    }

    private void Cancelar()
    {
        // Redirige al login limpio
        Navigation.NavigateTo("login");
    }
}