@page "/"
@page "/home"
@page "/dashboard-empresa"
@using PWGAPG_Frontend.Components
@inject PWGAPG_Frontend.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (AuthService.IsAuthenticated)
{
    <PanelEmpresa />
}
else
{
    <section class="hero-banner">
        <span class="hero-badge">
            GESTIÓN GASTRONÓMICA 2026
        </span>
        <h1 class="hero-titulo">
            Controla los costos de tu cocina y haz crecer tu negocio
        </h1>
        <p class="hero-descripcion">
            Centraliza insumos, proveedores, recetas y menús en un solo lugar. Calcula costos reales y márgenes de rentabilidad para tomar mejores decisiones.
        </p>
        <div class="hero-acciones">
            <button class="btn-banner-primary" @onclick='() => Navigation.NavigateTo("registro")'>
                Registrar mi Emprendimiento
            </button>
            <button class="btn-banner-secondary" @onclick='() => Navigation.NavigateTo("login")'>
                Iniciar Sesión
            </button>
        </div>
    </section>

    <section>
        <h2 class="titulo-seccion">Todo lo que necesitas para tu negocio</h2>

        <div class="grid-emprendimientos">
            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Insumos y proveedores ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Compras</span>
                    <h3 class="card-titulo">Insumos y proveedores</h3>
                    <p class="card-descripcion">Registra precios, empaques y proveedores para conocer cuánto cuesta realmente cada ingrediente.</p>
                </div>
            </article>

            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Recetas y menús ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Producción</span>
                    <h3 class="card-titulo">Recetas y menús</h3>
                    <p class="card-descripcion">Organiza tus recetas, calcula porciones y mantén actualizado el costo de cada producto de tu menú.</p>
                </div>
            </article>

            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Rentabilidad ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Análisis</span>
                    <h3 class="card-titulo">Rentabilidad</h3>
                    <p class="card-descripcion">Compara costos, precios de venta y márgenes para detectar oportunidades y proteger tu utilidad.</p>
                </div>
            </article>
        </div>
    </section>
}
