@page "/"
@page "/home"
@inject NavigationManager Navigation

<section class="hero-banner" style="background: linear-gradient(135deg, #D97706, #B45309); color: white; padding: 40px; border-radius: 12px; margin-bottom: 30px;">
    <span class="badge" style="background: rgba(255,255,255,0.2); padding: 5px 12px; border-radius: 15px; font-size: 0.85rem; font-weight: bold;">
        RED DE EMPRENDIMIENTO 2026
    </span>
    <h1 style="font-size: 2.2rem; margin: 15px 0 10px 0;">Conecta, Crece e Impulsa tu Negocio</h1>
    <p style="font-size: 1.1rem; opacity: 0.95; max-width: 600px; margin-bottom: 25px;">
        La plataforma diseñada para visibilizar a pequeños y medianos emprendedores. Registra tu marca y da a conocer tus productos.
    </p>
    <div style="display: flex; gap: 15px;">
        <button class="btn-solid" style="background-color: white; color: #D97706; font-size: 1rem; padding: 10px 22px;" @onclick='() => Navigation.NavigateTo("registro")'>
            Registrar mi Emprendimiento
        </button>
        <button class="btn-outline" style="border-color: white; color: white; font-size: 1rem; padding: 10px 22px;" @onclick='() => Navigation.NavigateTo("emprendimientos")'>
            Explorar Negocios
        </button>
    </div>
</section>

<section style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 30px;">
    <div style="display: flex; gap: 10px; align-items: center;">
        <input type="text" placeholder="¿Qué producto o servicio buscas?" style="flex: 1; padding: 10px 15px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 0.95rem;">
        <button class="btn-solid" style="padding: 10px 20px;">Buscar</button>
    </div>
</section>

<section>
    <h2 style="color: #374151; font-size: 1.5rem; margin-bottom: 20px;">Emprendimientos Destacados</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <article style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <div style="height: 140px; background-color: #F3F4F6; display: flex; align-items: center; justify-content: center; color: #9CA3AF;">
                [ Imagen del Negocio ]
            </div>
            <div style="padding: 15px;">
                <span style="color: #D97706; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">Gastronomía</span>
                <h3 style="margin: 5px 0; font-size: 1.1rem;">Cafetería Artesanal</h3>
                <p style="color: #6B7280; font-size: 0.88rem; margin-bottom: 15px;">Café de origen y pan recién horneado cada mañana.</p>
                <button class="btn-outline" style="width: 100%; font-size: 0.85rem;" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
            </div>
        </article>

        <article style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <div style="height: 140px; background-color: #F3F4F6; display: flex; align-items: center; justify-content: center; color: #9CA3AF;">
                [ Imagen del Negocio ]
            </div>
            <div style="padding: 15px;">
                <span style="color: #D97706; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">Repostería</span>
                <h3 style="margin: 5px 0; font-size: 1.1rem;">Panadería</h3>
                <p style="color: #6B7280; font-size: 0.88rem; margin-bottom: 15px;">Panadería y repostería fresca inmediata.</p>
                <button class="btn-outline" style="width: 100%; font-size: 0.85rem;" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
            </div>
        </article>

        <article style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <div style="height: 140px; background-color: #F3F4F6; display: flex; align-items: center; justify-content: center; color: #9CA3AF;">
                [ Imagen del Negocio ]
            </div>
            <div style="padding: 15px;">
                <span style="color: #D97706; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">Productos frescos</span>
                <h3 style="margin: 5px 0; font-size: 1.1rem;">Pasteleria Saludable</h3>
                <p style="color: #6B7280; font-size: 0.88rem; margin-bottom: 15px;">Combinar lo delicioso de los postres con productos naturales perfectos para la salud.</p>
                <button class="btn-outline" style="width: 100%; font-size: 0.85rem;" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
            </div>
        </article>
    </div>
</section>