@page "/"
@page "/home"
@using PWGAPG_Frontend.Components
@inject PWGAPG_Frontend.Services.AuthService AuthService
@inject NavigationManager Navigation

@if (AuthService.IsAuthenticated)
{
    <PanelEmpresa />
}
else
{
    <section class="hero-banner">
        <span class="hero-badge">
            RED DE EMPRENDIMIENTO 2026
        </span>
        <h1 class="hero-titulo">
            Conecta, Crece e Impulsa tu Negocio
        </h1>
        <p class="hero-descripcion">
            La plataforma diseñada para visibilizar a pequeños y medianos emprendedores. Registra tu marca y da a conocer tus productos.
        </p>
        <div class="hero-acciones">
            <button class="btn-banner-primary" @onclick='() => Navigation.NavigateTo("registro")'>
                Registrar mi Emprendimiento
            </button>
            <button class="btn-banner-secondary" @onclick='() => Navigation.NavigateTo("emprendimientos")'>
                Explorar Negocios
            </button>
        </div>
    </section>

    <section class="seccion-busqueda">
        <div class="contenedor-busqueda">
            <input type="text" placeholder="¿Qué producto o servicio buscas?" class="input-busqueda">
            <button class="btn-solid btn-buscar">Buscar</button>
        </div>
    </section>

    <section>
        <h2 class="titulo-seccion">Emprendimientos Destacados</h2>

        <div class="grid-emprendimientos">
            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Imagen del Negocio ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Gastronomía</span>
                    <h3 class="card-titulo">Cafetería Artesanal</h3>
                    <p class="card-descripcion">Café de origen y pan recién horneado cada mañana.</p>
                    <button class="btn-outline btn-ver-perfil" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
                </div>
            </article>

            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Imagen del Negocio ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Repostería</span>
                    <h3 class="card-titulo">Panadería</h3>
                    <p class="card-descripcion">Panadería y repostería fresca inmediata.</p>
                    <button class="btn-outline btn-ver-perfil" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
                </div>
            </article>

            <article class="card-emprendimiento">
                <div class="imagen-placeholder">
                    [ Imagen del Negocio ]
                </div>
                <div class="card-cuerpo">
                    <span class="categoria-tag">Productos frescos</span>
                    <h3 class="card-titulo">Pasteleria Saludable</h3>
                    <p class="card-descripcion">Combinar lo delicioso de los postres con productos naturales perfectos para la salud.</p>
                    <button class="btn-outline btn-ver-perfil" @onclick='() => Navigation.NavigateTo("emprendimientos")'>Ver Perfil</button>
                </div>
            </article>
        </div>
    </section>
}