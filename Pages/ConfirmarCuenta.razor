@page "/confirmar-cuenta"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Confirmar cuenta | Chef Metrics</PageTitle>

<div class="auth-card-login">
    <h1 class="auth-titulo">Confirmación de cuenta</h1>

    <div role="status">
        @if (procesando)
        {
            <p class="auth-subtitulo">Estamos validando tu cuenta...</p>
        }
        else if (cuentaConfirmada)
        {
            <div class="alerta-exito">Tu cuenta fue confirmada correctamente. Ya puedes iniciar sesión.</div>
        }
    </div>

    @if (!procesando && cuentaConfirmada)
    {
        <button type="button" class="btn-solid btn-full" @onclick="IrAlLogin">Iniciar sesión</button>
    }
    else if (!procesando)
    {
        <div class="alerta-box alerta-error" role="alert">
            @mensaje
        </div>

        @if (!mostrarFormularioReenvio)
        {
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <button type="button" class="btn-outline btn-full" @onclick="IrAlLogin">
                    Ir al inicio de sesión
                </button>
                <button type="button" class="btn-solid btn-full" @ref="botonReenvio" @onclick="AbrirReenvio">
                    Solicitar nuevo enlace
                </button>
            </div>
        }
        else
        {
            <form @onsubmit="SolicitarNuevoEnlace" @onsubmit:preventDefault style="background-color: #FFFBEB; border: 1px solid #FCD34D; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; text-align: left;">
                <label for="confirmacion-correo" style="font-size: 0.85rem; font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">
                    Ingresa tu correo para recibir un nuevo enlace:
                </label>
                <input id="confirmacion-correo" type="email" autocomplete="email" required @ref="campoReenvio"
                       @bind="correoReenvio"
                       aria-describedby="confirmacion-reenvio-estado"
                       placeholder="ejemplo@correo.com"
                       style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #767d87; border-radius: 6px; font-size: 0.9rem; margin-bottom: 0.75rem; box-sizing: border-box;" />

                <p id="confirmacion-reenvio-estado" role="status" style="font-size: 0.8rem; color: #92400E; margin-bottom: 0.75rem; font-weight: 500;">
                    @mensajeReenvio
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    <button type="submit"
                            class="btn-solid"
                            style="flex: 1; padding: 0.5rem; font-size: 0.85rem;"
                            disabled="@enviandoReenvio">
                        @(enviandoReenvio ? "Enviando..." : "Enviar nuevo enlace")
                    </button>
                    <button type="button"
                            class="btn-outline"
                            style="padding: 0.5rem 0.75rem; font-size: 0.85rem;"
                            @onclick="CancelarReenvio">
                        Cancelar
                    </button>
                </div>
            </form>

            <button type="button" class="btn-outline btn-full" @onclick="IrAlLogin">
                Ir al inicio de sesión
            </button>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool procesando = true;
    private bool cuentaConfirmada;
    private string mensaje = "El enlace de verificación ha expirado o ya fue utilizado. Por favor, solicita uno nuevo o inicia sesión si ya confirmaste tu cuenta.";

    private bool mostrarFormularioReenvio = false;
    private string correoReenvio = string.Empty;
    private bool enviandoReenvio = false;
    private string? mensajeReenvio;
    private ElementReference botonReenvio;
    private ElementReference campoReenvio;
    private bool moverFocoReenvio;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (moverFocoReenvio)
        {
            moverFocoReenvio = false;
            await (mostrarFormularioReenvio ? campoReenvio : botonReenvio).FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            procesando = false;
            return;
        }

        try
        {
            using var respuesta = await Http.PostAsJsonAsync(
                "api/usuarios/validar-token",
                new { Token });
            var resultado = await respuesta.Content.ReadFromJsonAsync<RespuestaConfirmacion>();

            cuentaConfirmada = respuesta.IsSuccessStatusCode && resultado?.Exito == true;
            mensaje = resultado?.Mensaje ?? mensaje;
        }
        catch (HttpRequestException)
        {
            mensaje = "No fue posible conectar con el servidor. Intenta nuevamente.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task SolicitarNuevoEnlace()
    {
        if (enviandoReenvio) return;

        if (string.IsNullOrWhiteSpace(correoReenvio))
        {
            mensajeReenvio = "Por favor ingresa tu correo electrónico.";
            return;
        }

        enviandoReenvio = true;
        mensajeReenvio = null;

        try
        {
            using var respuesta = await Http.PostAsJsonAsync(
                "api/usuarios/reenviar-verificacion",
                new { Correo = correoReenvio });

            mensajeReenvio = "Si tu cuenta está registrada y aún no ha sido verificada, te hemos enviado un nuevo enlace a tu correo.";
        }
        catch (HttpRequestException)
        {
            mensajeReenvio = "No fue posible conectar con el servidor. Intenta nuevamente.";
        }
        finally
        {
            enviandoReenvio = false;
        }
    }

    private void AbrirReenvio()
    {
        mostrarFormularioReenvio = true;
        moverFocoReenvio = true;
    }

    private void CancelarReenvio()
    {
        mostrarFormularioReenvio = false;
        correoReenvio = string.Empty;
        mensajeReenvio = null;
        moverFocoReenvio = true;
    }

    private void IrAlLogin()
    {
        Navigation.NavigateTo("login");
    }

    private sealed class RespuestaConfirmacion
    {
        public bool Exito { get; set; }
        public string? Mensaje { get; set; }
    }
}
