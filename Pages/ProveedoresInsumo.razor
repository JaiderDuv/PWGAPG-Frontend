    private static string? MsgNombre(string? v)
    {
        if (string.IsNullOrWhiteSpace(v))
            return "El nombre del proveedor es obligatorio.";
        if (v.Trim().Length > 75)
            return "El nombre no puede superar los 75 caracteres.";
        return null;
    }

    private static string? MsgTelefono(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return null; // opcional
        return System.Text.RegularExpressions.Regex.IsMatch(v.Trim(), @"^3\d{9}$")
            ? null
            : "El teléfono debe tener 10 dígitos y empezar por 3.";
    }

    private static string? MsgCorreo(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return null; // opcional
        return System.Text.RegularExpressions.Regex.IsMatch(v.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$")
            ? null
            : "Ingresa un correo electrónico válido.";
    }

    private static void PonerError(Dictionary<string, string> errores, string campo, string? mensaje)
    {
        if (mensaje is null) errores.Remove(campo);
        else errores[campo] = mensaje;
    }


