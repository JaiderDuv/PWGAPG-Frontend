    private bool ValidarEditar()
    {
        erroresEditar.Clear();
        var f = formularioEditar;

        PonerError(erroresEditar, "Nombre", MsgNombre(f.Nombre));
        PonerError(erroresEditar, "Telefono", MsgTelefono(f.Telefono));
        PonerError(erroresEditar, "Correo", MsgCorreo(f.Correo));

        if (string.IsNullOrWhiteSpace(f.UnidadMedida))
            erroresEditar["UnidadMedida"] = "Selecciona una unidad.";

        if (string.IsNullOrWhiteSpace(f.CantidadTexto))
            erroresEditar["Cantidad"] = "La cantidad es obligatoria.";
        else if (!decimal.TryParse(f.CantidadTexto, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var cant))
            erroresEditar["Cantidad"] = "Ingresa un número válido para la cantidad.";
        else if (cant <= 0)
            erroresEditar["Cantidad"] = "La cantidad debe ser mayor a 0.";
        else
        {
            var max = EsUnidadPequena(f.UnidadMedida) ? 999.99m : 999999.99m;
            if (cant > max)
                erroresEditar["Cantidad"] = $"La cantidad no puede superar {max:N2}.";
            else if (Math.Round(cant, 2) != cant)
                erroresEditar["Cantidad"] = "La cantidad admite máximo 2 decimales.";
            else
                f.Cantidad = cant;
        }

        if (string.IsNullOrWhiteSpace(f.CostoTexto))
            erroresEditar["Costo"] = "El precio es obligatorio.";
        else if (!decimal.TryParse(f.CostoTexto, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var costo))
            erroresEditar["Costo"] = "Ingresa un número válido para el precio.";
        else if (costo < 0.01m)
            erroresEditar["Costo"] = "El precio debe ser mayor a 0.";
        else if (costo > 999999.99m)
            erroresEditar["Costo"] = "El precio no puede superar 999.999,99.";
        else if (Math.Round(costo, 2) != costo)
            erroresEditar["Costo"] = "El precio admite máximo 2 decimales.";
        else
            f.Costo = costo;

        return erroresEditar.Count == 0;
    }

