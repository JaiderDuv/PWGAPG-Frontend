@page "/insumos/{InsumoId:int}/proveedores"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Proveedores de un insumo | Chef Metrics</PageTitle>

<div class="onboarding-container inventario-accesible">
    <button type="button" class="btn-outline"
            @onclick='() => Navigation.NavigateTo("insumos-proveedores")'>
        ← Volver
    </button>

    <h1 class="auth-titulo" style="margin-top: 16px;">
        Proveedores de @(string.IsNullOrWhiteSpace(nombreInsumo)
                ? "este insumo" : $"«{nombreInsumo}»")
    </h1>
    <p class="auth-subtitulo">
        Compara precios y gestiona los proveedores asociados a este insumo.
    </p>

    <div class="onboarding-contenido">
        @if (cargando)
        {
            <p class="text-muted">Cargando...</p>
        }
        else
        {
            <div class="socios-header">
                <span></span>
                <button type="button" class="btn-outline" @onclick="AbrirModalAgregar">
                    + Agregar Proveedor
                </button>
            </div>

            @if (mensajeError != null)
            {
                <div class="text-danger msg-error" role="alert">@mensajeError</div>
            }
            @if (mensajeExito != null)
            {
                <div class="text-success msg-error" role="status">@mensajeExito</div>
            }

            @if (proveedoresAsociados.Any())
            {
                <div class="tabla-proveedores-wrap" tabindex="0" role="region" aria-label="Proveedores asociados">
                    <table class="tabla-proveedores" aria-label="Proveedores del insumo">
                        <thead>
                            <tr>
                                <th scope="col">Proveedor</th>
                                <th scope="col">Contacto</th>
                                <th scope="col">Cantidad</th>
                                <th scope="col">Unidad</th>
                                <th scope="col">Precio</th>
                                <th scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in proveedoresAsociados)
                            {
                                <tr class="@(p.EsMasBarato ? "fila-mas-barata" : "")">
                                    <td>
                                        <div class="proveedor-nombre-badges">
                                            <strong>@p.Nombre</strong>
                                            @if (p.EsPrincipal)
                                            {
                                                <span class="badge-principal">Principal</span>
                                            }
                                            @if (p.EsMasBarato)
                                            {
                                                <span class="badge-barato">Más barato</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-muted" style="font-size:0.85rem;">
                                        @(string.IsNullOrWhiteSpace(p.Telefono) ? "Sin teléfono" : p.Telefono)<br />
                                        @(string.IsNullOrWhiteSpace(p.Correo) ? "Sin correo" : p.Correo)
                                    </td>
                                    <td>@p.Cantidad.ToString("0.###")</td>
                                    <td>@p.UnidadMedida</td>
                                    <td>$@p.Costo.ToString("N2")</td>
                                    <td>
                                        <div class="proveedor-acciones">
                                            <button type="button" class="btn-mini-editar"
                                                    aria-label="Editar @p.Nombre" @onclick="() => AbrirModalEditar(p)">
                                                Editar
                                            </button>
                                            @if (!p.EsPrincipal)
                                            {
                                                <button type="button" class="btn-mini-principal"
                                                        aria-label="Marcar principal a @p.Nombre" @onclick="() => MarcarPrincipal(p.ProveedorId)">
                                                    Marcar Principal
                                                </button>
                                            }
                                            <button type="button" class="btn-mini-eliminar"
                                                    aria-label="Eliminar @p.Nombre" @onclick="() => PedirDesasociar(p)">
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">Aún no hay proveedores asociados a este insumo.</p>
            }
        }
    </div>
</div>

@if (mostrarModalEditar && editando is not null)
{
    <AccessibleDialog Class="socio-modal inventario-accesible" LabelledBy="asociado-editar-titulo" OnCancel="CerrarModalEditar">
        <h2 id="asociado-editar-titulo" class="onboarding-subtitulo">Editar proveedor</h2>
        <p class="text-muted" style="font-size:0.8rem; margin-top:-8px; margin-bottom:14px;">
            Los campos marcados con * son obligatorios.
        </p>

        <EditForm Model="@formularioEditar" OnSubmit="@GuardarEdicion" novalidate>

            <div class="form-group-sm">
                <label class="auth-label" for="asociado-editar-nombre">Nombre *</label>
                <input id="asociado-editar-nombre" aria-describedby="asociado-editar-nombre-error" aria-invalid="@(erroresEditar.ContainsKey("Nombre") ? "true" : null)" aria-required="true" autofocus class="form-control @(erroresEditar.ContainsKey("Nombre") ? "is-invalid" : "")"
                       value="@formularioEditar.Nombre"
                       @oninput="e => OnEditarNombre(e.Value?.ToString())" />
                <div id="asociado-editar-nombre-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("Nombre"))</div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="asociado-editar-telefono">Teléfono</label>
                <input type="tel" id="asociado-editar-telefono" aria-describedby="asociado-editar-telefono-error" aria-invalid="@(erroresEditar.ContainsKey("Telefono") ? "true" : null)" class="form-control @(erroresEditar.ContainsKey("Telefono") ? "is-invalid" : "")"
                       placeholder="Opcional"
                       value="@formularioEditar.Telefono"
                       @oninput="e => OnEditarTelefono(e.Value?.ToString())" />
                <div id="asociado-editar-telefono-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("Telefono"))</div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="asociado-editar-correo">Correo</label>
                <input type="email" id="asociado-editar-correo" aria-describedby="asociado-editar-correo-error" aria-invalid="@(erroresEditar.ContainsKey("Correo") ? "true" : null)" class="form-control @(erroresEditar.ContainsKey("Correo") ? "is-invalid" : "")"
                       placeholder="Opcional"
                       value="@formularioEditar.Correo"
                       @oninput="e => OnEditarCorreo(e.Value?.ToString())" />
                <div id="asociado-editar-correo-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("Correo"))</div>
            </div>

            <p class="text-muted" style="font-size:0.75rem; margin-top:-4px;">
                Nombre, teléfono y correo son del proveedor: el cambio aplica a todos los insumos donde aparece.
            </p>

            <div class="onb-grid">
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-editar-cantidad">Cantidad *</label>
                    <AyudaCampoInventario Id="asociado-editar-cantidad-ayuda" Tema="cantidad">Indica la cantidad numérica o el tamaño del producto (por ejemplo: 500).</AyudaCampoInventario>
                    <input id="asociado-editar-cantidad" aria-describedby="asociado-editar-cantidad-error asociado-editar-cantidad-ayuda" aria-invalid="@(erroresEditar.ContainsKey("Cantidad") ? "true" : null)" aria-required="true" type="number" step="1" min="0"
                           class="form-control @(erroresEditar.ContainsKey("Cantidad") ? "is-invalid" : "")"
                           value="@formularioEditar.CantidadTexto"
                           @oninput="e => OnEditarInput(nameof(formularioEditar.CantidadTexto), e.Value?.ToString())" />
                    <div id="asociado-editar-cantidad-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("Cantidad"))</div>
                </div>
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-editar-unidad">Unidad *</label>
                    <AyudaCampoInventario Id="asociado-editar-unidad-ayuda" Tema="unidad">Indica en qué se mide la cantidad del producto (por ejemplo: Gramos, Kilos, Litros, Unidades).</AyudaCampoInventario>
                    <InputSelect id="asociado-editar-unidad" aria-describedby="asociado-editar-unidad-error asociado-editar-unidad-ayuda" aria-invalid="@(erroresEditar.ContainsKey("UnidadMedida") ? "true" : null)" aria-required="true" @bind-Value="formularioEditar.UnidadMedida" class="form-select">
                        <option value="">Selecciona...</option>
                        @foreach (var unidad in ConversorUnidades.Unidades)
                        {
                            <option value="@unidad">@unidad</option>
                        }
                    </InputSelect>
                    <div id="asociado-editar-unidad-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("UnidadMedida"))</div>
                </div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="asociado-editar-precio">Precio *</label>
                <AyudaCampoInventario Id="asociado-editar-precio-ayuda" Tema="precio">Es el costo total que tiene esa cantidad específica del producto (por ejemplo: el precio completo de la bolsa de 500 gramos).</AyudaCampoInventario>
                <input id="asociado-editar-precio" aria-describedby="asociado-editar-precio-error asociado-editar-precio-ayuda" aria-invalid="@(erroresEditar.ContainsKey("Costo") ? "true" : null)" aria-required="true" type="number" step="1" min="0"
                       class="form-control @(erroresEditar.ContainsKey("Costo") ? "is-invalid" : "")"
                       value="@formularioEditar.CostoTexto"
                       @oninput="e => OnEditarInput(nameof(formularioEditar.CostoTexto), e.Value?.ToString())" />
                <div id="asociado-editar-precio-error" class="text-danger msg-error" aria-live="polite">@(erroresEditar.GetValueOrDefault("Costo"))</div>
            </div>

            @if (mensajeErrorModal != null)
            {
                <div class="text-danger msg-error" role="alert">@mensajeErrorModal</div>
            }

            <div class="confirm-acciones" style="margin-top:16px;">
                <button type="button" class="btn-outline" @onclick="CerrarModalEditar">Cancelar</button>
                <button type="submit" class="btn-solid" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </EditForm>
    </AccessibleDialog>
}

@if (mostrarModalAgregar)
{
    <AccessibleDialog Class="socio-modal inventario-accesible" LabelledBy="asociado-agregar-titulo" OnCancel="CerrarModalAgregar">
        <h2 id="asociado-agregar-titulo" class="onboarding-subtitulo">Agregar proveedor</h2>
        <p class="text-muted" style="font-size:0.8rem; margin-top:-8px; margin-bottom:14px;">
            Los campos marcados con * son obligatorios.
        </p>

        <div class="modo-toggle">
            <button type="button"
                    class="@(modoProveedor == "existente" ? "modo-btn activo" : "modo-btn")"
                    aria-pressed="@(modoProveedor == "existente" ? "true" : "false")"
                    @onclick='() => CambiarModo("existente")'
                    disabled="@(!disponibles.Any())">
                Elegir existente
            </button>
            <button type="button"
                    class="@(modoProveedor == "nuevo" ? "modo-btn activo" : "modo-btn")"
                    aria-pressed="@(modoProveedor == "nuevo" ? "true" : "false")"
                    @onclick='() => CambiarModo("nuevo")'>
                Crear nuevo
            </button>
        </div>

        <EditForm Model="@formularioAgregar" OnSubmit="@AgregarProveedor" novalidate>

            @if (modoProveedor == "existente")
            {
                <div class="form-group-sm">
                    <label for="asociado-buscar" class="auth-label">Buscar proveedores</label>
                    <input id="asociado-buscar" type="search" class="form-control"
                           placeholder="Escribe para buscar..." value="@textoProveedor"
                           @oninput="AlEscribirProveedor" />
                    <label for="asociado-existente" class="auth-label">Proveedor *</label>
                    <select id="asociado-existente" class="form-select" value="@(proveedorExistenteId?.ToString() ?? string.Empty)"
                            @onchange="SeleccionarProveedor" aria-required="true"
                            aria-invalid="@(mostrarErrorSeleccion ? "true" : null)"
                            aria-describedby="asociado-existente-estado asociado-existente-error">
                        <option value="">Selecciona un proveedor</option>
                        @foreach (var disponible in coincidenciasExistentes)
                        {
                            <option value="@disponible.Id">@disponible.Nombre</option>
                        }
                    </select>
                    <div id="asociado-existente-estado" class="text-muted" role="status">
                        @if (coincidenciasExistentes.Count == 0)
                        {
                            <small>No hay proveedores que coincidan.</small>
                        }
                    </div>
                    <div id="asociado-existente-error" class="text-danger msg-error" aria-live="polite">
                        @(mostrarErrorSeleccion ? "Selecciona un proveedor de la lista." : null)
                    </div>
                </div>
            }
            else
            {
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-agregar-nombre">Nombre *</label>
                    <input id="asociado-agregar-nombre" aria-describedby="asociado-agregar-nombre-error" aria-invalid="@(erroresAgregar.ContainsKey("Nombre") ? "true" : null)" aria-required="true" class="form-control @(erroresAgregar.ContainsKey("Nombre") ? "is-invalid" : "")"
                           value="@formularioAgregar.Nombre"
                           @oninput="e => OnAgregarNombre(e.Value?.ToString())" />
                    <div id="asociado-agregar-nombre-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("Nombre"))</div>

                    @if (sugerenciasNombre.Any())
                    {
                        <div class="sugerencias-proveedor">
                            <span class="sugerencias-proveedor-titulo">
                                Proveedores similares que ya tienes:
                            </span>
                            @foreach (var s in sugerenciasNombre)
                            {
                                <div class="sugerencias-proveedor-item">@s.Nombre</div>
                            }
                        </div>
                    }
                </div>
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-agregar-telefono">Teléfono</label>
                    <input type="tel" id="asociado-agregar-telefono" aria-describedby="asociado-agregar-telefono-error" aria-invalid="@(erroresAgregar.ContainsKey("Telefono") ? "true" : null)" class="form-control @(erroresAgregar.ContainsKey("Telefono") ? "is-invalid" : "")"
                           placeholder="Opcional"
                           value="@formularioAgregar.Telefono"
                           @oninput="e => OnAgregarTelefono(e.Value?.ToString())" />
                    <div id="asociado-agregar-telefono-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("Telefono"))</div>
                </div>
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-agregar-correo">Correo</label>
                    <input type="email" id="asociado-agregar-correo" aria-describedby="asociado-agregar-correo-error" aria-invalid="@(erroresAgregar.ContainsKey("Correo") ? "true" : null)" class="form-control @(erroresAgregar.ContainsKey("Correo") ? "is-invalid" : "")"
                           placeholder="Opcional"
                           value="@formularioAgregar.Correo"
                           @oninput="e => OnAgregarCorreo(e.Value?.ToString())" />
                    <div id="asociado-agregar-correo-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("Correo"))</div>
                </div>
            }

            <div class="onb-grid">
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-agregar-cantidad">Cantidad *</label>
                    <AyudaCampoInventario Id="asociado-agregar-cantidad-ayuda" Tema="cantidad">Indica la cantidad numérica o el tamaño del producto (por ejemplo: 500).</AyudaCampoInventario>
                    <input id="asociado-agregar-cantidad" aria-describedby="asociado-agregar-cantidad-error asociado-agregar-cantidad-ayuda" aria-invalid="@(erroresAgregar.ContainsKey("Cantidad") ? "true" : null)" aria-required="true" type="number" step="1" min="0" placeholder="Ej.: 500"
                           class="form-control @(erroresAgregar.ContainsKey("Cantidad") ? "is-invalid" : "")"
                           value="@formularioAgregar.CantidadTexto"
                           @oninput="e => OnAgregarInput(nameof(formularioAgregar.CantidadTexto), e.Value?.ToString())" />
                    <div id="asociado-agregar-cantidad-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("Cantidad"))</div>
                </div>
                <div class="form-group-sm">
                    <label class="auth-label" for="asociado-agregar-unidad">Unidad *</label>
                    <AyudaCampoInventario Id="asociado-agregar-unidad-ayuda" Tema="unidad">Indica en qué se mide la cantidad del producto (por ejemplo: Gramos, Kilos, Litros, Unidades).</AyudaCampoInventario>
                    <InputSelect id="asociado-agregar-unidad" aria-describedby="asociado-agregar-unidad-error asociado-agregar-unidad-ayuda" aria-invalid="@(erroresAgregar.ContainsKey("UnidadMedida") ? "true" : null)" aria-required="true" @bind-Value="formularioAgregar.UnidadMedida" class="form-select">
                        <option value="">Selecciona...</option>
                        @foreach (var unidad in ConversorUnidades.Unidades)
                        {
                            <option value="@unidad">@unidad</option>
                        }
                    </InputSelect>
                    <div id="asociado-agregar-unidad-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("UnidadMedida"))</div>
                </div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="asociado-agregar-precio">Precio *</label>
                <AyudaCampoInventario Id="asociado-agregar-precio-ayuda" Tema="precio">Es el costo total que tiene esa cantidad específica del producto (por ejemplo: el precio completo de la bolsa de 500 gramos).</AyudaCampoInventario>
                <input id="asociado-agregar-precio" aria-describedby="asociado-agregar-precio-error asociado-agregar-precio-ayuda" aria-invalid="@(erroresAgregar.ContainsKey("Costo") ? "true" : null)" aria-required="true" type="number" step="1" min="0"
                       class="form-control @(erroresAgregar.ContainsKey("Costo") ? "is-invalid" : "")"
                       value="@formularioAgregar.CostoTexto"
                       @oninput="e => OnAgregarInput(nameof(formularioAgregar.CostoTexto), e.Value?.ToString())" />
                <div id="asociado-agregar-precio-error" class="text-danger msg-error" aria-live="polite">@(erroresAgregar.GetValueOrDefault("Costo"))</div>
            </div>

            @if (mensajeErrorModal != null)
            {
                <div class="text-danger msg-error" role="alert">@mensajeErrorModal</div>
            }

            <div class="confirm-acciones" style="margin-top:16px;">
                <button type="button" class="btn-outline"
                        @onclick="CerrarModalAgregar">
                    Cancelar
                </button>
                <button type="submit" class="btn-solid">Guardar</button>
            </div>
        </EditForm>
    </AccessibleDialog>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="¿Estás seguro de quitar este proveedor del insumo?"
               OnConfirmar="ConfirmarDesasociar"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    [Parameter] public int InsumoId { get; set; }

    private bool cargando = true;
    private string? mensajeError;
    private string? mensajeExito;
    private string? mensajeErrorModal;

    private List<InsumoProveedorDTO> proveedoresAsociados = new();
    private List<ProveedorDTO> disponibles = new();
    private List<ProveedorDTO> todosLosProveedores = new();
    private string nombreInsumo = string.Empty;
    private string unidadInsumo = string.Empty;

    private bool mostrarModalAgregar = false;
    private string modoProveedor = "nuevo";
    private int? proveedorExistenteId;
    private string textoProveedor = string.Empty;
    private ProveedorNuevoDTO formularioAgregar = new();
    private bool mostrarErrorSeleccion;

    private bool mostrarModalEditar = false;
    private bool guardando = false;
    private bool recargarAlCerrar = false;
    private InsumoProveedorDTO? editando;
    private EdicionProveedorModel formularioEditar = new();

    private bool mostrarConfirmEliminar = false;
    private InsumoProveedorDTO? proveedorAEliminar;

    private Dictionary<string, string> erroresEditar = new();
    private Dictionary<string, string> erroresAgregar = new();


    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var respInsumo = await Http.GetAsync($"api/insumos/{InsumoId}");
            if (respInsumo.IsSuccessStatusCode)
            {
                var cuerpo = await respInsumo.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(cuerpo);
                if (doc.RootElement.TryGetProperty("nombre", out var n))
                    nombreInsumo = n.GetString() ?? string.Empty;
                if (doc.RootElement.TryGetProperty("unidadMedida", out var u))
                    unidadInsumo = u.GetString() ?? "g";
            }

            var respAsociados = await Http.GetAsync($"api/insumos/{InsumoId}/proveedores");
            if (respAsociados.IsSuccessStatusCode)
                proveedoresAsociados = await respAsociados.Content
                    .ReadFromJsonAsync<List<InsumoProveedorDTO>>() ?? new();
            else
                mensajeError = "No se pudo cargar la información de proveedores.";

            var respDisponibles = await Http.GetAsync($"api/insumos/{InsumoId}/proveedores-disponibles");
            if (respDisponibles.IsSuccessStatusCode)
                disponibles = await respDisponibles.Content
                    .ReadFromJsonAsync<List<ProveedorDTO>>() ?? new();

            // Todos los proveedores del negocio (para las sugerencias al crear uno nuevo)
            var respTodos = await Http.GetAsync("api/negocios/mio/proveedores");
            if (respTodos.IsSuccessStatusCode)
                todosLosProveedores = await respTodos.Content
                    .ReadFromJsonAsync<List<ProveedorDTO>>() ?? new();
        }
        catch
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }


    private void AbrirModalEditar(InsumoProveedorDTO p)
    {
        editando = p;
        formularioEditar = new EdicionProveedorModel
        {
            Nombre = p.Nombre,
            Telefono = p.Telefono,
            Correo = p.Correo,
            Cantidad = p.Cantidad,
            CantidadTexto = p.Cantidad.ToString("0.##",
                System.Globalization.CultureInfo.InvariantCulture),
            UnidadMedida = p.UnidadMedida,
            Costo = p.Costo,
            CostoTexto = p.Costo.ToString("0.##",
                System.Globalization.CultureInfo.InvariantCulture)
        };
        erroresEditar.Clear();
        mensajeErrorModal = null;
        mensajeError = null;
        mensajeExito = null;
        recargarAlCerrar = false;
        mostrarModalEditar = true;
    }

    private async Task CerrarModalEditar()
    {
        mostrarModalEditar = false;
        editando = null;
        mensajeErrorModal = null;
        if (recargarAlCerrar)
        {
            recargarAlCerrar = false;
            await CargarDatos();
        }
    }

    private async Task GuardarEdicion()
    {
        if (editando is null) return;
        if (!ValidarEditar()) return;

        mensajeErrorModal = null;
        guardando = true;

        try
        {
            var f = formularioEditar;
            var nombre = f.Nombre.Trim();
            var telefono = string.IsNullOrWhiteSpace(f.Telefono) ? null : f.Telefono.Trim();
            var correo = string.IsNullOrWhiteSpace(f.Correo) ? null : f.Correo.Trim();

            var cambioContacto =
                !string.Equals(nombre, editando.Nombre, StringComparison.Ordinal) ||
                telefono != editando.Telefono ||
                correo != editando.Correo;

            var cambioPrecio =
                f.Costo != editando.Costo ||
                f.Cantidad != editando.Cantidad ||
                !string.Equals(f.UnidadMedida, editando.UnidadMedida, StringComparison.Ordinal);

            if (!cambioContacto && !cambioPrecio)
            {
                await CerrarModalEditar();
                mensajeExito = "No había cambios para guardar.";
                return;
            }

            if (cambioContacto)
            {
                var resp = await Http.PatchAsJsonAsync(
                    $"api/proveedores/{editando.ProveedorId}",
                    new { Nombre = nombre, Telefono = telefono, Correo = correo });

                if (!resp.IsSuccessStatusCode)
                {
                    mensajeErrorModal = await ExtraerMensajeError(resp);
                    return;
                }

                editando.Nombre = nombre;
                editando.Telefono = telefono;
                editando.Correo = correo;
                recargarAlCerrar = true;
            }

            if (cambioPrecio)
            {
                var resp = await Http.PatchAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores/{editando.ProveedorId}/costo",
                    new { Costo = f.Costo, Cantidad = f.Cantidad, UnidadMedida = f.UnidadMedida });

                if (!resp.IsSuccessStatusCode)
                {
                    mensajeErrorModal = await ExtraerMensajeError(resp);
                    return;
                }
            }

            recargarAlCerrar = false;
            mostrarModalEditar = false;
            editando = null;
            mensajeExito = "Cambios guardados correctamente.";
            await CargarDatos();
        }
        catch
        {
            mensajeErrorModal = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CerrarModalAgregar()
    {
        if (!guardando) mostrarModalAgregar = false;
    }

    private void AbrirModalAgregar()
    {
        formularioAgregar = new ProveedorNuevoDTO
        {
            UnidadMedida = unidadInsumo,
            CantidadTexto = string.Empty,
            CostoTexto = string.Empty
        };
        erroresAgregar.Clear();
        proveedorExistenteId = null;
        textoProveedor = string.Empty;
        mostrarErrorSeleccion = false;
        mensajeErrorModal = null;
        mensajeError = null;
        mensajeExito = null;
        mostrarModalAgregar = true;
        CambiarModo(disponibles.Any() ? "existente" : "nuevo");
    }

    private void CambiarModo(string modo)
    {
        modoProveedor = modo;
        mostrarErrorSeleccion = false;
        mensajeErrorModal = null;
        textoProveedor = string.Empty;
        proveedorExistenteId = null;
        formularioAgregar.Nombre = modo == "existente" ? "placeholder" : string.Empty;
        formularioAgregar.Telefono = null;
        formularioAgregar.Correo = null;

        // Evita errores viejos al alternar entre "existente" y "nuevo"
        erroresAgregar.Remove("Nombre");
        erroresAgregar.Remove("Telefono");
        erroresAgregar.Remove("Correo");
    }

    // ───────── Modo "Elegir existente": buscador con lista ─────────

    private List<ProveedorDTO> coincidenciasExistentes
    {
        get
        {
            var termino = Normalizar(textoProveedor);
            return disponibles
                .Where(p => termino.Length == 0 || Normalizar(p.Nombre).Contains(termino))
                .OrderBy(p => p.Nombre)
                .Take(8)
                .ToList();
        }
    }

    private void AlEscribirProveedor(ChangeEventArgs e)
    {
        textoProveedor = e.Value?.ToString() ?? string.Empty;
        proveedorExistenteId = null;      // si edita el texto, debe volver a elegir
        mostrarErrorSeleccion = false;
    }

    private void SeleccionarProveedor(ChangeEventArgs e)
    {
        proveedorExistenteId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        mostrarErrorSeleccion = false;
    }

    // ───────── Modo "Crear nuevo": sugerencias de similares ─────────

    private List<ProveedorDTO> sugerenciasNombre
    {
        get
        {
            var termino = Normalizar(formularioAgregar.Nombre);
            if (termino.Length == 0) return new();

            return todosLosProveedores
                .Where(p => Normalizar(p.Nombre).Contains(termino))
                .OrderBy(p => p.Nombre)
                .Take(5)
                .ToList();
        }
    }

    private async Task AgregarProveedor()
    {
        mensajeErrorModal = null;
        mostrarErrorSeleccion = false;

        if (!ValidarAgregar()) return;

        formularioAgregar.Telefono = string.IsNullOrWhiteSpace(formularioAgregar.Telefono)
            ? null : formularioAgregar.Telefono.Trim();
        formularioAgregar.Correo = string.IsNullOrWhiteSpace(formularioAgregar.Correo)
            ? null : formularioAgregar.Correo.Trim();

        try
        {
            HttpResponseMessage resp;

            if (modoProveedor == "existente")
            {
                if (!proveedorExistenteId.HasValue)
                {
                    mostrarErrorSeleccion = true;
                    return;
                }

                resp = await Http.PostAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores",
                    new
                    {
                        ProveedorId = proveedorExistenteId.Value,
                        Costo = formularioAgregar.Costo,
                        Cantidad = formularioAgregar.Cantidad,
                        UnidadMedida = formularioAgregar.UnidadMedida
                    });
            }
            else
            {
                resp = await Http.PostAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores/nuevo", formularioAgregar);
            }

            if (resp.IsSuccessStatusCode)
            {
                mostrarModalAgregar = false;
                await CargarDatos();
            }
            else
            {
                mensajeErrorModal = await ExtraerMensajeError(resp);
            }
        }
        catch
        {
            mensajeErrorModal = "No se pudo conectar con el servidor.";
        }
    }


    private async Task MarcarPrincipal(int proveedorId)
