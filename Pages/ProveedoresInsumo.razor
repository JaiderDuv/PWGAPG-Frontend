    private void ValidarCampoEditar(string campo)
    {
        erroresEditar.Remove(campo);

        if (campo == "Cantidad")
        {
            var texto = formularioEditar.CantidadTexto?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(texto))
            {
                erroresEditar["Cantidad"] = "La cantidad es obligatoria.";
                return;
            }
            if (!decimal.TryParse(texto, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
                erroresEditar["Cantidad"] = "Ingresa un número válido para la cantidad.";
            else if (v <= 0)
                erroresEditar["Cantidad"] = "La cantidad debe ser mayor a 0.";
            else
            {
                var max = EsUnidadPequena(formularioEditar.UnidadMedida) ? 999.99m : 999999.99m;
                if (v > max)
                    erroresEditar["Cantidad"] = $"La cantidad no puede superar {max:N2}.";
                else if (Math.Round(v, 2) != v)
                    erroresEditar["Cantidad"] = "La cantidad admite máximo 2 decimales.";
                else
                    formularioEditar.Cantidad = v;
            }
        }
        else if (campo == "Costo")
        {
            var texto = formularioEditar.CostoTexto?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(texto))
            {
                erroresEditar["Costo"] = "El precio es obligatorio.";
                return;
            }
            if (!decimal.TryParse(texto, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
                erroresEditar["Costo"] = "Ingresa un número válido para el precio.";
            else if (v < 0.01m)
                erroresEditar["Costo"] = "El precio debe ser mayor a 0.";
            else if (v > 999999.99m)
                erroresEditar["Costo"] = "El precio no puede superar 999.999,99.";
            else if (Math.Round(v, 2) != v)
                erroresEditar["Costo"] = "El precio admite máximo 2 decimales.";
            else
                formularioEditar.Costo = v;
        }
    }

