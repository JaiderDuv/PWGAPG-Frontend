@page "/insumos/{InsumoId:int}/proveedores"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="onboarding-container">
    <button type="button" class="btn-outline"
            @onclick='() => Navigation.NavigateTo("insumos-proveedores")'>
        ← Volver
    </button>

    <h2 class="auth-titulo" style="margin-top: 16px;">
        Proveedores de @(string.IsNullOrWhiteSpace(nombreInsumo)
                ? "este insumo" : $"«{nombreInsumo}»")
    </h2>
    <p class="auth-subtitulo">
        Compara precios y gestiona los proveedores asociados a este insumo.
    </p>

    <div class="onboarding-contenido">
        @if (cargando)
        {
            <p class="text-muted">Cargando...</p>
        }
        else
        {
            <div class="socios-header">
                <span></span>
                <button type="button" class="btn-outline" @onclick="AbrirModalAgregar">
                    + Agregar Proveedor
                </button>
            </div>

            @if (mensajeError != null)
            {
                <div class="text-danger msg-error">@mensajeError</div>
            }
            @if (mensajeExito != null)
            {
                <div class="text-success msg-error">@mensajeExito</div>
            }

            @if (proveedoresAsociados.Any())
            {
                <div class="tabla-proveedores-wrap">
                    <table class="tabla-proveedores">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Contacto</th>
                                <th>Cantidad</th>
                                <th>Unidad</th>
                                <th>Precio</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in proveedoresAsociados)
                            {
                                <tr class="@(p.EsMasBarato ? "fila-mas-barata" : "")">
                                    <td>
                                        <div class="proveedor-nombre-badges">
                                            <strong>@p.Nombre</strong>
                                            @if (p.EsPrincipal)
                                            {
                                                <span class="badge-principal">Principal</span>
                                            }
                                            @if (p.EsMasBarato)
                                            {
                                                <span class="badge-barato">Más barato</span>
                                            }
                                    </div>
                                </td>
                                <td class="text-muted" style="font-size:0.85rem;">
                                    @(string.IsNullOrWhiteSpace(p.Telefono) ? "Sin teléfono" : p.Telefono)<br />
                                    @(string.IsNullOrWhiteSpace(p.Correo) ? "Sin correo" : p.Correo)
                                </td>
                                <td>@p.Cantidad.ToString("0.###")</td>
                                <td>@p.UnidadMedida</td>
                                <td>$@p.Costo.ToString("N2")</td>
                                
                        <td>
                            <div class="proveedor-acciones">
                                <button type="button" class="btn-mini-editar"
                                        @onclick="() => AbrirModalEditar(p)">
                                    Editar
                                </button>
                                @if (!p.EsPrincipal)
                                            {
                                                <button type="button" class="btn-mini-principal"
                                                        @onclick="() => MarcarPrincipal(p.ProveedorId)">
                                                    Marcar Principal
                                                </button>
                                            }
                                            <button type="button" class="btn-mini-eliminar"
                                                    @onclick="() => PedirDesasociar(p)">
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">
                    Aún no hay proveedores asociados a este insumo.
                </p>
            }
        }
    </div>
</div>

@* ===================== MODAL EDITAR ===================== *@
@if (mostrarModalEditar && editando is not null)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">Editar proveedor</h3>
            <p class="text-muted"
               style="font-size:0.8rem; margin-top:-8px; margin-bottom:14px;">
                Los campos marcados con * son obligatorios.
            </p>

            <EditForm Model="@formularioEditar" OnValidSubmit="@GuardarEdicion">
                <DataAnnotationsValidator />

                <div class="form-group-sm">
                    <label class="auth-label">Nombre *</label>
                    <InputText @bind-Value="formularioEditar.Nombre" class="form-control" />
                    <ValidationMessage For="@(() => formularioEditar.Nombre)"
                                       class="text-danger msg-error" />
                </div>
                <div class="form-group-sm">
                    <label class="auth-label">Teléfono</label>
                    <InputText @bind-Value="formularioEditar.Telefono"
                               class="form-control" placeholder="Opcional" />
                    <ValidationMessage For="@(() => formularioEditar.Telefono)"
                                       class="text-danger msg-error" />
                </div>
                <div class="form-group-sm">
                    <label class="auth-label">Correo</label>
                    <InputText @bind-Value="formularioEditar.Correo"
                               class="form-control" placeholder="Opcional" />
                    <ValidationMessage For="@(() => formularioEditar.Correo)"
                                       class="text-danger msg-error" />
                </div>
                <p class="text-muted" style="font-size:0.75rem; margin-top:-4px;">
                    Nombre, teléfono y correo son del proveedor: el cambio aplica a todos los insumos donde aparece.
                </p>

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Cantidad *</label>
                        <InputNumber @bind-Value="formularioEditar.Cantidad"
                                     class="form-control" min="0.001" step="any" />
                        <ValidationMessage For="@(() => formularioEditar.Cantidad)"
                                           class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Unidad *</label>
                        <InputSelect @bind-Value="formularioEditar.UnidadMedida" class="form-select">
                            <option value="">Selecciona...</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="l">l</option>
                            <option value="ml">ml</option>
                            <option value="oz">oz</option>
                            <option value="lb">lb</option>
                            <option value="unidad">unidad</option>
                            <option value="taza">taza</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => formularioEditar.UnidadMedida)"
                                           class="text-danger msg-error" />
                    </div>
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Precio *</label>
                    <InputNumber @bind-Value="formularioEditar.Costo"
                                 class="form-control" min="0.01" step="any" />
                    <ValidationMessage For="@(() => formularioEditar.Costo)"
                                       class="text-danger msg-error" />
                </div>

                @if (mensajeErrorModal != null)
                {
                    <div class="text-danger msg-error">@mensajeErrorModal</div>
                }

                <div class="confirm-acciones" style="margin-top:16px;">
                    <button type="button" class="btn-outline" @onclick="CerrarModalEditar">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-solid" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ===================== MODAL AGREGAR ===================== *@
@if (mostrarModalAgregar)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">Agregar proveedor</h3>
            <p class="text-muted"
               style="font-size:0.8rem; margin-top:-8px; margin-bottom:14px;">
                Los campos marcados con * son obligatorios.
            </p>

            <div class="modo-toggle">
                <button type="button"
                        class="@(modoProveedor == "existente" ? "modo-btn activo" : "modo-btn")"
                        @onclick='() => CambiarModo("existente")'
                        disabled="@(!disponibles.Any())">
                    Elegir existente
                </button>
                <button type="button"
                        class="@(modoProveedor == "nuevo" ? "modo-btn activo" : "modo-btn")"
                        @onclick='() => CambiarModo("nuevo")'>
                    Crear nuevo
                </button>
            </div>

            <EditForm Model="@formularioAgregar" OnValidSubmit="@AgregarProveedor">
                <DataAnnotationsValidator />

                @if (modoProveedor == "existente")
                {
                    <div class="form-group-sm">
                        <label class="auth-label">Proveedor *</label>
                        <select class="form-select" @bind="proveedorExistenteId">
                            <option value="">-- Seleccione --</option>
                            @foreach (var d in disponibles)
                            {
                                <option value="@d.Id">@d.Nombre</option>
                            }
                        </select>
                        @if (mostrarErrorSeleccion)
                        {
                            <span class="text-danger msg-error">
                                Seleccione un proveedor.
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="form-group-sm">
                        <label class="auth-label">Nombre *</label>
                        <InputText @bind-Value="formularioAgregar.Nombre"
                                   class="form-control" />
                        <ValidationMessage For="@(() => formularioAgregar.Nombre)"
                                           class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Teléfono</label>
                        <InputText @bind-Value="formularioAgregar.Telefono"
                                   class="form-control" placeholder="Opcional" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Correo</label>
                        <InputText @bind-Value="formularioAgregar.Correo"
                                   class="form-control" placeholder="Opcional" />
                    </div>
                }

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Cantidad *</label>
                        <InputNumber @bind-Value="formularioAgregar.Cantidad"
                                     class="form-control" min="0.001" step="any"
                                     placeholder="Ej.: 500" />
                        <ValidationMessage For="@(() => formularioAgregar.Cantidad)"
                                           class="text-danger msg-error" />
                    </div>
                    <div class="form-group-sm">
                        <label class="auth-label">Unidad *</label>
                        <InputSelect @bind-Value="formularioAgregar.UnidadMedida"
                                     class="form-select">
                            <option value="">Selecciona...</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="l">l</option>
                            <option value="ml">ml</option>
                            <option value="oz">oz</option>
                            <option value="lb">lb</option>
                            <option value="unidad">unidad</option>
                            <option value="taza">taza</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => formularioAgregar.UnidadMedida)"
                                           class="text-danger msg-error" />
                    </div>
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Precio *</label>
                    <InputNumber @bind-Value="formularioAgregar.Costo"
                                 class="form-control" />
                    <ValidationMessage For="@(() => formularioAgregar.Costo)"
                                       class="text-danger msg-error" />
                </div>

                @if (mensajeErrorModal != null)
                {
                    <div class="text-danger msg-error">@mensajeErrorModal</div>
                }

                <div class="confirm-acciones" style="margin-top:16px;">
                    <button type="button" class="btn-outline"
                            @onclick="() => mostrarModalAgregar = false">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-solid">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="¿Estás seguro de quitar este proveedor del insumo?"
               OnConfirmar="ConfirmarDesasociar"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    [Parameter] public int InsumoId { get; set; }

    private bool cargando = true;
    private string? mensajeError;
    private string? mensajeExito;
    private string? mensajeErrorModal;

    private List<InsumoProveedorDTO> proveedoresAsociados = new();
    private List<ProveedorDTO> disponibles = new();

    // Modal agregar
    private bool mostrarModalAgregar = false;
    private string modoProveedor = "nuevo";
    private int? proveedorExistenteId;
    private ProveedorNuevoDTO formularioAgregar = new();
    private bool mostrarErrorSeleccion;
    private string nombreInsumo = string.Empty;
    private string unidadInsumo = string.Empty;

    // Modal editar
    private bool mostrarModalEditar = false;
    private bool guardando = false;
    private bool recargarAlCerrar = false;
    private InsumoProveedorDTO? editando;
    private EdicionProveedorModel formularioEditar = new();

    private bool mostrarConfirmEliminar = false;
    private InsumoProveedorDTO? proveedorAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var respInsumo = await Http.GetAsync($"api/insumos/{InsumoId}");
            if (respInsumo.IsSuccessStatusCode)
            {
                var cuerpo = await respInsumo.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(cuerpo);
                if (doc.RootElement.TryGetProperty("nombre", out var n))
                    nombreInsumo = n.GetString() ?? string.Empty;
                if (doc.RootElement.TryGetProperty("unidadMedida", out var u))
                    unidadInsumo = u.GetString() ?? "g";
            }

            var respAsociados = await Http.GetAsync($"api/insumos/{InsumoId}/proveedores");
            if (respAsociados.IsSuccessStatusCode)
            {
                proveedoresAsociados = await respAsociados.Content
                    .ReadFromJsonAsync<List<InsumoProveedorDTO>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudo cargar la información de proveedores.";
            }

            var respDisponibles = await Http.GetAsync(
                $"api/insumos/{InsumoId}/proveedores-disponibles");
            if (respDisponibles.IsSuccessStatusCode)
            {
                disponibles = await respDisponibles.Content
                    .ReadFromJsonAsync<List<ProveedorDTO>>() ?? new();
            }
        }
        catch
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    // ---------- Modal editar ----------

    private void AbrirModalEditar(InsumoProveedorDTO p)
    {
        editando = p;
        formularioEditar = new EdicionProveedorModel
        {
            Nombre = p.Nombre,
            Telefono = p.Telefono,
            Correo = p.Correo,
            Cantidad = p.Cantidad,
            UnidadMedida = p.UnidadMedida,
            Costo = p.Costo
        };
        mensajeErrorModal = null;
        mensajeError = null;
        mensajeExito = null;
        recargarAlCerrar = false;
        mostrarModalEditar = true;
    }

    private async Task CerrarModalEditar()
    {
        mostrarModalEditar = false;
        editando = null;
        mensajeErrorModal = null;
        if (recargarAlCerrar)
        {
            recargarAlCerrar = false;
            await CargarDatos();
        }
    }

    private async Task GuardarEdicion()
    {
        if (editando is null) return;

        mensajeErrorModal = null;
        guardando = true;

        try
        {
            var f = formularioEditar;
            var nombre = f.Nombre.Trim();
            var telefono = string.IsNullOrWhiteSpace(f.Telefono) ? null : f.Telefono.Trim();
            var correo = string.IsNullOrWhiteSpace(f.Correo) ? null : f.Correo.Trim();

            var cambioContacto =
                !string.Equals(nombre, editando.Nombre, StringComparison.Ordinal) ||
                telefono != editando.Telefono ||
                correo != editando.Correo;

            var cambioPrecio =
                f.Costo != editando.Costo ||
                f.Cantidad != editando.Cantidad ||
                !string.Equals(f.UnidadMedida, editando.UnidadMedida, StringComparison.Ordinal);

            if (!cambioContacto && !cambioPrecio)
            {
                await CerrarModalEditar();
                mensajeExito = "No había cambios para guardar.";
                return;
            }

            if (cambioContacto)
            {
                var resp = await Http.PatchAsJsonAsync(
                    $"api/proveedores/{editando.ProveedorId}",
                    new { Nombre = nombre, Telefono = telefono, Correo = correo });

                if (!resp.IsSuccessStatusCode)
                {
                    mensajeErrorModal = await ExtraerMensajeError(resp);
                    return;
                }

                // Ya quedó guardado: si el precio falla, el reintento no lo vuelve a enviar.
                editando.Nombre = nombre;
                editando.Telefono = telefono;
                editando.Correo = correo;
                recargarAlCerrar = true;
            }

            if (cambioPrecio)
            {
                var resp = await Http.PatchAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores/{editando.ProveedorId}/costo",
                    new
                    {
                        Costo = f.Costo,
                        Cantidad = f.Cantidad,
                        UnidadMedida = f.UnidadMedida
                    });

                if (!resp.IsSuccessStatusCode)
                {
                    mensajeErrorModal = await ExtraerMensajeError(resp);
                    return;
                }
            }

            recargarAlCerrar = false;
            mostrarModalEditar = false;
            editando = null;
            mensajeExito = "Cambios guardados correctamente.";
            await CargarDatos();
        }
        catch
        {
            mensajeErrorModal = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ---------- Modal agregar ----------

    private void AbrirModalAgregar()
    {
        formularioAgregar = new ProveedorNuevoDTO { UnidadMedida = unidadInsumo };
        proveedorExistenteId = null;
        mostrarErrorSeleccion = false;
        mensajeErrorModal = null;
        mensajeError = null;
        mensajeExito = null;
        mostrarModalAgregar = true;
        CambiarModo(disponibles.Any() ? "existente" : "nuevo");
    }

    private void CambiarModo(string modo)
    {
        modoProveedor = modo;
        mostrarErrorSeleccion = false;
        mensajeErrorModal = null;
        formularioAgregar.Nombre = modo == "existente" ? "placeholder" : string.Empty;
        formularioAgregar.Telefono = null;
        formularioAgregar.Correo = null;
    }

    private async Task AgregarProveedor()
    {
        mensajeErrorModal = null;
        mostrarErrorSeleccion = false;

        formularioAgregar.Telefono = string.IsNullOrWhiteSpace(formularioAgregar.Telefono)
            ? null : formularioAgregar.Telefono.Trim();
        formularioAgregar.Correo = string.IsNullOrWhiteSpace(formularioAgregar.Correo)
            ? null : formularioAgregar.Correo.Trim();

        try
        {
            HttpResponseMessage resp;

            if (modoProveedor == "existente")
            {
                if (!proveedorExistenteId.HasValue)
                {
                    mostrarErrorSeleccion = true;
                    return;
                }

                resp = await Http.PostAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores",
                    new
                    {
                        ProveedorId = proveedorExistenteId.Value,
                        Costo = formularioAgregar.Costo,
                        Cantidad = formularioAgregar.Cantidad,
                        UnidadMedida = formularioAgregar.UnidadMedida
                    });
            }
            else
            {
                resp = await Http.PostAsJsonAsync(
                    $"api/insumos/{InsumoId}/proveedores/nuevo", formularioAgregar);
            }

            if (resp.IsSuccessStatusCode)
            {
                mostrarModalAgregar = false;
                await CargarDatos();
            }
            else
            {
                mensajeErrorModal = await ExtraerMensajeError(resp);
            }
        }
        catch
        {
            mensajeErrorModal = "No se pudo conectar con el servidor.";
        }
    }

    // ---------- Marcar principal ----------

    private async Task MarcarPrincipal(int proveedorId)
    {
        mensajeError = null;
        mensajeExito = null;
        try
        {
            var resp = await Http.PatchAsync(
                $"api/insumos/{InsumoId}/proveedores/{proveedorId}/principal", null);
            if (resp.IsSuccessStatusCode)
            {
                mensajeExito = "Proveedor marcado como principal.";
                await CargarDatos();
            }
            else
            {
                mensajeError = "No se pudo marcar como principal.";
            }
        }
        catch
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
    }

    // ---------- Eliminar ----------

    private void PedirDesasociar(InsumoProveedorDTO proveedor)
    {
        proveedorAEliminar = proveedor;
        mostrarConfirmEliminar = true;
    }

    private async Task ConfirmarDesasociar()
    {
        mostrarConfirmEliminar = false;
        if (proveedorAEliminar == null) return;

        mensajeError = null;
        mensajeExito = null;

        try
        {
            var resp = await Http.DeleteAsync(
                $"api/insumos/{InsumoId}/proveedores/{proveedorAEliminar.ProveedorId}");
            if (resp.IsSuccessStatusCode)
            {
                mensajeExito = "Proveedor eliminado correctamente.";
                await CargarDatos();
            }
            else
            {
                mensajeError = "No se pudo quitar el proveedor.";
            }
        }
        catch
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }

        proveedorAEliminar = null;
    }

    // ---------- Utilidades ----------

    private async Task<string> ExtraerMensajeError(HttpResponseMessage resp)
    {
        try
        {
            var cuerpo = await resp.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(cuerpo);
            var root = doc.RootElement;

            if (root.TryGetProperty("mensaje", out var mensaje))
                return mensaje.GetString() ?? "No se pudo completar la acción.";

            if (root.TryGetProperty("errors", out var errores) &&
                errores.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var campo in errores.EnumerateObject())
                    foreach (var texto in campo.Value.EnumerateArray())
                    {
                        var valor = texto.GetString();
                        if (!string.IsNullOrWhiteSpace(valor)) return valor;
                    }
            }
        }
        catch { }

        return "No se pudo completar la acción. Verifica los datos e intenta de nuevo.";
    }

    // ---------- Modelo del formulario de edición ----------
    private class EdicionProveedorModel
    {
        [Required(ErrorMessage = "El nombre del proveedor es obligatorio.")]
        [StringLength(150, ErrorMessage = "El nombre no puede superar los 150 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [RegularExpression(@"^$|^3\d{9}$", ErrorMessage = "El teléfono debe tener 10 dígitos y empezar por 3.")]
        public string? Telefono { get; set; }

        [RegularExpression(@"^$|^[^@\s]+@[^@\s]+\.[^@\s]+$", ErrorMessage = "Ingrese un correo electrónico válido.")]
        public string? Correo { get; set; }

        [Range(0.01, double.MaxValue, ErrorMessage = "La cantidad debe ser mayor a 0.")]
        public decimal Cantidad { get; set; }

        [Required(ErrorMessage = "La unidad es obligatoria.")]
        public string UnidadMedida { get; set; } = string.Empty;

        [Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor a 0.")]
        public decimal Costo { get; set; }
    }
}