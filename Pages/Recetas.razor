@page "/recetas"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@using PWGAPG_Frontend.Components
@inject RecetaApiService Api

<div class="rc-page container py-4">
    <div class="rc-header">
        <div>
            <h2 class="rc-title">Mis recetas</h2>
            <p class="rc-subtitle">Estandariza tus recetas y conoce lo que cuesta cada porción.</p>
        </div>
        @if (!mostrarForm)
        {
            <button class="btn btn-primary" @onclick="Nueva">+ Nueva receta</button>
        }
    </div>

    @if (mensajeOk is not null) { <div class="alert alert-success">@mensajeOk</div> }
    @if (error is not null) { <div class="alert alert-danger">@error</div> }

    @if (mostrarForm)
    {
        <RecetaForm @key="formKey" Editando="editando" Insumos="insumos"
                    OnGuardado="AlGuardar" OnCancelar="CerrarForm" />
    }
    else
    {
        <div class="rc-toolbar">
            <input class="form-control" placeholder="Buscar receta por nombre..." maxlength="100"
                   @bind="busqueda" @bind:event="oninput" @onkeyup="BuscarConEnter" />
            <button class="btn btn-outline-secondary" @onclick="Cargar">Buscar</button>
            @if (recetas is not null) { <span class="rc-count">@recetas.Count receta(s)</span> }
        </div>

        @if (recetas is null)
        {
            <p class="text-muted">Cargando...</p>
        }
        else if (recetas.Count == 0)
        {
            <div class="rc-empty">
                <p>Aún no tienes recetas. Crea la primera.</p>
            </div>
        }
        else
        {
            <div class="rc-grid">
            @foreach (var r in recetas)
            {
                    <div class="rc-recipe @(costosAbiertos.Contains(r.Id) || preciosAbiertos.Contains(r.Id) || escaladosAbiertos.Contains(r.Id) ? "rc-recipe-wide" : "")">
                    <div class="rc-recipe-img">
                        @if (Api.UrlImagen(r.ImagenUrl) is { } url) { <img src="@url" alt="@r.Nombre" loading="lazy" /> }
                        else { <span class="rc-sin-imagen">Sin imagen</span> }
                        <small class="rc-id">#@r.Id</small>
                    </div>
                    <div class="rc-recipe-body">
                        <h5>@r.Nombre</h5>
                        <div class="rc-meta">
                            <span>@r.PorcionesBase porción(es)</span>
                            <span>@r.Insumos.Count ingrediente(s)</span>
                        </div>
                        <div class="rc-price">
                            <div><small>Costo de insumos</small><strong>@Formato.Moneda(r.CostoTotal)</strong></div>
                            <div><small>Por porción</small><strong>@Formato.Moneda(r.CostoPorPorcion)</strong></div>
                        </div>
                        <details>
                            <summary>Ver ingredientes</summary>
                            <ul class="rc-ingredients">
                                @foreach (var i in r.Insumos)
                                {
                                    <li><span>@i.InsumoNombre</span><span>@i.Cantidad.ToString("0.###") @i.UnidadMedida</span></li>
                                }
                            </ul>
                            @if (!string.IsNullOrWhiteSpace(r.Instrucciones)) { <p class="rc-instr">@r.Instrucciones</p> }
                        </details>

                            <div class="rc-analysis">
                                <span class="rc-analysis-label">Análisis</span>
                                <div class="rc-analysis-btns">
                                    <button class="btn btn-sm @(costosAbiertos.Contains(r.Id) ? "btn-primary" : "btn-outline-secondary")" @onclick="() => AlternarCosto(r.Id)">
                                        @(costosAbiertos.Contains(r.Id) ? "Ocultar costo real" : "Ver costo real")
                                    </button>
                                    <button class="btn btn-sm @(preciosAbiertos.Contains(r.Id) ? "btn-primary" : "btn-outline-secondary")" @onclick="() => AlternarPrecio(r.Id)">
                                        @(preciosAbiertos.Contains(r.Id) ? "Ocultar precio sugerido" : "Ver precio sugerido")
                                    </button>
                                    <button class="btn btn-sm @(escaladosAbiertos.Contains(r.Id) ? "btn-primary" : "btn-outline-secondary")" @onclick="() => AlternarEscalado(r.Id)">
                                        @(escaladosAbiertos.Contains(r.Id) ? "Ocultar escalado" : "Escalar por porciones")
                                    </button>
                                </div>
                            </div>

                            @if (costosAbiertos.Contains(r.Id) || preciosAbiertos.Contains(r.Id) || escaladosAbiertos.Contains(r.Id))
                            {
                                <div class="rc-panel-zone">
                                    @if (costosAbiertos.Contains(r.Id))
                                    {
                                        <CostoRecetaPanel RecetaId="r.Id" />
                                    }
                                    @if (preciosAbiertos.Contains(r.Id))
                                    {
                                        <SugerenciaPrecioVenta RecetaId="r.Id" />
                                    }
                                    @if (escaladosAbiertos.Contains(r.Id))
                                    {
                                        <EscaladoPorcionesPanel RecetaId="r.Id" PorcionesBase="r.PorcionesBase" />
                                    }
                                </div>
                            }
                    </div>
                    <div class="rc-recipe-actions">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(r)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(r)">Eliminar</button>
                    </div>
                </div>
            }
            </div>
        }
    }
</div>

<ConfirmDialog Visible="mostrarConfirm"
               Mensaje="@($"¿Eliminar la receta '{aEliminar?.Nombre}' para siempre? Esta acción no se puede deshacer.")"
               OnConfirmar="ConfirmarEliminar"
               OnCancelar="CancelarEliminar" />

@code {
    private List<RecetaDto>? recetas;
    private List<InsumoOpcionDto> insumos = new();
    private RecetaDto? editando, aEliminar;
    private bool mostrarForm, mostrarConfirm;
    private string? busqueda, error, mensajeOk;
    private Guid formKey = Guid.NewGuid();
    private readonly HashSet<int> costosAbiertos = new();
    private readonly HashSet<int> preciosAbiertos = new();
    private readonly HashSet<int> escaladosAbiertos = new();

    protected override async Task OnInitializedAsync()
    {
        insumos = await Api.ListarInsumosAsync();
        await Cargar();
    }

    private async Task Cargar()
    {
        var res = await Api.ListarAsync(busqueda);
        if (res.Exito) { recetas = res.Datos; error = null; }
        else { recetas = new(); error = res.Mensaje; }
    }

    private async Task BuscarConEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await Cargar(); }

    private void AlternarCosto(int id)
    {
        if (!costosAbiertos.Remove(id)) costosAbiertos.Add(id);
    }
    private void AlternarPrecio(int id)
    {
        if (!preciosAbiertos.Remove(id)) preciosAbiertos.Add(id);
    }
    private void AlternarEscalado(int id)
    {
        if (!escaladosAbiertos.Remove(id)) escaladosAbiertos.Add(id);
    }

    private void Nueva() { editando = null; AbrirForm(); }
    private void Editar(RecetaDto r) { editando = r; AbrirForm(); }

    private void AbrirForm()
    {
        mensajeOk = error = null;
        formKey = Guid.NewGuid();
        mostrarForm = true;
    }

    private void CerrarForm() => mostrarForm = false;

    private async Task AlGuardar(string? aviso)
    {
        mostrarForm = false;
        mensajeOk = aviso ?? (editando is null ? "Receta creada correctamente." : "Receta actualizada correctamente.");
        await Cargar();
    }

    private void PedirEliminar(RecetaDto r) { aEliminar = r; mostrarConfirm = true; }
    private void CancelarEliminar() { mostrarConfirm = false; aEliminar = null; }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirm = false;
        var res = await Api.EliminarAsync(aEliminar!.Id);
        if (res.Exito) { mensajeOk = "Receta eliminada correctamente."; error = null; }
        else { error = res.Mensaje; mensajeOk = null; }
        aEliminar = null;
        await Cargar();
    }
}