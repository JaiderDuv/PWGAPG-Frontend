@page "/insumos"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@inject PWGAPG_Frontend.Services.InsumoService InsumoService
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<PageTitle>Mis insumos | Chef Metrics</PageTitle>

<div class="insumos-shell">
    <div class="insumos-heading">
        <div>
            <span class="perfil-kicker">INVENTARIO</span>
            <h1>Insumos</h1>
        </div>
        <div class="insumos-heading-acciones">
            <div class="insumos-exportador" @onkeydown="ManejarTeclaMenuReportes">
                @if (menuReportesAbierto)
                {
                    <div class="insumos-export-capa" @onclick="CerrarMenuReportes"></div>
                }
                <button type="button"
                        class="btn-outline insumos-btn-reporte insumos-btn-descargar"
                        @onclick="AlternarMenuReportes"
                        disabled="@(generandoPdf || generandoExcel)"
                        aria-label="Descargar reportes de insumos"
                        @onkeydown="ManejarTeclaBotonReportes"
                        id="insumos-descargar"
                        aria-expanded="@(menuReportesAbierto ? "true" : "false")"
                        aria-controls="@(menuReportesAbierto ? "menu-reportes-insumos" : null)">
                    <svg class="insumos-icono-descarga" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" />
                    </svg>
                    <span>@(generandoPdf || generandoExcel ? "Preparando…" : "Descargar")</span>
                    <svg class="insumos-icono-chevron @(menuReportesAbierto ? "abierto" : "")" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path d="m3 6 5 5 5-5" />
                    </svg>
                </button>
                @if (menuReportesAbierto)
                {
                    <div id="menu-reportes-insumos" class="insumos-menu-reportes" role="group" aria-label="Formatos de descarga">
                        <div class="insumos-menu-reportes-titulo">Descargar reporte</div>
                        <button type="button" class="insumos-opcion-reporte" id="insumos-descargar-pdf" @onclick="DescargarPdfDesdeMenuAsync">
                            <span class="insumos-reporte-formato insumos-reporte-formato-pdf" aria-hidden="true">PDF</span>
                            <span class="insumos-reporte-detalle"><strong>Listado de insumos</strong><small>Inventario completo en PDF</small></span>
                        </button>
                        <button type="button" class="insumos-opcion-reporte" @onclick="DescargarExcelDesdeMenuAsync">
                            <span class="insumos-reporte-formato insumos-reporte-formato-excel" aria-hidden="true">XLSX</span>
                            <span class="insumos-reporte-detalle"><strong>Historial de insumos</strong><small>Movimientos y precios en Excel</small></span>
                        </button>
                    </div>
                }
            </div>
            <button type="button" class="btn-outline" @onclick='() => Navigation.NavigateTo("insumos/historial")'>Historial de precios</button>
            <button type="button" class="btn-solid" @onclick="AbrirModalNuevo">+ Nuevo insumo</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeReporte))
    {
        <div class="perfil-alerta @(reporteConError ? "perfil-alerta-error" : "perfil-alerta-exito")" role="@(reporteConError ? "alert" : "status")">
            @mensajeReporte
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="perfil-alerta perfil-alerta-exito" role="status">@mensajeExito</div>
    }
    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">@mensajeError</div>
    }
    @if (bloqueoEliminar is not null)
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">
            @bloqueoEliminar.Mensaje
            <div class="insumos-bloqueo-acciones">
                <button type="button" class="btn-outline" @onclick="CerrarBloqueo">Mantener activo</button>
                <button type="button" class="btn-solid" @onclick="DesactivarEnUso" disabled="@procesando">
                    @(procesando ? "Desactivando..." : "Desactivarlo en su lugar")
                </button>
            </div>
        </div>
    }

    <section class="insumos-toolbar" aria-label="Filtros de insumos">
        <input type="search" class="form-control insumos-buscador"
               aria-label="Buscar insumos por nombre o proveedor"
               placeholder="Buscar por nombre o proveedor..."
               value="@textoBusqueda"
               @oninput="OnBusquedaInput" />

        <select class="form-select" value="@unidadFiltro" @onchange="OnUnidadFiltroChanged" aria-label="Filtrar por unidad">
            <option value="">Todas las unidades</option>
            @foreach (var unidad in ConversorUnidades.Unidades)
            {
                <option value="@unidad">@unidad</option>
            }
        </select>

        <select class="form-select" value="@categoriaFiltro" @onchange="OnCategoriaFiltroChanged" aria-label="Filtrar por categoría">
            <option value="">Todas las categorías</option>
            <option value="materia_prima">Materia prima</option>
            <option value="empaque">Empaque</option>
            <option value="otro">Otro</option>
        </select>

        <select class="form-select" value="@ordenarPor" @onchange="OnOrdenChanged" aria-label="Ordenar por">
            <option value="nombre">Nombre</option>
            <option value="costo">Costo</option>
            <option value="cantidad">Cantidad</option>
        </select>

        <select class="form-select" value="@direccion" @onchange="OnDireccionChanged" aria-label="Dirección del orden">
            <option value="asc">Ascendente</option>
            <option value="desc">Descendente</option>
        </select>

        <label class="insumos-check">
            <input type="checkbox" checked="@incluirInactivos" @onchange="OnIncluirInactivosChanged" />
            Incluir inactivos
        </label>
    </section>

    @if (cargando)
    {
        <section class="perfil-cargando-card" aria-live="polite">
            <div class="perfil-spinner" aria-hidden="true"></div>
            <h2>Cargando insumos</h2>
            <p>Estamos consultando tu inventario.</p>
        </section>
    }
    else if (!insumos.Any())
    {
        <p class="text-muted">No hay insumos para mostrar. Usa «Nuevo insumo» para registrar el primero.</p>
    }
    else
    {
        <div class="insumos-tabla-wrap" tabindex="0" role="region" aria-label="Inventario de insumos">
            <table class="insumos-tabla" aria-label="Insumos">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Unidad</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Costo</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Proveedor</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Recetas</th>
                        <th scope="col" class="insumos-th-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var insumo in insumos)
                    {
                        <tr class="insumos-fila @(insumo.Activo ? "" : "insumos-fila-inactiva")">
                            <td>
                                @if (EsEditando(insumo.Id, "nombre"))
                                {
                                    <input @ref="entradaRapida" aria-label="Editar nombre de @insumo.Nombre" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-nombre")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "nombre")'><span class="visually-hidden">Editar nombre de @insumo.Nombre: </span><strong>@insumo.Nombre</strong></button>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "unidad"))
                                {
                                    <select @ref="entradaRapida" aria-label="Editar unidad de medida de @insumo.Nombre" class="form-select form-select-sm input-edicion-rapida" value="@edicionRapidaValor" @onchange="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida">
                                        @foreach (var unidad in ConversorUnidades.Unidades)
                                        {
                                            <option value="@unidad">@unidad</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-unidad")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "unidad")'><span class="visually-hidden">Editar unidad de medida de @insumo.Nombre: </span>@insumo.UnidadMedida</button>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "categoria"))
                                {
                                    <select @ref="entradaRapida" aria-label="Editar categoría de @insumo.Nombre" class="form-select form-select-sm input-edicion-rapida" value="@edicionRapidaValor" @onchange="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida">
                                        <option value="materia_prima">Materia prima</option>
                                        <option value="empaque">Empaque</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-categoria")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "categoria")'><span class="visually-hidden">Editar categoría de @insumo.Nombre: </span>@CategoriaMostrar(insumo.Categoria)</button>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "costo"))
                                {
                                    <input @ref="entradaRapida" aria-label="Editar costo de @insumo.Nombre" type="number" step="1" min="0" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-costo")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "costo")'><span class="visually-hidden">Editar costo de @insumo.Nombre: </span>$@insumo.CostoUnitario.ToString("N2")</button>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "cantidad"))
                                {
                                    <input @ref="entradaRapida" aria-label="Editar cantidad de @insumo.Nombre" type="number" step="1" min="0" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-cantidad")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "cantidad")'><span class="visually-hidden">Editar cantidad de @insumo.Nombre: </span>@(insumo.Cantidad.HasValue ? insumo.Cantidad.Value.ToString("0.##") : "—")</button>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "proveedor"))
                                {
                                    <div class="proveedor-edicion-rapida" @onkeydown="TeclaProveedorRapido">
                                        <input @ref="entradaRapida" aria-label="Editar proveedor de @insumo.Nombre" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" placeholder="Escribe o elige un proveedor" />
                                        @if (cargandoProveedoresRapida)
                                        {
                                            <small class="text-muted" role="status">Cargando proveedores...</small>
                                        }
                                        else if (proveedoresEdicionRapida.Any())
                                        {
                                            <div class="proveedores-asociados-rapida">
                                                <small>Proveedores de este insumo:</small>
                                                @foreach (var p in proveedoresEdicionRapida)
                                                {
                                                    <button type="button"
                                                            class="proveedor-asociado-rapida @(NombreIgual(p.Nombre, insumo.Proveedor) ? "proveedor-asociado-actual" : "")"
                                                            @onclick="() => SeleccionarProveedorRapidoAsync(p.Nombre)">
                                                        <span>@p.Nombre</span>
                                                        <small>@Formato.Moneda(p.Costo) · @p.Cantidad.ToString("0.##") @p.UnidadMedida</small>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="proveedor-sin-asociados">Este insumo aún no tiene proveedores. Escribe uno nuevo y se creará al guardar.</small>
                                        }
                                        <div class="proveedor-acciones-rapidas">
                                            <button type="button" class="btn-mini-editar" @onclick="GuardarRapidoConFoco">Guardar proveedor</button>
                                            <button type="button" class="btn-mini-historial" @onclick="CancelarRapidoConFoco">Cancelar</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" id="@($"editar-insumo-{insumo.Id}-proveedor")" class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "proveedor")'><span class="visually-hidden">Editar proveedor de @insumo.Nombre: </span>@(string.IsNullOrWhiteSpace(insumo.Proveedor) ? "—" : insumo.Proveedor)</button>
                                }
                            </td>
                            <td>
                                <button type="button" class="insumos-badge @(insumo.Activo ? "insumos-badge-activo" : "insumos-badge-inactivo") celda-editable" @onclick="() => AlternarActivoRapido(insumo)" aria-label="@(insumo.Activo ? "Activo, desactivar" : "Inactivo, activar") @insumo.Nombre">
                                    @(insumo.Activo ? "Activo" : "Inactivo")
                                </button>
                            </td>
                            <td>@(insumo.NumeroRecetas > 0 ? insumo.NumeroRecetas.ToString() : "—")</td>
                            <td class="insumos-acciones">
                                <button type="button" class="btn-mini-editar" aria-label="Editar @insumo.Nombre" @onclick="() => AbrirModalEditar(insumo)">Editar</button>
                                <button type="button" class="btn-mini-historial" @onclick='() => Navigation.NavigateTo($"insumos/{insumo.Id}/historial")' aria-label="Historial de @insumo.Nombre">Historial</button>
                                <button type="button" class="btn-mini-eliminar" @onclick="() => PedirEliminar(insumo)" aria-label="Eliminar @insumo.Nombre">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="insumos-paginacion">
            <button type="button" class="btn-outline" disabled="@(pagina <= 1 || cargando)" @onclick="PaginaAnterior">← Anterior</button>
            <span>Página @pagina de @totalPaginas · @total insumos</span>
            <button type="button" class="btn-outline" disabled="@(pagina >= totalPaginas || cargando)" @onclick="PaginaSiguiente">Siguiente →</button>
        </div>
    }
</div>

@if (mostrarModal)
{
    <AccessibleDialog Class="socio-modal inventario-accesible" LabelledBy="insumo-form-titulo" OnCancel="CerrarModal">
        <h2 id="insumo-form-titulo" class="onboarding-subtitulo">@(esEdicion ? "Editar insumo" : "Nuevo insumo")</h2>

        <EditForm EditContext="@contextoFormulario" OnSubmit="@GuardarFormulario" novalidate>
            @if (esEdicion && camposVaciadosParaProveedorNuevo && !string.IsNullOrWhiteSpace(form.Proveedor))
            {
                <div class="text-muted" style="font-size:0.8rem; margin-bottom:12px;">Asociando nuevo proveedor '@form.Proveedor.Trim()'. Completa unidad, cantidad y costo, y guarda para asociarlo.</div>
            }
            @if (esEdicion && errores.TryGetValue(nameof(form.Proveedor), out var errProvEdit))
            {
                <div class="text-danger msg-error" style="margin-bottom:12px;">@errProvEdit</div>
            }
            <div class="form-group-sm">
                <label class="auth-label" for="insumo-nombre">Nombre *</label>
                <AyudaCampoInventario Id="ayuda-nombre-caja" Tema="Nombre">Nombre con el que identificarás el insumo en recetas e inventario. Debe ser único y de máximo 75 caracteres. Ej.: Harina de trigo.</AyudaCampoInventario>
                <InputText id="insumo-nombre" aria-describedby="ayuda-nombre-caja insumo-nombre-error" aria-required="true" autofocus @bind-Value="form.Nombre" maxlength="75" class="form-control" placeholder="Ej.: Harina" />
                <div id="insumo-nombre-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.Nombre)))</div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="insumo-unidad">Unidad de medida *</label>
                <AyudaCampoInventario Id="ayuda-unidad-caja" Tema="Unidad de medida">Unidad en la que compras y usas el insumo. Define cómo se calculan cantidades y costos en tus recetas. Ej.: kg para harina, l para leche.</AyudaCampoInventario>
                <InputSelect id="insumo-unidad" aria-describedby="ayuda-unidad-caja insumo-unidad-error" aria-required="true" @bind-Value="form.UnidadMedida" class="form-select">
                    <option value="">Selecciona...</option>
                    @foreach (var unidad in ConversorUnidades.Unidades)
                    {
                        <option value="@unidad">@unidad</option>
                    }
                </InputSelect>
                <div id="insumo-unidad-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.UnidadMedida)))</div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="insumo-densidad">Densidad (g/ml) opcional</label>
                <AyudaCampoInventario Id="ayuda-densidad-caja" Tema="Densidad (g/ml) opcional">Permite convertir entre peso y volumen en las recetas (por ejemplo, una taza de harina a gramos). Déjala vacía si no la conoces; 0 también significa sin densidad.</AyudaCampoInventario>
                <InputNumber id="insumo-densidad" aria-describedby="ayuda-densidad-caja insumo-densidad-error" @bind-Value="form.DensidadGPorMl" class="form-control" min="0" max="20" step="0.01" placeholder="Ej.: 0,53 para harina" />
                <div id="insumo-densidad-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.DensidadGPorMl)))</div>
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="insumo-cantidad">Cantidad *</label>
                <AyudaCampoInventario Id="ayuda-cantidad-caja" Tema="Cantidad">Cantidad que compraste en la unidad elegida. Ej.: 10 significa 10 kg si elegiste kg. Máximo 999.99 para taza, cucharada, cucharadita, unidad o docena; 999999.99 para el resto.</AyudaCampoInventario>
                <InputNumber id="insumo-cantidad" aria-describedby="ayuda-cantidad-caja insumo-cantidad-error" aria-required="true" @bind-Value="form.Cantidad" @oninput="OnCantidadRawInput" class="form-control" min="0" step="1" placeholder="Ej.: 10" />
                <div id="insumo-cantidad-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.Cantidad)))</div>
            </div>

            <div class="@(esEdicion ? string.Empty : "onb-grid")">
                <div class="form-group-sm">
                    <label class="auth-label" for="insumo-costo">Costo *</label>
                    <AyudaCampoInventario Id="ayuda-costo-caja" Tema="Costo">Lo que pagaste por la cantidad indicada arriba. Debe ser mayor a 0 y no superar 999999.99. Se usa como respaldo para calcular el costo de tus recetas.</AyudaCampoInventario>
                    <InputNumber id="insumo-costo" aria-describedby="ayuda-costo-caja insumo-costo-error" aria-required="true" @bind-Value="form.CostoUnitario" @oninput="OnCostoRawInput" class="form-control" min="0" step="1" placeholder="Ej.: 2500" />
                    <div id="insumo-costo-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.CostoUnitario)))</div>
                </div>

                @if (!esEdicion)
                {
                <div class="form-group-sm">
                    <label class="auth-label" for="insumo-proveedor">Proveedor *</label>
                    <AyudaCampoInventario Id="ayuda-proveedor-caja" Tema="Proveedor">Quién te vende este insumo (obligatorio). Escribe para buscar uno existente o crear uno nuevo.</AyudaCampoInventario>
                    <div>
                        <input id="insumo-proveedor" list="insumo-proveedores-sugeridos" aria-describedby="ayuda-proveedor-caja insumo-proveedor-error" aria-invalid="@(errores.ContainsKey(nameof(form.Proveedor)) ? "true" : null)" aria-required="true" class="form-control" value="@form.Proveedor" @oninput="OnProveedorOnInput"
                               @onfocus="MostrarSugerenciasProveedor" @onblur="OcultarSugerenciasProveedor"
                               placeholder="Escribe para buscar o crear"
                               disabled="@cargandoProveedores" autocomplete="off" />
                        <datalist id="insumo-proveedores-sugeridos">
                            @foreach (var sugerencia in sugerenciasActuales)
                            {
                                <option value="@sugerencia.Nombre"></option>
                            }
                        </datalist>
                    </div>
                    @* Área de estado con altura fija: los mensajes no mueven el resto del formulario. *@
                    <div style="min-height:20px;" role="status">
                        @if (cargandoProveedores)
                        {
                            <span class="text-muted" style="font-size:0.8rem;">Cargando proveedores...</span>
                        }
                        else if (errorCargaProveedores)
                        {
                            <span class="text-danger msg-error" style="font-size:0.8rem;">No se pudieron cargar los proveedores. Verifica que el backend esté corriendo.</span>
                        }
                        else if (!listaProveedores.Any() && string.IsNullOrWhiteSpace(form.Proveedor))
                        {
                            <span class="text-muted" style="font-size:0.8rem;">Aún no hay proveedores registrados. Escribe un nombre para crear el primero.</span>
                        }
                        else if (buscandoProveedores)
                        {
                            <span class="text-muted" style="font-size:0.75rem;">Actualizando desde la base de datos...</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(proveedorAutocompletado) && NombreIgual(form.Proveedor, proveedorAutocompletado))
                        {
                            <span class="text-muted" style="font-size:0.8rem;">Datos traídos de '@proveedorAutocompletado' (unidad, cantidad y costo).</span>
                        }
                        else if (ProveedorNoManejaInsumo())
                        {
                            <span class="text-muted" style="font-size:0.8rem;">'@form.Proveedor.Trim()' aún no maneja este insumo. Se vaciaron unidad, cantidad y costo: complétalos y al guardar quedará asociado.</span>
                        }
                        else if (MostrarAvisoSinCoincidencia)
                        {
                            <span class="text-muted" style="font-size:0.8rem;">Sin coincidencias para '@form.Proveedor.Trim()' — se creará como nuevo.</span>
                        }
                    </div>
                    <div id="insumo-proveedor-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.Proveedor)))</div>
                </div>
                }
            </div>

            <div class="form-group-sm">
                <label class="auth-label" for="insumo-categoria">Categoría</label>
                <AyudaCampoInventario Id="ayuda-categoria-caja" Tema="Categoría">Clasifica tu insumo para filtrarlo fácilmente: Materia prima (ingredientes), Empaque (envases, bolsas, cajas) u Otro.</AyudaCampoInventario>
                <InputSelect id="insumo-categoria" aria-describedby="ayuda-categoria-caja insumo-categoria-error" @bind-Value="form.Categoria" class="form-select">
                    <option value="Otro">Otro</option>
                    <option value="Materia prima">Materia prima</option>
                    <option value="Empaque">Empaque</option>
                </InputSelect>
                <div id="insumo-categoria-error" class="text-danger msg-error" aria-live="polite">@(errores.GetValueOrDefault(nameof(form.Categoria)))</div>
            </div>

            <label class="insumos-check insumos-check-modal">
                <InputCheckbox @bind-Value="form.Activo" aria-describedby="ayuda-activo-caja" />
                Insumo activo
            </label>
            <AyudaCampoInventario Id="ayuda-activo-caja" Tema="insumo activo">Si está activo aparece en tus listas y puedes usarlo en recetas. Desactívalo si dejaste de usarlo, sin borrar su historial.</AyudaCampoInventario>

            @if (!string.IsNullOrWhiteSpace(errorGeneralModal))
            {
                <div class="text-danger msg-error" role="alert">@errorGeneralModal</div>
            }

            <div class="confirm-acciones" style="margin-top: 16px;">
                <button type="button" class="btn-outline" @onclick="CerrarModal">Cancelar</button>
                <button type="submit" class="btn-solid" disabled="@procesando">
                    @(procesando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </EditForm>
    </AccessibleDialog>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="@($"¿Eliminar el insumo «{insumoAEliminar?.Nombre}»? Esta acción no se puede deshacer.")"
               OnConfirmar="ConfirmarEliminarInsumo"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    private List<InsumoApiDto> insumos = new();
    private int total;
    private int pagina = 1;
    private const int TamanoPagina = 20;
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(total / (double)TamanoPagina));

    private string textoBusqueda = string.Empty;
    private string unidadFiltro = string.Empty;
    private string categoriaFiltro = string.Empty;
    private string ordenarPor = "nombre";
    private string direccion = "asc";
    private bool incluirInactivos = true;

    private bool cargando = true;
    private bool procesando;
    private string? mensajeExito;
    private string? mensajeError;
    private string? mensajeReporte;
    private bool reporteConError;
    private bool generandoPdf;
    private bool generandoExcel;
    private bool menuReportesAbierto;
    private BloqueoEliminar? bloqueoEliminar;

    private bool mostrarModal;
    private bool esEdicion;
    private InsumoApiDto? insumoEditando;
    private InsumoFormModel form = new();
    private EditContext? contextoFormulario;
    private ValidationMessageStore? mensajesValidacion;
    private Dictionary<string, string> errores = new();
    private string? errorGeneralModal;

    private List<ProveedorDTO> listaProveedores = new();
    private List<InsumoProveedorDTO> proveedoresDelInsumo = new();
    private string? proveedorAutocompletado;
    private bool camposVaciadosParaProveedorNuevo;
    private bool cargandoProveedores;
    private bool errorCargaProveedores;
    private bool mostrarSugerenciasProveedor;

    private bool mostrarConfirmEliminar;
    private InsumoApiDto? insumoAEliminar;

    private int? edicionRapidaId;
    private string? edicionRapidaCampo;
    private string edicionRapidaValor = string.Empty;
    private bool guardandoRapido;
    private bool enfocarEditorRapido;
    private ElementReference entradaRapida;
    private string? enfocarElementoPendiente;
    private List<InsumoProveedorDTO> proveedoresEdicionRapida = new();
    private bool cargandoProveedoresRapida;

    private CancellationTokenSource? debounceCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        try
        {
            await CargarProveedoresAsync();
        }
        catch (Exception)
        {
            cargandoProveedores = false;
        }
    }

    private async Task CargarProveedoresAsync()
    {
        cargandoProveedores = true;
        errorCargaProveedores = false;
        try
        {
            var resultado = await InsumoService.ListarProveedoresNegocioAsync();
            if (resultado.Success && resultado.Data is not null)
            {
                listaProveedores = resultado.Data
                    .OrderBy(p => p.Nombre, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            else
            {
                errorCargaProveedores = true;
            }
        }
        catch (HttpRequestException)
        {
            errorCargaProveedores = true;
        }
        catch (Exception)
        {
            errorCargaProveedores = true;
        }
        finally
        {
            cargandoProveedores = false;
        }
    }
    
    private List<ProveedorDTO> sugerenciasActuales = new();
    private bool buscandoProveedores;
    private CancellationTokenSource? proveedorBusquedaCts;

    private bool avisoProveedorVisible;
    private CancellationTokenSource? avisoProveedorCts;

    private string? terminoExactoDb;

    private bool HayCoincidenciaProveedor()
    {
        if (sugerenciasActuales.Any()) return true;
        var texto = form.Proveedor?.Trim() ?? string.Empty;
        if (texto.Length == 0) return true;
        if (listaProveedores.Any(p => NombreIgual(p.Nombre, texto))) return true;
        return terminoExactoDb is not null && NombreIgual(terminoExactoDb, texto);
    }

    private bool MostrarAvisoSinCoincidencia =>
        !string.IsNullOrWhiteSpace(form.Proveedor)
        && !buscandoProveedores
        && !HayCoincidenciaProveedor()
        && !ProveedorNoManejaInsumo()
        && (mostrarSugerenciasProveedor || avisoProveedorVisible);

    private bool ProveedorNoManejaInsumo()
    {
        if (!esEdicion) return false;
        var texto = form.Proveedor?.Trim() ?? string.Empty;
        if (texto.Length == 0) return false;
        return !proveedoresDelInsumo.Any(p => NombreIgual(p.Nombre, texto));
    }

    private static List<ProveedorDTO> FiltrarProveedores(IEnumerable<ProveedorDTO> fuente, string termino, int tope = 6)
    {
        if (string.IsNullOrWhiteSpace(termino))
        {
            return new List<ProveedorDTO>();
        }
        var t = termino.Trim();
        var prefijos = fuente
            .Where(p => NombreEmpieza(p.Nombre, t) && !NombreIgual(p.Nombre, t))
            .Take(tope)
            .ToList();
        if (prefijos.Count < tope)
        {
            prefijos.AddRange(fuente
                .Where(p => !NombreEmpieza(p.Nombre, t)
                    && NombreContiene(p.Nombre, t)
                    && !NombreIgual(p.Nombre, t)
                    && !prefijos.Any(x => x.Id == p.Id))
                .Take(tope - prefijos.Count));
        }
        return prefijos;
    }

    private void MostrarSugerenciasProveedor()
    {
        avisoProveedorCts?.Cancel();
        avisoProveedorVisible = false;
        mostrarSugerenciasProveedor = true;
        sugerenciasActuales = FiltrarProveedores(listaProveedores, form.Proveedor);
        _ = BuscarSugerenciasEnBdAsync(form.Proveedor);
    }

    private async Task OcultarSugerenciasProveedor()
    {
        await Task.Delay(150);
        mostrarSugerenciasProveedor = false;
        if (!string.IsNullOrWhiteSpace(form.Proveedor) && !HayCoincidenciaProveedor())
        {
            avisoProveedorVisible = true;
            StateHasChanged();
            await ProgramarOcultadoAvisoAsync();
        }
    }

    private async Task ProgramarOcultadoAvisoAsync()
    {
        avisoProveedorCts?.Cancel();
        avisoProveedorCts?.Dispose();
        avisoProveedorCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(5000, avisoProveedorCts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        avisoProveedorVisible = false;
        StateHasChanged();
    }

    private void OnProveedorOnInput(ChangeEventArgs e)
    {
        form.Proveedor = e.Value?.ToString() ?? string.Empty;
        errores.Remove(nameof(form.Proveedor));
        errores.Remove(nameof(form.CostoUnitario));
        errores.Remove(nameof(form.Cantidad));
        errores.Remove(nameof(form.UnidadMedida));
        avisoProveedorCts?.Cancel();
        avisoProveedorVisible = false;
        mostrarSugerenciasProveedor = true;
        sugerenciasActuales = FiltrarProveedores(listaProveedores, form.Proveedor);
        AutocompletarDesdeProveedor();
        ActualizarValidacionFormulario();
        _ = BuscarSugerenciasEnBdAsync(form.Proveedor);
    }

    private async Task BuscarSugerenciasEnBdAsync(string? texto)
    {
        proveedorBusquedaCts?.Cancel();
        proveedorBusquedaCts?.Dispose();
        proveedorBusquedaCts = new CancellationTokenSource();
        var token = proveedorBusquedaCts.Token;

        var termino = texto?.Trim() ?? string.Empty;
        if (termino.Length == 0)
        {
            buscandoProveedores = false;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(150, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        buscandoProveedores = true;
        StateHasChanged();
        try
        {
            var resultado = await InsumoService.BuscarProveedoresAsync(termino, 8);
            if (token.IsCancellationRequested) return;
            if (!NombreIgual(form.Proveedor, termino)) return;
            if (resultado.Success && resultado.Data is not null)
            {
                terminoExactoDb = resultado.Data.Any(p => NombreIgual(p.Nombre, termino))
                    ? termino
                    : null;
                sugerenciasActuales = FiltrarProveedores(resultado.Data, termino, 8);
                if (HayCoincidenciaProveedor())
                {
                    avisoProveedorCts?.Cancel();
                    avisoProveedorVisible = false;
                }
            }
        }
        catch (Exception)
        {
        }
        finally
        {
            buscandoProveedores = false;
            StateHasChanged();
        }
    }

    private void VaciarCamposParaNuevoProveedor()
    {
        form.UnidadMedida = string.Empty;
        form.CostoUnitario = null;
        form.Cantidad = null;
        proveedorAutocompletado = null;
        camposVaciadosParaProveedorNuevo = true;
        errores.Remove(nameof(form.CostoUnitario));
        errores.Remove(nameof(form.Cantidad));
        errores.Remove(nameof(form.UnidadMedida));
        ActualizarValidacionFormulario();
    }

    private void AutocompletarDesdeProveedor()
    {
        if (!esEdicion) return;
        var nombre = form.Proveedor?.Trim() ?? string.Empty;
        if (nombre.Length == 0)
        {
            proveedorAutocompletado = null;
            camposVaciadosParaProveedorNuevo = false;
            return;
        }
        var asociado = proveedoresDelInsumo.FirstOrDefault(p => NombreIgual(p.Nombre, nombre));
        if (asociado is not null)
        {
            camposVaciadosParaProveedorNuevo = false;
            if (string.Equals(proveedorAutocompletado, asociado.Nombre, StringComparison.OrdinalIgnoreCase)) return;
            form.CostoUnitario = asociado.Costo;
            form.Cantidad = asociado.Cantidad;
            if (ConversorUnidades.EsValida(asociado.UnidadMedida)) form.UnidadMedida = asociado.UnidadMedida.Trim().ToLowerInvariant();
            proveedorAutocompletado = asociado.Nombre;
            errores.Remove(nameof(form.CostoUnitario));
            errores.Remove(nameof(form.Cantidad));
            errores.Remove(nameof(form.UnidadMedida));
            return;
        }
        // Proveedor que aún no maneja este insumo (existente o nuevo):
        // se vacían unidad, costo y cantidad una sola vez para no
        // borrar lo que el usuario ya digite para ese proveedor.
        if (camposVaciadosParaProveedorNuevo) return;
        VaciarCamposParaNuevoProveedor();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var resultado = await InsumoService.ListarAsync(
                textoBusqueda, ordenarPor, direccion, unidadFiltro, categoriaFiltro, incluirInactivos, pagina, TamanoPagina);

            if (resultado.Success && resultado.Data is not null)
            {
                insumos = resultado.Data.Datos;
                total = resultado.Data.Total;
            }
            else
            {
                mensajeError = resultado.Message ?? "No se pudieron cargar los insumos.";
            }
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error al cargar los insumos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task DescargarListadoPdfAsync()
    {
        if (generandoPdf) return;
        generandoPdf = true;
        mensajeReporte = null;
        reporteConError = false;
        try
        {
            var listado = await ObtenerListadoCompletoAsync();
            var filas = listado.Select(insumo => new
            {
                insumo.Id,
                insumo.Nombre,
                insumo.UnidadMedida,
                Categoria = CategoriaMostrar(insumo.Categoria),
                insumo.CostoUnitario,
                insumo.Cantidad,
                insumo.Proveedor,
                insumo.Activo
            }).ToList();

            await JS.InvokeVoidAsync("reportesInsumos.descargarPdf", filas);
            mensajeReporte = $"Se descargó el PDF con {filas.Count} insumo(s).";
        }
        catch (HttpRequestException)
        {
            reporteConError = true;
            mensajeReporte = "No fue posible conectar con el servidor para generar el listado.";
        }
        catch (InvalidOperationException ex)
        {
            reporteConError = true;
            mensajeReporte = ex.Message;
        }
        catch (Exception)
        {
            reporteConError = true;
            mensajeReporte = "No se pudo generar el PDF del inventario.";
        }
        finally
        {
            generandoPdf = false;
        }
    }

    private void AlternarMenuReportes()
    {
        menuReportesAbierto = !menuReportesAbierto;
    }

    private void CerrarMenuReportes()
    {
        menuReportesAbierto = false;
    }

    private void ManejarTeclaBotonReportes(KeyboardEventArgs e)
    {
        if (e.Key != "ArrowDown") return;
        menuReportesAbierto = true;
        enfocarElementoPendiente = "insumos-descargar-pdf";
    }

    private void ManejarTeclaMenuReportes(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && menuReportesAbierto)
        {
            CerrarMenuReportes();
            enfocarElementoPendiente = "insumos-descargar";
        }
