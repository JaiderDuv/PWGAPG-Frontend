    private static readonly HashSet<string> CategoriasValidas = new(StringComparer.OrdinalIgnoreCase)
    {
        "materia_prima", "empaque", "otro"
    };

    private bool ValidarFormulario()
    {
        form.Proveedor = form.Proveedor?.Trim() ?? string.Empty;
        errores.Clear();

        if (string.IsNullOrWhiteSpace(form.Nombre))
        {
            errores[nameof(form.Nombre)] = "El nombre es obligatorio.";
        }
        else if (form.Nombre.Trim().Length > 150)
        {
            errores[nameof(form.Nombre)] = "El nombre no puede superar los 150 caracteres.";
        }

        if (string.IsNullOrWhiteSpace(form.UnidadMedida))
        {
            errores[nameof(form.UnidadMedida)] = "Selecciona una unidad de medida.";
        }

        if (string.IsNullOrWhiteSpace(form.Categoria) ||
            !CategoriasValidas.Contains(form.Categoria.Trim()))
        {
            errores[nameof(form.Categoria)] = "Selecciona una categoría válida.";
        }

        if (form.CostoUnitario is null)
        {
            errores[nameof(form.CostoUnitario)] = "El costo unitario es obligatorio y debe ser mayor a 0.";
        }
        else if (form.CostoUnitario.Value <= 0)
        {
            errores[nameof(form.CostoUnitario)] = "El costo debe ser mayor a 0.";
        }

        if (form.PorcentajeMerma is null)
        {
            form.PorcentajeMerma = 0;
        }
        else if (form.PorcentajeMerma.Value < 0 || form.PorcentajeMerma.Value > 100)
        {
            errores[nameof(form.PorcentajeMerma)] = "La merma debe estar entre 0 y 100 (solo números).";
        }

        if (!string.IsNullOrWhiteSpace(form.Proveedor) && form.Proveedor.Trim().Length > 150)
        {
            errores[nameof(form.Proveedor)] = "El proveedor no puede superar los 150 caracteres.";
        }

        if (esEdicion && insumoEditando is not null &&
            form.CostoUnitario.HasValue && form.CostoUnitario.Value != insumoEditando.CostoUnitario &&
            string.IsNullOrWhiteSpace(form.Proveedor))
        {
            errores[nameof(form.Proveedor)] = "Para cambiar el precio debes indicar el proveedor.";
        }

        return errores.Count == 0;
    }

    private async Task GuardarFormulario()
    {
        LimpiarMensajes();
        errorGeneralModal = null;

        if (!ValidarFormulario())
        {
            return;
        }

        procesando = true;
        try
        {
            if (esEdicion && insumoEditando is not null)
            {
                await GuardarEdicionAsync();
            }
            else
            {
                await GuardarNuevoAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorGeneralModal = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task GuardarNuevoAsync()
    {
        var request = new CrearInsumoRequest
        {
            Nombre = form.Nombre.Trim(),
            UnidadMedida = form.UnidadMedida.Trim().ToLowerInvariant(),
            Categoria = form.Categoria.Trim().ToLowerInvariant(),
            CostoUnitario = form.CostoUnitario!.Value,
            PorcentajeMerma = form.PorcentajeMerma!.Value,
            Proveedor = string.IsNullOrWhiteSpace(form.Proveedor) ? null : form.Proveedor.Trim(),
            Activo = form.Activo
        };

        var resultado = await InsumoService.CrearAsync(request);
        if (!resultado.Success || resultado.Data is null)
        {
            errorGeneralModal = resultado.Message ?? "No se pudo crear el insumo.";
            return;
        }

        var creado = resultado.Data;
        total++;
        if (pagina == 1 && CoincideConFiltros(creado))
        {
            insumos.Add(creado);
            OrdenarLocal();
            if (insumos.Count > TamanoPagina)
            {
                insumos.RemoveAt(insumos.Count - 1);
            }
        }

        CerrarModal();
        mensajeExito = $"El insumo «{creado.Nombre}» fue guardado correctamente.";
    }

    private async Task GuardarEdicionAsync()
    {
        var original = insumoEditando!;
        var request = new ActualizarInsumoRequest();

        if (!string.Equals(form.Nombre.Trim(), original.Nombre, StringComparison.Ordinal))
        {
            request.Nombre = form.Nombre.Trim();
        }
        if (!string.Equals(form.UnidadMedida.Trim(), original.UnidadMedida, StringComparison.OrdinalIgnoreCase))
        {
            request.UnidadMedida = form.UnidadMedida.Trim().ToLowerInvariant();
        }

        var categoriaForm = form.Categoria.Trim().ToLowerInvariant();
        var categoriaOriginal = string.IsNullOrWhiteSpace(original.Categoria) ? "otro" : original.Categoria.Trim().ToLowerInvariant();
        if (!string.Equals(categoriaForm, categoriaOriginal, StringComparison.Ordinal))
        {
            request.Categoria = categoriaForm;
        }
        if (form.CostoUnitario!.Value != original.CostoUnitario)
        {
            request.CostoUnitario = form.CostoUnitario.Value;
            request.Proveedor = form.Proveedor.Trim();
        }
        else if ((form.Proveedor ?? string.Empty).Trim() != (original.Proveedor ?? string.Empty))
        {
            request.Proveedor = string.IsNullOrWhiteSpace(form.Proveedor) ? string.Empty : form.Proveedor.Trim();
        }
        if (form.PorcentajeMerma!.Value != original.PorcentajeMerma)
        {
            request.PorcentajeMerma = form.PorcentajeMerma.Value;
        }
        if (form.Activo != original.Activo)
        {
            request.Activo = form.Activo;
        }

        if (request.Nombre is null && request.UnidadMedida is null && request.Categoria is null &&
            request.CostoUnitario is null && request.PorcentajeMerma is null &&
            request.Proveedor is null && request.Activo is null)
        {
            CerrarModal();
            mensajeExito = "No había cambios para guardar.";
            return;
        }

        var resultado = await InsumoService.ActualizarParcialAsync(original.Id, request);
        if (!resultado.Success || resultado.Data is null)
        {
            errorGeneralModal = resultado.Message ?? "No se pudo actualizar el insumo.";
            return;
        }

        var actualizado = resultado.Data;
        var index = insumos.FindIndex(i => i.Id == actualizado.Id);
        if (index >= 0)
        {
            if (!actualizado.Activo && !incluirInactivos)
            {
                insumos.RemoveAt(index);
                total--;
            }
            else
            {
                insumos[index] = actualizado;
            }
        }

        CerrarModal();
        mensajeExito = $"El insumo «{actualizado.Nombre}» fue actualizado correctamente.";
    }

    private void PedirEliminar(InsumoApiDto insumo)
    {
        LimpiarMensajes();
        insumoAEliminar = insumo;
        mostrarConfirmEliminar = true;
    }

    private async Task ConfirmarEliminarInsumo()
    {
        mostrarConfirmEliminar = false;
        if (insumoAEliminar is null)
        {
            return;
        }

        LimpiarMensajes();
        procesando = true;
        try
        {
            var resultado = await InsumoService.EliminarAsync(insumoAEliminar.Id);
            if (resultado.Success)
            {
                insumos.RemoveAll(i => i.Id == insumoAEliminar.Id);
                total--;
                mensajeExito = $"El insumo «{insumoAEliminar.Nombre}» fue eliminado correctamente.";
                insumoAEliminar = null;
            }
            else if (resultado.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                bloqueoEliminar = new BloqueoEliminar(
                    insumoAEliminar,
                    resultado.Message ?? "El insumo está en uso y no se puede eliminar.",
                    resultado.NumeroRecetas);
            }
            else if (resultado.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                insumos.RemoveAll(i => i.Id == insumoAEliminar.Id);
                mensajeError = "Ese insumo ya no existe. Se actualizó la lista.";
            }
            else
            {
                mensajeError = resultado.Message ?? "No se pudo eliminar el insumo.";
            }
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private void CerrarBloqueo()
    {
        bloqueoEliminar = null;
        insumoAEliminar = null;
    }

    private async Task DesactivarEnUso()
    {
        if (bloqueoEliminar is null)
        {
            return;
        }

        LimpiarMensajes();
        procesando = true;
        try
        {
            var objetivo = bloqueoEliminar.Insumo;
            var resultado = await InsumoService.ActualizarParcialAsync(
                objetivo.Id, new ActualizarInsumoRequest { Activo = false });

            if (!resultado.Success || resultado.Data is null)
            {
                mensajeError = resultado.Message ?? "No se pudo desactivar el insumo.";
                return;
            }

            var index = insumos.FindIndex(i => i.Id == objetivo.Id);
            if (index >= 0)
            {
                if (incluirInactivos)
                {
                    insumos[index] = resultado.Data;
                }
                else
                {
                    insumos.RemoveAt(index);
                    total--;
                }
            }

            mensajeExito = $"El insumo «{objetivo.Nombre}» se desactivó (sigue asociado a {bloqueoEliminar.NumeroRecetas} receta(s), por eso no se eliminó).";
            bloqueoEliminar = null;
            insumoAEliminar = null;
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private bool CoincideConFiltros(InsumoApiDto insumo)
    {
        if (!string.IsNullOrWhiteSpace(unidadFiltro) &&
            !string.Equals(insumo.UnidadMedida, unidadFiltro, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(categoriaFiltro) &&
            !string.Equals(insumo.Categoria ?? "otro", categoriaFiltro.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!incluirInactivos && !insumo.Activo)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var termino = textoBusqueda.Trim();
            if (!insumo.Nombre.Contains(termino, StringComparison.OrdinalIgnoreCase) &&
                !(insumo.Proveedor?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false))
            {
                return false;
            }
        }

        return true;
    }

    private void OrdenarLocal()
    {
        Comparison<InsumoApiDto> comparacion = ordenarPor switch
        {
            "costo" => (a, b) => a.CostoUnitario.CompareTo(b.CostoUnitario),
            "merma" => (a, b) => a.PorcentajeMerma.CompareTo(b.PorcentajeMerma),
            _ => (a, b) => string.Compare(a.Nombre, b.Nombre, StringComparison.OrdinalIgnoreCase)
        };

        insumos.Sort(comparacion);
        if (direccion == "desc")
        {
            insumos.Reverse();
        }
    }

    private void LimpiarMensajes()
    {
        mensajeExito = null;
        mensajeError = null;
        bloqueoEliminar = null;
    }

