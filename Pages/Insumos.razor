@page "/insumos"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@inject PWGAPG_Frontend.Services.InsumoService InsumoService
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<PageTitle>Mis insumos | Chef Metrics</PageTitle>

<div class="insumos-shell">
    <div class="insumos-heading">
        <div>
            <span class="perfil-kicker">INVENTARIO</span>
            <h1>Insumos</h1>
        </div>
        <div class="insumos-heading-acciones">
            <button type="button" class="btn-outline" @onclick='() => Navigation.NavigateTo("insumos/historial")'>Historial de precios</button>
            <button type="button" class="btn-solid" @onclick="AbrirModalNuevo">+ Nuevo insumo</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="perfil-alerta perfil-alerta-exito" role="status">@mensajeExito</div>
    }
    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">@mensajeError</div>
    }
    @if (bloqueoEliminar is not null)
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">
            @bloqueoEliminar.Mensaje
            <div class="insumos-bloqueo-acciones">
                <button type="button" class="btn-outline" @onclick="CerrarBloqueo">Mantener activo</button>
                <button type="button" class="btn-solid" @onclick="DesactivarEnUso" disabled="@procesando">
                    @(procesando ? "Desactivando..." : "Desactivarlo en su lugar")
                </button>
            </div>
        </div>
    }

    <section class="insumos-toolbar">
        <input class="form-control insumos-buscador"
               placeholder="Buscar por nombre o proveedor..."
               value="@textoBusqueda"
               @oninput="OnBusquedaInput" />

        <select class="form-select" value="@unidadFiltro" @onchange="OnUnidadFiltroChanged" title="Filtrar por unidad">
            <option value="">Todas las unidades</option>
            @foreach (var unidad in ConversorUnidades.Unidades)
            {
                <option value="@unidad">@unidad</option>
            }
        </select>

        <select class="form-select" value="@categoriaFiltro" @onchange="OnCategoriaFiltroChanged" title="Filtrar por categoría">
            <option value="">Todas las categorías</option>
            <option value="materia_prima">Materia prima</option>
            <option value="empaque">Empaque</option>
            <option value="otro">Otro</option>
        </select>

        <select class="form-select" value="@ordenarPor" @onchange="OnOrdenChanged" title="Ordenar por">
            <option value="nombre">Nombre</option>
            <option value="costo">Costo</option>
            <option value="cantidad">Cantidad</option>
        </select>

        <select class="form-select" value="@direccion" @onchange="OnDireccionChanged" title="Dirección">
            <option value="asc">Ascendente</option>
            <option value="desc">Descendente</option>
        </select>

        <label class="insumos-check">
            <input type="checkbox" checked="@incluirInactivos" @onchange="OnIncluirInactivosChanged" />
            Incluir inactivos
        </label>
    </section>

    @if (cargando)
    {
        <section class="perfil-cargando-card" aria-live="polite">
            <div class="perfil-spinner" aria-hidden="true"></div>
            <h2>Cargando insumos</h2>
            <p>Estamos consultando tu inventario.</p>
        </section>
    }
    else if (!insumos.Any())
    {
        <p class="text-muted">No hay insumos para mostrar. Usa «Nuevo insumo» para registrar el primero.</p>
    }
    else
    {
        <div class="insumos-tabla-wrap">
            <table class="insumos-tabla">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Unidad</th>
                        <th>Categoría</th>
                        <th>Costo</th>
                        <th>Cantidad</th>
                        <th>Proveedor</th>
                        <th>Estado</th>
                        <th>Recetas</th>
                        <th class="insumos-th-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var insumo in insumos)
                    {
                        <tr class="insumos-fila @(insumo.Activo ? "" : "insumos-fila-inactiva")">
                            <td>
                                @if (EsEditando(insumo.Id, "nombre"))
                                {
                                    <input class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "nombre")' title="Clic para editar"><strong>@insumo.Nombre</strong></span>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "unidad"))
                                {
                                    <select class="form-select form-select-sm input-edicion-rapida" value="@edicionRapidaValor" @onchange="e => CambiarEdicionRapida(e.Value?.ToString() ?? string.Empty)" @onblur="GuardarEdicionRapida">
                                        @foreach (var unidad in ConversorUnidades.Unidades)
                                        {
                                            <option value="@unidad">@unidad</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "unidad")' title="Clic para editar">@insumo.UnidadMedida</span>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "categoria"))
                                {
                                    <select class="form-select form-select-sm input-edicion-rapida" value="@edicionRapidaValor" @onchange="e => CambiarEdicionRapida(e.Value?.ToString() ?? string.Empty)" @onblur="GuardarEdicionRapida">
                                        <option value="materia_prima">Materia prima</option>
                                        <option value="empaque">Empaque</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "categoria")' title="Clic para editar">@CategoriaMostrar(insumo.Categoria)</span>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "costo"))
                                {
                                    <input type="number" step="1" min="0" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "costo")' title="Clic para editar">$@insumo.CostoUnitario.ToString("N2")</span>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "cantidad"))
                                {
                                    <input type="number" step="1" min="0" class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" />
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "cantidad")' title="Clic para editar">@(insumo.Cantidad.HasValue ? insumo.Cantidad.Value.ToString("0.##") : "—")</span>
                                }
                            </td>
                            <td>
                                @if (EsEditando(insumo.Id, "proveedor"))
                                {
                                    <div class="proveedor-edicion-rapida">
                                        <input class="form-control form-control-sm input-edicion-rapida" value="@edicionRapidaValor" @oninput="e => edicionRapidaValor = e.Value?.ToString() ?? string.Empty" @onkeydown="TeclaEdicionRapida" @onblur="GuardarEdicionRapida" placeholder="Escribe o elige un proveedor" />
                                        @if (cargandoProveedoresRapida)
                                        {
                                            <small class="text-muted">Cargando proveedores...</small>
                                        }
                                        else if (proveedoresEdicionRapida.Any())
                                        {
                                            <div class="proveedores-asociados-rapida">
                                                <small>Proveedores de este insumo:</small>
                                                @foreach (var p in proveedoresEdicionRapida)
                                                {
                                                    <button type="button"
                                                            class="proveedor-asociado-rapida @(NombreIgual(p.Nombre, insumo.Proveedor) ? "proveedor-asociado-actual" : "")"
                                                            @onmousedown:preventDefault
                                                            @onclick="() => SeleccionarProveedorRapidoAsync(p.Nombre)">
                                                        <span>@p.Nombre</span>
                                                        <small>@Formato.Moneda(p.Costo) · @p.Cantidad.ToString("0.##") @p.UnidadMedida</small>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="proveedor-sin-asociados">Este insumo aún no tiene proveedores. Escribe uno nuevo y se creará al guardar.</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="celda-editable" @onclick='() => IniciarEdicionRapida(insumo, "proveedor")' title="Clic para editar">@(string.IsNullOrWhiteSpace(insumo.Proveedor) ? "—" : insumo.Proveedor)</span>
                                }
                            </td>
                            <td>
                                <span class="insumos-badge @(insumo.Activo ? "insumos-badge-activo" : "insumos-badge-inactivo") celda-editable" @onclick="() => AlternarActivoRapido(insumo)" title="Clic para activar/desactivar">
                                    @(insumo.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>@(insumo.NumeroRecetas > 0 ? insumo.NumeroRecetas.ToString() : "—")</td>
                            <td class="insumos-acciones">
                                <button type="button" class="btn-mini-editar" @onclick="() => AbrirModalEditar(insumo)">Editar</button>
                                <button type="button" class="btn-mini-historial" @onclick='() => Navigation.NavigateTo($"insumos/{insumo.Id}/historial")' title="Ver historial de precios">Historial</button>
                                <button type="button" class="btn-mini-eliminar" @onclick="() => PedirEliminar(insumo)" aria-label="Eliminar @insumo.Nombre">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="insumos-paginacion">
            <button type="button" class="btn-outline" disabled="@(pagina <= 1 || cargando)" @onclick="PaginaAnterior">← Anterior</button>
            <span>Página @pagina de @totalPaginas · @total insumos</span>
            <button type="button" class="btn-outline" disabled="@(pagina >= totalPaginas || cargando)" @onclick="PaginaSiguiente">Siguiente →</button>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">@(esEdicion ? "Editar insumo" : "Nuevo insumo")</h3>

            <EditForm Model="@form" OnSubmit="@GuardarFormulario" novalidate>
                @if (esEdicion && camposVaciadosParaProveedorNuevo && !string.IsNullOrWhiteSpace(form.Proveedor))
                {
                    <div class="text-muted" style="font-size:0.8rem; margin-bottom:12px;">Asociando nuevo proveedor '@form.Proveedor.Trim()'. Completa unidad, cantidad y costo, y guarda para asociarlo.</div>
                }
                @if (esEdicion && errores.TryGetValue(nameof(form.Proveedor), out var errProvEdit))
                {
                    <div class="text-danger msg-error" style="margin-bottom:12px;">@errProvEdit</div>
                }
                <div class="form-group-sm">
                    <label class="auth-label">Nombre * <span class="campo-ayuda-wrap"><span id="ayuda-nombre-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("nombre")' @onmouseenter='() => AlEntrarAyuda("nombre")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                    <span id="ayuda-nombre-caja" class="campo-ayuda-caja" style='@EstiloAyuda("nombre")' @onmouseenter='() => AlEntrarAyuda("nombre")' @onmouseleave="AlSalirAyuda">Nombre con el que identificarás el insumo en recetas e inventario. Debe ser único y de máximo 75 caracteres. Ej.: Harina de trigo.</span>
                    <InputText @bind-Value="form.Nombre" maxlength="75" class="form-control" placeholder="Ej.: Harina" />
                    @if (errores.TryGetValue(nameof(form.Nombre), out var errNombre))
                    {
                        <span class="text-danger msg-error">@errNombre</span>
                    }
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Unidad de medida * <span class="campo-ayuda-wrap"><span id="ayuda-unidad-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("unidad")' @onmouseenter='() => AlEntrarAyuda("unidad")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                    <span id="ayuda-unidad-caja" class="campo-ayuda-caja" style='@EstiloAyuda("unidad")' @onmouseenter='() => AlEntrarAyuda("unidad")' @onmouseleave="AlSalirAyuda">Unidad en la que compras y usas el insumo. Define cómo se calculan cantidades y costos en tus recetas. Ej.: kg para harina, l para leche.</span>
                    <InputSelect @bind-Value="form.UnidadMedida" class="form-select">
                        <option value="">Selecciona...</option>
                        @foreach (var unidad in ConversorUnidades.Unidades)
                        {
                            <option value="@unidad">@unidad</option>
                        }
                    </InputSelect>
                    @if (errores.TryGetValue(nameof(form.UnidadMedida), out var errUnidad))
                    {
                        <span class="text-danger msg-error">@errUnidad</span>
                    }
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Densidad (g/ml) opcional <span class="campo-ayuda-wrap"><span id="ayuda-densidad-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("densidad")' @onmouseenter='() => AlEntrarAyuda("densidad")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                    <span id="ayuda-densidad-caja" class="campo-ayuda-caja" style='@EstiloAyuda("densidad")' @onmouseenter='() => AlEntrarAyuda("densidad")' @onmouseleave="AlSalirAyuda">Permite convertir entre peso y volumen en las recetas (por ejemplo, una taza de harina a gramos). Déjala vacía si no la conoces; 0 también significa sin densidad.</span>
                    <InputNumber @bind-Value="form.DensidadGPorMl" class="form-control" min="0" max="20" step="0.01" placeholder="Ej.: 0,53 para harina" />
                    @if (errores.TryGetValue(nameof(form.DensidadGPorMl), out var errDensidad))
                    {
                        <span class="text-danger msg-error">@errDensidad</span>
                    }
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Cantidad * <span class="campo-ayuda-wrap"><span id="ayuda-cantidad-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("cantidad")' @onmouseenter='() => AlEntrarAyuda("cantidad")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                    <span id="ayuda-cantidad-caja" class="campo-ayuda-caja" style='@EstiloAyuda("cantidad")' @onmouseenter='() => AlEntrarAyuda("cantidad")' @onmouseleave="AlSalirAyuda">Cantidad que compraste en la unidad elegida. Ej.: 10 significa 10 kg si elegiste kg. Máximo 999.99 para taza, cucharada, cucharadita, unidad o docena; 999999.99 para el resto.</span>
                        <InputNumber @bind-Value="form.Cantidad" @oninput="OnCantidadRawInput" class="form-control" min="0" step="1" placeholder="Ej.: 10" />
                    @if (errores.TryGetValue(nameof(form.Cantidad), out var errCantidad))
                    {
                        <span class="text-danger msg-error">@errCantidad</span>
                    }
                </div>

                <div class="@(esEdicion ? string.Empty : "onb-grid")">
                    <div class="form-group-sm">
                        <label class="auth-label">Costo * <span class="campo-ayuda-wrap"><span id="ayuda-costo-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("costo")' @onmouseenter='() => AlEntrarAyuda("costo")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                        <span id="ayuda-costo-caja" class="campo-ayuda-caja" style='@EstiloAyuda("costo")' @onmouseenter='() => AlEntrarAyuda("costo")' @onmouseleave="AlSalirAyuda">Lo que pagaste por la cantidad indicada arriba. Debe ser mayor a 0 y no superar 999999.99. Se usa como respaldo para calcular el costo de tus recetas.</span>
                        <InputNumber @bind-Value="form.CostoUnitario" @oninput="OnCostoRawInput" class="form-control" min="0" step="1" placeholder="Ej.: 2500" />
                        @if (errores.TryGetValue(nameof(form.CostoUnitario), out var errCosto))
                        {
                            <span class="text-danger msg-error">@errCosto</span>
                        }
                    </div>

                    @if (!esEdicion)
                    {
                    <div class="form-group-sm">
                        <label class="auth-label">Proveedor * <span class="campo-ayuda-wrap"><span id="ayuda-proveedor-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("proveedor")' @onmouseenter='() => AlEntrarAyuda("proveedor")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                        <span id="ayuda-proveedor-caja" class="campo-ayuda-caja" style='@EstiloAyuda("proveedor")' @onmouseenter='() => AlEntrarAyuda("proveedor")' @onmouseleave="AlSalirAyuda">Quién te vende este insumo (obligatorio). Escribe para buscar uno existente o crear uno nuevo.</span>
                        <div class="proveedor-drop-wrap">
                            <input class="form-control" value="@form.Proveedor" @oninput="OnProveedorOnInput"
                                   @onfocus="MostrarSugerenciasProveedor" @onblur="OcultarSugerenciasProveedor"
                                   placeholder="Escribe para buscar o crear"
                                   disabled="@cargandoProveedores" autocomplete="off" />
                            @if (mostrarSugerenciasProveedor && sugerenciasActuales.Any())
                            {
                                <div class="proveedor-drop-lista">
                                    @foreach (var sug in sugerenciasActuales)
                                    {
                                        <button type="button" class="proveedor-drop-item" @onmousedown="() => SeleccionarProveedor(sug.Nombre)">
                                            @sug.Nombre
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @* Área de estado con altura fija: los mensajes no mueven el resto del formulario. *@
                        <div style="min-height:20px;">
                            @if (cargandoProveedores)
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Cargando proveedores...</span>
                            }
                            else if (errorCargaProveedores)
                            {
                                <span class="text-danger msg-error" style="font-size:0.8rem;">No se pudieron cargar los proveedores. Verifica que el backend esté corriendo.</span>
                            }
                            else if (!listaProveedores.Any() && string.IsNullOrWhiteSpace(form.Proveedor))
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Aún no hay proveedores registrados. Escribe un nombre para crear el primero.</span>
                            }
                            else if (buscandoProveedores)
                            {
                                <span class="text-muted" style="font-size:0.75rem;">Actualizando desde la base de datos...</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(proveedorAutocompletado) && NombreIgual(form.Proveedor, proveedorAutocompletado))
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Datos traídos de '@proveedorAutocompletado' (unidad, cantidad y costo).</span>
                            }
                            else if (ProveedorNoManejaInsumo())
                            {
                                <span class="text-muted" style="font-size:0.8rem;">'@form.Proveedor.Trim()' aún no maneja este insumo. Se vaciaron unidad, cantidad y costo: complétalos y al guardar quedará asociado.</span>
                            }
                            else if (MostrarAvisoSinCoincidencia)
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Sin coincidencias para '@form.Proveedor.Trim()' — se creará como nuevo.</span>
                            }
                        </div>
                        @if (errores.TryGetValue(nameof(form.Proveedor), out var errProv))
                        {
                            <span class="text-danger msg-error">@errProv</span>
                        }
                    </div>
                    }
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Categoría <span class="campo-ayuda-wrap"><span id="ayuda-categoria-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("categoria")' @onmouseenter='() => AlEntrarAyuda("categoria")' @onmouseleave="AlSalirAyuda">?</span></span></label>
                    <span id="ayuda-categoria-caja" class="campo-ayuda-caja" style='@EstiloAyuda("categoria")' @onmouseenter='() => AlEntrarAyuda("categoria")' @onmouseleave="AlSalirAyuda">Clasifica tu insumo para filtrarlo fácilmente: Materia prima (ingredientes), Empaque (envases, bolsas, cajas) u Otro.</span>
                    <InputSelect @bind-Value="form.Categoria" class="form-select">
                        <option value="Otro">Otro</option>
                        <option value="Materia prima">Materia prima</option>
                        <option value="Empaque">Empaque</option>
                    </InputSelect>
                    @if (errores.TryGetValue(nameof(form.Categoria), out var errCategoria))
                    {
                        <span class="text-danger msg-error">@errCategoria</span>
                    }
                </div>

                <label class="insumos-check insumos-check-modal">
                    <InputCheckbox @bind-Value="form.Activo" />
                    Insumo activo <span class="campo-ayuda-wrap"><span id="ayuda-activo-ancla" class="campo-ayuda" @onclick='() => AlClicAyuda("activo")' @onmouseenter='() => AlEntrarAyuda("activo")' @onmouseleave="AlSalirAyuda">?</span></span>
                </label>
                <span id="ayuda-activo-caja" class="campo-ayuda-caja" style='@EstiloAyuda("activo")' @onmouseenter='() => AlEntrarAyuda("activo")' @onmouseleave="AlSalirAyuda">Si está activo aparece en tus listas y puedes usarlo en recetas. Desactívalo si dejaste de usarlo, sin borrar su historial.</span>

                @if (!string.IsNullOrWhiteSpace(errorGeneralModal))
                {
                    <div class="text-danger msg-error">@errorGeneralModal</div>
                }

                <div class="confirm-acciones" style="margin-top: 16px;">
                    <button type="button" class="btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn-solid" disabled="@procesando">
                        @(procesando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="@($"¿Eliminar el insumo «{insumoAEliminar?.Nombre}»? Esta acción no se puede deshacer.")"
               OnConfirmar="ConfirmarEliminarInsumo"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    private List<InsumoApiDto> insumos = new();
    private int total;
    private int pagina = 1;
    private const int TamanoPagina = 20;
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(total / (double)TamanoPagina));

