@page "/insumos"
@attribute [Authorize]
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Components
@inject PWGAPG_Frontend.Services.InsumoService InsumoService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Mis insumos | Chef Metrics</PageTitle>

<div class="insumos-shell">
    <div class="insumos-heading">
        <div>
            <span class="perfil-kicker">INVENTARIO</span>
            <h1>Insumos</h1>
        </div>
        <div class="insumos-heading-acciones">
            <button type="button" class="btn-outline" @onclick='() => Navigation.NavigateTo("insumos/historial")'>Historial de precios</button>
            <button type="button" class="btn-solid" @onclick="AbrirModalNuevo">+ Nuevo insumo</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="perfil-alerta perfil-alerta-exito" role="status">@mensajeExito</div>
    }
    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">@mensajeError</div>
    }
    @if (bloqueoEliminar is not null)
    {
        <div class="perfil-alerta perfil-alerta-error" role="alert">
            @bloqueoEliminar.Mensaje
            <div class="insumos-bloqueo-acciones">
                <button type="button" class="btn-outline" @onclick="CerrarBloqueo">Mantener activo</button>
                <button type="button" class="btn-solid" @onclick="DesactivarEnUso" disabled="@procesando">
                    @(procesando ? "Desactivando..." : "Desactivarlo en su lugar")
                </button>
            </div>
        </div>
    }

    <section class="insumos-toolbar">
        <input class="form-control insumos-buscador"
               placeholder="Buscar por nombre o proveedor..."
               value="@textoBusqueda"
               @oninput="OnBusquedaInput" />

        <select class="form-select" value="@unidadFiltro" @onchange="OnUnidadFiltroChanged" title="Filtrar por unidad">
            <option value="">Todas las unidades</option>
            <option value="g">g</option>
            <option value="kg">kg</option>
            <option value="l">l</option>
            <option value="ml">ml</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="unidad">unidad</option>
            <option value="taza">taza</option>
        </select>

        <select class="form-select" value="@categoriaFiltro" @onchange="OnCategoriaFiltroChanged" title="Filtrar por categoría">
            <option value="">Todas las categorías</option>
            <option value="materia_prima">materia_prima</option>
            <option value="empaque">empaque</option>
            <option value="otro">otro</option>
        </select>

        <select class="form-select" value="@ordenarPor" @onchange="OnOrdenChanged" title="Ordenar por">
            <option value="nombre">Nombre</option>
            <option value="costo">Costo</option>
            <option value="merma">% Merma</option>
        </select>

        <select class="form-select" value="@direccion" @onchange="OnDireccionChanged" title="Dirección">
            <option value="asc">Ascendente</option>
            <option value="desc">Descendente</option>
        </select>

        <label class="insumos-check">
            <input type="checkbox" checked="@incluirInactivos" @onchange="OnIncluirInactivosChanged" />
            Incluir inactivos
        </label>
    </section>

    @if (cargando)
    {
        <section class="perfil-cargando-card" aria-live="polite">
            <div class="perfil-spinner" aria-hidden="true"></div>
            <h2>Cargando insumos</h2>
            <p>Estamos consultando tu inventario.</p>
        </section>
    }
    else if (!insumos.Any())
    {
        <p class="text-muted">No hay insumos para mostrar. Usa «Nuevo insumo» para registrar el primero.</p>
    }
    else
    {
        <div class="insumos-tabla-wrap">
            <table class="insumos-tabla">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Unidad</th>
                        <th>Categoría</th>
                        <th>Costo</th>
                        <th>% Merma</th>
                        <th>Proveedor</th>
                        <th>Estado</th>
                        <th>Recetas</th>
                        <th class="insumos-th-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var insumo in insumos)
                    {
                        <tr class="insumos-fila @(insumo.Activo ? "" : "insumos-fila-inactiva")"
                            @onclick="() => AbrirModalEditar(insumo)"
                            title="Clic para editar">
                            <td><strong>@insumo.Nombre</strong></td>
                            <td>@insumo.UnidadMedida</td>
                            <td>@(string.IsNullOrWhiteSpace(insumo.Categoria) ? "—" : insumo.Categoria)</td>
                            <td>$@insumo.CostoUnitario.ToString("N2")</td>
                            <td>@insumo.PorcentajeMerma.ToString("N2")%</td>
                            <td>@(string.IsNullOrWhiteSpace(insumo.Proveedor) ? "—" : insumo.Proveedor)</td>
                            <td>
                                <span class="insumos-badge @(insumo.Activo ? "insumos-badge-activo" : "insumos-badge-inactivo")">
                                    @(insumo.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>@(insumo.NumeroRecetas > 0 ? insumo.NumeroRecetas.ToString() : "—")</td>
                            <td class="insumos-acciones" @onclick:stopPropagation="true">
                                <button type="button" class="btn-mini-editar" @onclick="() => AbrirModalEditar(insumo)">Editar</button>
                                <button type="button" class="btn-mini-historial" @onclick='() => Navigation.NavigateTo($"insumos/{insumo.Id}/historial")' title="Ver historial de precios">Historial</button>
                                <button type="button" class="btn-mini-eliminar" @onclick="() => PedirEliminar(insumo)" aria-label="Eliminar @insumo.Nombre">🗑</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="insumos-paginacion">
            <button type="button" class="btn-outline" disabled="@(pagina <= 1 || cargando)" @onclick="PaginaAnterior">← Anterior</button>
            <span>Página @pagina de @totalPaginas · @total insumos</span>
            <button type="button" class="btn-outline" disabled="@(pagina >= totalPaginas || cargando)" @onclick="PaginaSiguiente">Siguiente →</button>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="confirm-overlay">
        <div class="socio-modal">
            <h3 class="onboarding-subtitulo">@(esEdicion ? "Editar insumo" : "Nuevo insumo")</h3>

            <EditForm Model="@form" OnSubmit="@GuardarFormulario">
                <div class="form-group-sm">
                    <label class="auth-label">Nombre *</label>
                    <InputText @bind-Value="form.Nombre" class="form-control" placeholder="Ej.: Harina" />
                    @if (errores.TryGetValue(nameof(form.Nombre), out var errNombre))
                    {
                        <span class="text-danger msg-error">@errNombre</span>
                    }
                </div>

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Unidad de medida *</label>
                        <InputSelect @bind-Value="form.UnidadMedida" class="form-select">
                            <option value="">Selecciona...</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="l">l</option>
                            <option value="ml">ml</option>
                            <option value="oz">oz</option>
                            <option value="lb">lb</option>
                            <option value="unidad">unidad</option>
                            <option value="taza">taza</option>
                        </InputSelect>
                        @if (errores.TryGetValue(nameof(form.UnidadMedida), out var errUnidad))
                        {
                            <span class="text-danger msg-error">@errUnidad</span>
                        }
                    </div>

                    <div class="form-group-sm">
                        <label class="auth-label">% Merma (0-100, vacío = 0)</label>
                        <InputNumber @bind-Value="form.PorcentajeMerma" class="form-control" min="0" max="100" step="any" placeholder="Ej.: 0" />
                        @if (errores.TryGetValue(nameof(form.PorcentajeMerma), out var errMerma))
                        {
                            <span class="text-danger msg-error">@errMerma</span>
                        }
                    </div>
                </div>

                <div class="onb-grid">
                    <div class="form-group-sm">
                        <label class="auth-label">Costo unitario (mayor a 0) *</label>
                        <InputNumber @bind-Value="form.CostoUnitario" class="form-control" min="0.01" step="any" placeholder="Ej.: 2500" />
                        @if (errores.TryGetValue(nameof(form.CostoUnitario), out var errCosto))
                        {
                            <span class="text-danger msg-error">@errCosto</span>
                        }
                    </div>

                    <div class="form-group-sm">
                        <label class="auth-label">Proveedor @(esEdicion ? "*" : "(opcional)")</label>
                        <div class="proveedor-drop-wrap">
                            <input class="form-control" value="@form.Proveedor" @oninput="OnProveedorOnInput"
                                   @onfocus="MostrarSugerenciasProveedor" @onblur="OcultarSugerenciasProveedor"
                                   placeholder="Escribe para buscar o crear (vacío = ninguno)"
                                   disabled="@cargandoProveedores" autocomplete="off" />
                            @if (mostrarSugerenciasProveedor && sugerenciasActuales.Any())
                            {
                                <div class="proveedor-drop-lista">
                                    @foreach (var sug in sugerenciasActuales)
                                    {
                                        <button type="button" class="proveedor-drop-item" @onmousedown="() => SeleccionarProveedor(sug.Nombre)">
                                            @sug.Nombre
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @* Área de estado con altura fija: los mensajes no mueven el resto del formulario. *@
                        <div style="min-height:20px;">
                            @if (cargandoProveedores)
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Cargando proveedores...</span>
                            }
                            else if (errorCargaProveedores)
                            {
                                <span class="text-danger msg-error" style="font-size:0.8rem;">No se pudieron cargar los proveedores. Verifica que el backend esté corriendo.</span>
                            }
                            else if (!listaProveedores.Any() && string.IsNullOrWhiteSpace(form.Proveedor))
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Aún no hay proveedores registrados. Escribe un nombre para crear el primero.</span>
                            }
                            else if (buscandoProveedores)
                            {
                                <span class="text-muted" style="font-size:0.75rem;">Actualizando desde la base de datos...</span>
                            }
                            else if (MostrarAvisoSinCoincidencia)
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Sin coincidencias para '@form.Proveedor.Trim()' — se creará como nuevo.</span>
                            }
                        </div>
                        @if (errores.TryGetValue(nameof(form.Proveedor), out var errProv))
                        {
                            <span class="text-danger msg-error">@errProv</span>
                        }
                    </div>
                </div>

                <div class="form-group-sm">
                    <label class="auth-label">Categoría</label>
                    <InputSelect @bind-Value="form.Categoria" class="form-select">
                        <option value="otro">otro</option>
                        <option value="materia_prima">materia_prima</option>
                        <option value="empaque">empaque</option>
                    </InputSelect>
                    @if (errores.TryGetValue(nameof(form.Categoria), out var errCategoria))
                    {
                        <span class="text-danger msg-error">@errCategoria</span>
                    }
                </div>

                <label class="insumos-check insumos-check-modal">
                    <InputCheckbox @bind-Value="form.Activo" />
                    Insumo activo
                </label>

                @if (!string.IsNullOrWhiteSpace(errorGeneralModal))
                {
                    <div class="text-danger msg-error">@errorGeneralModal</div>
                }

                <div class="confirm-acciones" style="margin-top: 16px;">
                    <button type="button" class="btn-outline" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn-solid" disabled="@procesando">
                        @(procesando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog Visible="@mostrarConfirmEliminar"
               Mensaje="@($"¿Eliminar el insumo «{insumoAEliminar?.Nombre}»? Esta acción no se puede deshacer.")"
               OnConfirmar="ConfirmarEliminarInsumo"
               OnCancelar="() => mostrarConfirmEliminar = false" />

@code {
    private List<InsumoApiDto> insumos = new();
    private int total;
    private int pagina = 1;
    private const int TamanoPagina = 20;
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(total / (double)TamanoPagina));

    private string textoBusqueda = string.Empty;
    private string unidadFiltro = string.Empty;
    private string categoriaFiltro = string.Empty;
    private string ordenarPor = "nombre";
    private string direccion = "asc";
    private bool incluirInactivos = true;

    private bool cargando = true;
    private bool procesando;
    private string? mensajeExito;
    private string? mensajeError;
    private BloqueoEliminar? bloqueoEliminar;

    private bool mostrarModal;
    private bool esEdicion;
    private InsumoApiDto? insumoEditando;
    private InsumoFormModel form = new();
    private Dictionary<string, string> errores = new();
    private string? errorGeneralModal;

    private List<ProveedorDTO> listaProveedores = new();
    private bool cargandoProveedores;
    private bool errorCargaProveedores;
    private bool mostrarSugerenciasProveedor;

    private bool mostrarConfirmEliminar;
    private InsumoApiDto? insumoAEliminar;

    private CancellationTokenSource? debounceCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        try
        {
            await CargarProveedoresAsync();
        }
        catch (Exception)
        {
            cargandoProveedores = false;
        }
    }

    private async Task CargarProveedoresAsync()
    {
        cargandoProveedores = true;
        errorCargaProveedores = false;
        try
        {
            var resultado = await InsumoService.ListarProveedoresNegocioAsync();
            if (resultado.Success && resultado.Data is not null)
            {
                listaProveedores = resultado.Data
                    .OrderBy(p => p.Nombre, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            else
            {
                errorCargaProveedores = true;
            }
        }
        catch (HttpRequestException)
        {
            errorCargaProveedores = true;
        }
        catch (Exception)
        {
            errorCargaProveedores = true;
        }
        finally
        {
            cargandoProveedores = false;
        }
    }
    
    private List<ProveedorDTO> sugerenciasActuales = new();
    private bool buscandoProveedores;
    private CancellationTokenSource? proveedorBusquedaCts;

    // Aviso "sin coincidencias": persiste 5s tras salir del campo (punto 3).
    private bool avisoProveedorVisible;
    private CancellationTokenSource? avisoProveedorCts;

    // Último término con coincidencia EXACTA devuelta por la BD (punto 2).
    private string? terminoExactoDb;

    // Hay coincidencia si la lista muestra algo o el texto iguala a un
    // proveedor registrado (local o confirmado por la BD). Solo sin esto
    // se avisa que se creará como nuevo.
    private bool HayCoincidenciaProveedor()
    {
        if (sugerenciasActuales.Any()) return true;
        var texto = form.Proveedor?.Trim() ?? string.Empty;
        if (texto.Length == 0) return true;
        if (listaProveedores.Any(p => string.Equals(p.Nombre.Trim(), texto, StringComparison.OrdinalIgnoreCase))) return true;
        return terminoExactoDb is not null
            && string.Equals(terminoExactoDb, texto, StringComparison.OrdinalIgnoreCase);
    }

    private bool MostrarAvisoSinCoincidencia =>
        !string.IsNullOrWhiteSpace(form.Proveedor)
        && !buscandoProveedores
        && !HayCoincidenciaProveedor()
        && (mostrarSugerenciasProveedor || avisoProveedorVisible);

    private static List<ProveedorDTO> FiltrarProveedores(IEnumerable<ProveedorDTO> fuente, string termino, int tope = 6)
    {
        if (string.IsNullOrWhiteSpace(termino))
        {
            return new List<ProveedorDTO>();
        }
        var t = termino.Trim();
        var prefijos = fuente
            .Where(p => p.Nombre.StartsWith(t, StringComparison.OrdinalIgnoreCase)
                && !string.Equals(p.Nombre, t, StringComparison.OrdinalIgnoreCase))
            .Take(tope)
            .ToList();
        if (prefijos.Count < tope)
        {
            prefijos.AddRange(fuente
                .Where(p => !p.Nombre.StartsWith(t, StringComparison.OrdinalIgnoreCase)
                    && p.Nombre.Contains(t, StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(p.Nombre, t, StringComparison.OrdinalIgnoreCase)
                    && !prefijos.Any(x => x.Id == p.Id))
                .Take(tope - prefijos.Count));
        }
        return prefijos;
    }

    private void MostrarSugerenciasProveedor()
    {
        avisoProveedorCts?.Cancel();
        avisoProveedorVisible = false;
        mostrarSugerenciasProveedor = true;
        sugerenciasActuales = FiltrarProveedores(listaProveedores, form.Proveedor);
        _ = BuscarSugerenciasEnBdAsync(form.Proveedor);
    }

    private async Task OcultarSugerenciasProveedor()
    {
        // Retardo para que el clic en la sugerencia se procese antes del blur.
        await Task.Delay(150);
        mostrarSugerenciasProveedor = false;
        // El aviso no desaparece al saltar de campo: queda 5s visible.
        if (!string.IsNullOrWhiteSpace(form.Proveedor) && !HayCoincidenciaProveedor())
        {
            avisoProveedorVisible = true;
            StateHasChanged();
            await ProgramarOcultadoAvisoAsync();
        }
    }

    private async Task ProgramarOcultadoAvisoAsync()
    {
        avisoProveedorCts?.Cancel();
        avisoProveedorCts?.Dispose();
        avisoProveedorCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(5000, avisoProveedorCts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        avisoProveedorVisible = false;
        StateHasChanged();
    }

    private void OnProveedorOnInput(ChangeEventArgs e)
    {
        form.Proveedor = e.Value?.ToString() ?? string.Empty;
        errores.Remove(nameof(form.Proveedor));
        avisoProveedorCts?.Cancel();
        avisoProveedorVisible = false;
        mostrarSugerenciasProveedor = true;
        sugerenciasActuales = FiltrarProveedores(listaProveedores, form.Proveedor);
        _ = BuscarSugerenciasEnBdAsync(form.Proveedor);
    }

    private async Task BuscarSugerenciasEnBdAsync(string? texto)
    {
        proveedorBusquedaCts?.Cancel();
        proveedorBusquedaCts?.Dispose();
        proveedorBusquedaCts = new CancellationTokenSource();
        var token = proveedorBusquedaCts.Token;

        var termino = texto?.Trim() ?? string.Empty;
        if (termino.Length == 0)
        {
            buscandoProveedores = false;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(150, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        buscandoProveedores = true;
        StateHasChanged();
        try
        {
            var resultado = await InsumoService.BuscarProveedoresAsync(termino, 8);
            if (token.IsCancellationRequested) return;
            if (!string.Equals(form.Proveedor?.Trim(), termino, StringComparison.OrdinalIgnoreCase)) return;
            if (resultado.Success && resultado.Data is not null)
            {
                // Registra si la BD trae el nombre exacto (aunque se excluya
                // de la lista visible) para no avisar en vano.
                terminoExactoDb = resultado.Data.Any(p => string.Equals(p.Nombre.Trim(), termino, StringComparison.OrdinalIgnoreCase))
                    ? termino
                    : null;
                sugerenciasActuales = FiltrarProveedores(resultado.Data, termino, 8);
                // Si llegaron coincidencias, un aviso previo queda sin efecto.
                if (HayCoincidenciaProveedor())
                {
                    avisoProveedorCts?.Cancel();
                    avisoProveedorVisible = false;
                }
            }
        }
        catch (Exception)
        {
        }
        finally
        {
            buscandoProveedores = false;
            StateHasChanged();
        }
    }

    private void SeleccionarProveedor(string nombre)
    {
        proveedorBusquedaCts?.Cancel();
        buscandoProveedores = false;
        avisoProveedorCts?.Cancel();
        avisoProveedorVisible = false;
        form.Proveedor = nombre;
        sugerenciasActuales.Clear();
        mostrarSugerenciasProveedor = false;
        errores.Remove(nameof(form.Proveedor));
    }

    private async Task CargarAsync()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var resultado = await InsumoService.ListarAsync(
                textoBusqueda, ordenarPor, direccion, unidadFiltro, categoriaFiltro, incluirInactivos, pagina, TamanoPagina);

            if (resultado.Success && resultado.Data is not null)
            {
                insumos = resultado.Data.Datos;
                total = resultado.Data.Total;
            }
            else
            {
                mensajeError = resultado.Message ?? "No se pudieron cargar los insumos.";
            }
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error al cargar los insumos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task OnBusquedaInput(ChangeEventArgs e)
    {
        textoBusqueda = e.Value?.ToString() ?? string.Empty;

        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        try
        {
            await Task.Delay(400, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        pagina = 1;
        await CargarAsync();
        StateHasChanged();
    }

    private async Task OnUnidadFiltroChanged(ChangeEventArgs e)
    {
        unidadFiltro = e.Value?.ToString() ?? string.Empty;
        pagina = 1;
        await CargarAsync();
    }

    private async Task OnCategoriaFiltroChanged(ChangeEventArgs e)
    {
        categoriaFiltro = e.Value?.ToString() ?? string.Empty;
        pagina = 1;
        await CargarAsync();
    }

    private async Task OnOrdenChanged(ChangeEventArgs e)
    {
        ordenarPor = e.Value?.ToString() ?? "nombre";
        pagina = 1;
        await CargarAsync();
    }

    private async Task OnDireccionChanged(ChangeEventArgs e)
    {
        direccion = e.Value?.ToString() ?? "asc";
        pagina = 1;
        await CargarAsync();
    }

    private async Task OnIncluirInactivosChanged(ChangeEventArgs e)
    {
        incluirInactivos = e.Value is bool b && b;
        pagina = 1;
        await CargarAsync();
    }

    private async Task PaginaAnterior()
    {
        if (pagina > 1)
        {
            pagina--;
            await CargarAsync();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (pagina < totalPaginas)
        {
            pagina++;
            await CargarAsync();
        }
    }

