    private async Task CargarProveedoresAsync()
    {
        cargandoProveedores = true;
        errorCargaProveedores = false;
        try
        {
            var resultado = await InsumoService.ListarProveedoresNegocioAsync();
            if (resultado.Success && resultado.Data is not null)
            {
                listaProveedores = resultado.Data
                    .OrderBy(p => p.Nombre, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            else
            {
                errorCargaProveedores = true;
            }
        }
        catch (HttpRequestException)
        {
            errorCargaProveedores = true;
        }
        catch (Exception)
        {
            errorCargaProveedores = true;
        }
        finally
        {
            cargandoProveedores = false;
        }
    }
    
