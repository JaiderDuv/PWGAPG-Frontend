    private static readonly HashSet<string> CategoriasValidas = new(StringComparer.OrdinalIgnoreCase)
    {
        "materia_prima", "empaque", "otro"
    };

    private static readonly System.Globalization.CompareInfo ComparadorNombres =
        System.Globalization.CultureInfo.InvariantCulture.CompareInfo;

    private static decimal TopeCantidadUnidad(string? unidad) =>
        ConversorUnidades.EsUnidadPequena(unidad) ? 999.99m : 999999.99m;

    private static string MensajeTopeCantidad(string? unidad) =>
        ConversorUnidades.EsUnidadPequena(unidad)
            ? "Para taza, cucharada, cucharadita, unidad o docena la cantidad máxima es 999.99 (3 enteros y 2 decimales)."
            : "La cantidad máxima es 999999.99 (6 enteros y 2 decimales).";

    private static string CategoriaEnvio(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor)) return "otro";
        return string.Join("_", valor.Trim().ToLowerInvariant()
            .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
    }

    private static string CategoriaMostrar(string? valor)
    {
        return valor?.Trim().ToLowerInvariant() switch
        {
            "materia_prima" => "Materia prima",
            "empaque" => "Empaque",
            "otro" => "Otro",
            _ => string.IsNullOrWhiteSpace(valor) ? "—" : valor
        };
    }

    private static bool NombreIgual(string? a, string? b) =>
        ComparadorNombres.Compare(a?.Trim() ?? "", b?.Trim() ?? "",
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) == 0;

    private static bool NombreEmpieza(string? fuente, string? valor) =>
        !string.IsNullOrWhiteSpace(valor) &&
        ComparadorNombres.IsPrefix((fuente ?? "").Trim(), valor.Trim(),
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace);

    private static bool NombreContiene(string? fuente, string? valor) =>
        !string.IsNullOrWhiteSpace(valor) &&
        ComparadorNombres.IndexOf(fuente ?? "", valor.Trim(),
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void OnCostoRawInput(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? "";
        if (decimal.TryParse(texto, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 999999.99m)
        {
            errores[nameof(form.CostoUnitario)] = "El costo no puede superar 999999.99 (6 enteros y 2 decimales).";
        }
        else
        {
            errores.Remove(nameof(form.CostoUnitario));
        }
    }

    private void OnCantidadRawInput(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? "";
        if (decimal.TryParse(texto, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v) && v > TopeCantidadUnidad(form.UnidadMedida))
        {
            errores[nameof(form.Cantidad)] = MensajeTopeCantidad(form.UnidadMedida);
        }
        else
        {
            errores.Remove(nameof(form.Cantidad));
        }
    }

    private bool ValidarFormulario()
    {
        form.Proveedor = form.Proveedor?.Trim() ?? string.Empty;
        errores.Clear();

        if (string.IsNullOrWhiteSpace(form.Nombre))
        {
            errores[nameof(form.Nombre)] = "El nombre es obligatorio.";
        }
        else if (form.Nombre.Trim().Length > 75)
        {
            errores[nameof(form.Nombre)] = "El nombre no puede superar los 75 caracteres.";
        }

        if (string.IsNullOrWhiteSpace(form.UnidadMedida))
        {
            errores[nameof(form.UnidadMedida)] = "Selecciona una unidad de medida.";
        }
        else if (!ConversorUnidades.EsValida(form.UnidadMedida))
        {
            errores[nameof(form.UnidadMedida)] = "Selecciona una unidad de medida válida.";
        }

        if (form.DensidadGPorMl is < 0m or > 20m)
        {
            errores[nameof(form.DensidadGPorMl)] = "La densidad debe estar entre 0 y 20 g/ml.";
        }

        if (string.IsNullOrWhiteSpace(form.Categoria) ||
            !CategoriasValidas.Contains(CategoriaEnvio(form.Categoria)))
        {
            errores[nameof(form.Categoria)] = "Selecciona una categoría válida.";
        }

        if (form.CostoUnitario is null)
        {
            errores[nameof(form.CostoUnitario)] = "El costo unitario es obligatorio y debe ser mayor a 0.";
        }
        else if (form.CostoUnitario.Value <= 0)
        {
            errores[nameof(form.CostoUnitario)] = "El costo debe ser mayor a 0.";
        }
        else if (form.CostoUnitario.Value > 999999.99m)
        {
            errores[nameof(form.CostoUnitario)] = "El costo no puede superar 999999.99 (6 enteros y 2 decimales).";
        }

        if (string.IsNullOrWhiteSpace(form.Proveedor))
        {
            errores[nameof(form.Proveedor)] = "El proveedor es obligatorio.";
        }
        else if (form.Proveedor.Trim().Length > 150)
        {
            errores[nameof(form.Proveedor)] = "El proveedor no puede superar los 150 caracteres.";
        }

        if (form.Cantidad is null)
        {
            errores[nameof(form.Cantidad)] = "La cantidad es obligatoria.";
        }
        else if (form.Cantidad.Value < 0)
        {
            errores[nameof(form.Cantidad)] = "La cantidad no puede ser negativa.";
        }
        else if (form.Cantidad.Value > TopeCantidadUnidad(form.UnidadMedida))
        {
            errores[nameof(form.Cantidad)] = MensajeTopeCantidad(form.UnidadMedida);
        }

        if (esEdicion && insumoEditando is not null &&
            form.CostoUnitario.HasValue && form.CostoUnitario.Value != insumoEditando.CostoUnitario &&
            string.IsNullOrWhiteSpace(form.Proveedor))
        {
            errores[nameof(form.Proveedor)] = "Para cambiar el precio primero indica el proveedor desde la celda Proveedor de la tabla (clic para editar).";
        }

        return errores.Count == 0;
    }

    private async Task GuardarFormulario()
    {
        LimpiarMensajes();
        errorGeneralModal = null;

        if (!ValidarFormulario())
        {
            return;
        }

        procesando = true;
        try
        {
            if (esEdicion && insumoEditando is not null)
            {
                await GuardarEdicionAsync();
            }
            else
            {
                await GuardarNuevoAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorGeneralModal = "No fue posible conectar con el servidor.";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task GuardarNuevoAsync()
    {
        var request = new CrearInsumoRequest
        {
            Nombre = form.Nombre.Trim(),
            UnidadMedida = form.UnidadMedida.Trim().ToLowerInvariant(),
            Categoria = CategoriaEnvio(form.Categoria),
            CostoUnitario = form.CostoUnitario!.Value,
            Cantidad = form.Cantidad,
            DensidadGPorMl = form.DensidadGPorMl,
            Proveedor = string.IsNullOrWhiteSpace(form.Proveedor) ? null : form.Proveedor.Trim(),
            Activo = form.Activo
        };

        var resultado = await InsumoService.CrearAsync(request);
        if (!resultado.Success || resultado.Data is null)
        {
            errorGeneralModal = resultado.Message ?? "No se pudo crear el insumo.";
            return;
        }

        var creado = resultado.Data;
        total++;
        if (pagina == 1 && CoincideConFiltros(creado))
        {
            insumos.Add(creado);
            OrdenarLocal();
            if (insumos.Count > TamanoPagina)
            {
                insumos.RemoveAt(insumos.Count - 1);
            }
        }

        CerrarModal();
        mensajeExito = $"El insumo «{creado.Nombre}» fue guardado correctamente.";
    }

    private async Task GuardarEdicionAsync()
    {
        var original = insumoEditando!;
        var request = new ActualizarInsumoRequest();

        if (!string.Equals(form.Nombre.Trim(), original.Nombre, StringComparison.Ordinal))
        {
            request.Nombre = form.Nombre.Trim();
        }
        if (!string.Equals(form.UnidadMedida.Trim(), original.UnidadMedida, StringComparison.OrdinalIgnoreCase))
        {
            request.UnidadMedida = form.UnidadMedida.Trim().ToLowerInvariant();
        }

        var categoriaForm = CategoriaEnvio(form.Categoria);
        var categoriaOriginal = CategoriaEnvio(original.Categoria);
        if (!string.Equals(categoriaForm, categoriaOriginal, StringComparison.Ordinal))
        {
            request.Categoria = categoriaForm;
        }
        if (form.CostoUnitario!.Value != original.CostoUnitario)
        {
            request.CostoUnitario = form.CostoUnitario.Value;
            request.Proveedor = form.Proveedor.Trim();
        }
        else if ((form.Proveedor ?? string.Empty).Trim() != (original.Proveedor ?? string.Empty))
        {
            request.Proveedor = string.IsNullOrWhiteSpace(form.Proveedor) ? string.Empty : form.Proveedor.Trim();
        }
        if (form.Cantidad != original.Cantidad)
        {
            request.Cantidad = form.Cantidad;
        }

        var densidadForm = form.DensidadGPorMl is 0m ? null : form.DensidadGPorMl;
        if (densidadForm != original.DensidadGPorMl)
        {
            // 0 limpia la densidad; null en el DTO significa "no modificar".
            request.DensidadGPorMl = densidadForm ?? 0m;
        }

        if (form.Activo != original.Activo)
        {
            request.Activo = form.Activo;
        }

        if (request.Nombre is null && request.UnidadMedida is null && request.Categoria is null &&
            request.CostoUnitario is null && request.Cantidad is null &&
            request.DensidadGPorMl is null &&
            request.Proveedor is null && request.Activo is null)
        {
            CerrarModal();
            mensajeExito = "No has editado ningún campo.";
            return;
        }

        var resultado = await InsumoService.ActualizarParcialAsync(original.Id, request);
        if (!resultado.Success || resultado.Data is null)
        {
            if (EsMensajeSinCambios(resultado.Message))
            {
                CerrarModal();
                mensajeExito = "No has editado ningún campo.";
                return;
            }
            errorGeneralModal = resultado.Message ?? "No se pudo actualizar el insumo.";
            return;
        }

        var actualizado = resultado.Data;
        var index = insumos.FindIndex(i => i.Id == actualizado.Id);
        if (index >= 0)
        {
            if (!actualizado.Activo && !incluirInactivos)
            {
                insumos.RemoveAt(index);
                total--;
            }
            else
            {
                insumos[index] = actualizado;
            }
        }

        CerrarModal();
        mensajeExito = $"El insumo «{actualizado.Nombre}» fue actualizado correctamente.";
    }

    private bool EsEditando(int id, string campo) =>
        edicionRapidaId == id && edicionRapidaCampo == campo;

    private async Task IniciarEdicionRapida(InsumoApiDto insumo, string campo)
    {
        if (guardandoRapido || procesando) return;
        LimpiarMensajes();
        edicionRapidaId = insumo.Id;
        edicionRapidaCampo = campo;
        proveedoresEdicionRapida.Clear();
        cargandoProveedoresRapida = false;
        var invariante = System.Globalization.CultureInfo.InvariantCulture;
        edicionRapidaValor = campo switch
        {
            "nombre" => insumo.Nombre,
            "unidad" => insumo.UnidadMedida,
            "categoria" => CategoriaEnvio(insumo.Categoria),
            "costo" => insumo.CostoUnitario.ToString(invariante),
            "cantidad" => insumo.Cantidad?.ToString(invariante) ?? string.Empty,
            "proveedor" => insumo.Proveedor ?? string.Empty,
            _ => string.Empty
        };

        if (campo == "proveedor")
        {
            var idSolicitado = insumo.Id;
            cargandoProveedoresRapida = true;
            try
            {
                var resultado = await InsumoService.ListarProveedoresDeInsumoAsync(insumo.Id);
                if (edicionRapidaId == idSolicitado && edicionRapidaCampo == "proveedor")
                {
                    proveedoresEdicionRapida = resultado.Success && resultado.Data is not null
                        ? resultado.Data
                        : new List<InsumoProveedorDTO>();
                }
            }
            catch (Exception)
            {
                if (edicionRapidaId == idSolicitado && edicionRapidaCampo == "proveedor")
                {
                    proveedoresEdicionRapida = new List<InsumoProveedorDTO>();
                }
            }
            finally
            {
                if (edicionRapidaId == idSolicitado && edicionRapidaCampo == "proveedor")
                {
                    cargandoProveedoresRapida = false;
                    StateHasChanged();
                }
            }
        }
    }

    private async Task SeleccionarProveedorRapidoAsync(string nombre)
    {
        if (guardandoRapido) return;
        edicionRapidaValor = nombre;
        await GuardarEdicionRapida();
    }

    private void CancelarEdicionRapida()
    {
        edicionRapidaId = null;
        edicionRapidaCampo = null;
        edicionRapidaValor = string.Empty;
        proveedoresEdicionRapida.Clear();
        cargandoProveedoresRapida = false;
    }

    private void AvisarSinCambios()
    {
        CancelarEdicionRapida();
        mensajeExito = "No has editado ningún campo.";
    }

    private static bool EsMensajeSinCambios(string? mensaje) =>
        mensaje?.Contains("al menos un campo", StringComparison.OrdinalIgnoreCase) == true;

    private async Task CambiarEdicionRapida(string valor)
    {
        edicionRapidaValor = valor;
        await GuardarEdicionRapida();
    }

    private async Task TeclaEdicionRapida(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await GuardarEdicionRapida();
        else if (e.Key == "Escape") CancelarEdicionRapida();
    }

    private static bool IntentarDecimal(string texto, out decimal valor) =>
        decimal.TryParse((texto ?? string.Empty).Trim(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out valor);

    private async Task GuardarEdicionRapida()
    {
        if (guardandoRapido || edicionRapidaId is null || edicionRapidaCampo is null) return;
        var objetivo = insumos.FirstOrDefault(i => i.Id == edicionRapidaId.Value);
        if (objetivo is null) { CancelarEdicionRapida(); return; }

        var request = new ActualizarInsumoRequest();
        var campo = edicionRapidaCampo;
        var texto = (edicionRapidaValor ?? string.Empty).Trim();

        if (campo == "nombre")
        {
            if (texto.Length == 0) { mensajeError = "El nombre es obligatorio."; return; }
            if (texto.Length > 75) { mensajeError = "El nombre no puede superar los 75 caracteres."; return; }
            if (string.Equals(texto, objetivo.Nombre, StringComparison.OrdinalIgnoreCase)) { AvisarSinCambios(); return; }
            request.Nombre = texto;
        }
        else if (campo == "unidad")
        {
            if (!ConversorUnidades.EsValida(texto)) { mensajeError = "Selecciona una unidad de medida válida."; return; }
            if (string.Equals(texto, objetivo.UnidadMedida, StringComparison.OrdinalIgnoreCase)) { AvisarSinCambios(); return; }
            request.UnidadMedida = texto.ToLowerInvariant();
        }
        else if (campo == "categoria")
        {
            var canonica = CategoriaEnvio(texto);
            if (!CategoriasValidas.Contains(canonica)) { mensajeError = "Selecciona una categoría válida."; return; }
            if (string.Equals(canonica, CategoriaEnvio(objetivo.Categoria), StringComparison.Ordinal)) { AvisarSinCambios(); return; }
            request.Categoria = canonica;
        }
        else if (campo == "costo")
        {
            if (!IntentarDecimal(texto, out var costo) || costo <= 0) { mensajeError = "El costo debe ser mayor a 0."; return; }
            if (costo > 999999.99m) { mensajeError = "El costo no puede superar 999999.99 (6 enteros y 2 decimales)."; return; }
            if (costo == objetivo.CostoUnitario) { AvisarSinCambios(); return; }
            var prov = (objetivo.Proveedor ?? string.Empty).Trim();
            if (prov.Length == 0) { mensajeError = "Para cambiar el precio debes indicar el proveedor (usa Editar)."; return; }
            request.CostoUnitario = costo;
            request.Proveedor = prov;
        }
        else if (campo == "cantidad")
        {
            if (texto.Length == 0) { mensajeError = "La cantidad es obligatoria."; return; }
            if (!IntentarDecimal(texto, out var cantidad) || cantidad < 0) { mensajeError = "La cantidad no puede ser negativa."; return; }
            if (cantidad > TopeCantidadUnidad(objetivo.UnidadMedida)) { mensajeError = MensajeTopeCantidad(objetivo.UnidadMedida); return; }
            if (objetivo.Cantidad.HasValue && cantidad == objetivo.Cantidad.Value) { AvisarSinCambios(); return; }
            request.Cantidad = cantidad;
        }
        else if (campo == "proveedor")
        {
            if (texto.Length > 150) { mensajeError = "El proveedor no puede superar los 150 caracteres."; return; }
            if (string.Equals(texto, objetivo.Proveedor ?? string.Empty, StringComparison.OrdinalIgnoreCase)) { AvisarSinCambios(); return; }
            if (texto.Length > 0)
            {
                List<InsumoProveedorDTO>? asociados = null;
                try
                {
                    var resp = await InsumoService.ListarProveedoresDeInsumoAsync(objetivo.Id);
                    if (resp.Success) asociados = resp.Data;
                }
                catch (HttpRequestException)
                {
                }
                var vinculado = asociados?.FirstOrDefault(p => NombreIgual(p.Nombre, texto));
                if (vinculado is null && asociados is not null)
                {
                    // Proveedor que aún no maneja este insumo: no se guarda solo el
                    // proveedor (quedaría asociado con los datos viejos). Se abre el
                    // formulario con unidad, costo y cantidad vacíos para que
                    // el usuario los complete y al guardar quede asociado.
                    var nuevoProveedor = texto;
                    mensajeError = null;
                    CancelarEdicionRapida();
                    await AbrirModalEditar(objetivo);
                    form.Proveedor = nuevoProveedor;
                    VaciarCamposParaNuevoProveedor();
                    return;
                }
                if (vinculado is not null)
                {
                    request.Proveedor = texto;
                    request.CostoUnitario = vinculado.Costo;
                    request.Cantidad = vinculado.Cantidad;
                    var uni = (vinculado.UnidadMedida ?? string.Empty).Trim().ToLowerInvariant();
                    if (ConversorUnidades.EsValida(uni))
                    {
                        request.UnidadMedida = uni;
                    }
                }
                else
                {
                    request.Proveedor = texto;
                }
            }
            else
            {
                request.Proveedor = string.Empty;
            }
        }
        else
        {
            CancelarEdicionRapida();
            return;
        }

        guardandoRapido = true;
        try
        {
            var resultado = await InsumoService.ActualizarParcialAsync(objetivo.Id, request);
            if (!resultado.Success || resultado.Data is null)
            {
                if (EsMensajeSinCambios(resultado.Message))
                {
                    AvisarSinCambios();
                    return;
                }
                mensajeError = resultado.Message ?? "No se pudo actualizar el insumo.";
                return;
            }
            var actualizado = resultado.Data;
            var index = insumos.FindIndex(i => i.Id == actualizado.Id);
            if (index >= 0)
            {
                if (!actualizado.Activo && !incluirInactivos)
                {
                    insumos.RemoveAt(index);
                    total--;
                }
                else
                {
                    insumos[index] = actualizado;
                }
            }
            mensajeExito = $"El insumo «{actualizado.Nombre}» fue actualizado correctamente.";
            CancelarEdicionRapida();
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            guardandoRapido = false;
        }
    }

