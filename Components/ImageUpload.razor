@using Microsoft.AspNetCore.Components.Forms

<div class="img-upload-container">
    <InputFile id="@InputId" OnChange="CargarImagen" class="img-upload-input" accept="image/*" @key="inputKey"
               aria-label="@NombreCampo" />
    <label class="img-upload-label" for="@InputId">
        @if (!string.IsNullOrEmpty(ImagenBase64))
        {
            <img src="@ImagenBase64" class="img-upload-preview @FormaClass" alt="@DescripcionImagen" />
        }
        else
        {
            <span class="img-upload-placeholder @FormaClass" aria-hidden="true">+</span>
        }
    </label>
    @if (!string.IsNullOrEmpty(Texto))
    {
        <span class="img-upload-texto">@Texto</span>
    }
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="text-danger msg-error" role="alert">@mensajeError</div>
    }
</div>

@code {
    [Parameter] public string? ImagenBase64 { get; set; }
    [Parameter] public EventCallback<string> ImagenBase64Changed { get; set; }
    [Parameter] public string InputId { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Texto { get; set; } = "";
    [Parameter] public string Forma { get; set; } = "circular"; // "circular" o "cuadrado"
    [Parameter] public string DescripcionImagen { get; set; } = "Vista previa de la imagen seleccionada";

    private string NombreCampo => string.IsNullOrWhiteSpace(Texto) ? "Seleccionar imagen" : Texto;
    private string FormaClass => Forma == "cuadrado" ? "img-upload-cuadrado" : "img-upload-circular";

    private string? mensajeError;
    private Guid inputKey = Guid.NewGuid();
    private const long MaxImagenBytes = 2 * 1024 * 1024;
    private static readonly string[] ExtensionesPermitidas = { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" };

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        mensajeError = null;
        var archivo = e.File;
        if (archivo == null) return;

        var extension = System.IO.Path.GetExtension(archivo.Name).ToLowerInvariant();
        var esImagenPorTipo = archivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
        var esImagenPorExtension = ExtensionesPermitidas.Contains(extension);

        if (!esImagenPorTipo || !esImagenPorExtension)
        {
            MostrarErrorImagen("No es una imagen.");
            await ImagenBase64Changed.InvokeAsync(string.Empty);
            return;
        }

        if (archivo.Size > MaxImagenBytes)
        {
            MostrarErrorImagen("La imagen no puede superar los 2 MB.");
            return;
        }

        string base64;
        try
        {
            using var stream = archivo.OpenReadStream(maxAllowedSize: MaxImagenBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            base64 = Convert.ToBase64String(ms.ToArray());
        }
        catch (IOException)
        {
            MostrarErrorImagen("No se pudo leer la imagen.");
            return;
        }

        await ImagenBase64Changed.InvokeAsync($"data:{archivo.ContentType};base64,{base64}");
    }

    private void MostrarErrorImagen(string mensaje)
    {
        mensajeError = mensaje;
        inputKey = Guid.NewGuid();
    }
}
