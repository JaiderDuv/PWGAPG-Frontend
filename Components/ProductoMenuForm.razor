@using System.ComponentModel.DataAnnotations
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@inject MenuApiService MenuApi
@inject RecetaApiService RecetaApi

<div class="rc-card rc-form">
    <div class="rc-card-header">
        <h5 class="mb-0">@(Editando is null ? "Nuevo producto" : $"Editar producto #{Editando.Id}")</h5>
    </div>

    <EditForm Model="modelo" OnValidSubmit="Guardar" OnInvalidSubmit="AlInvalido" class="rc-card-body" novalidate>
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="rc-label">Nombre * <small class="text-muted">(@(modelo.Nombre?.Length ?? 0)/75)</small></label>
                <InputText class="form-control" @bind-Value="modelo.Nombre" maxlength="75"
                           placeholder="Ej: Caja Mixta de Panes" />
                <ValidationMessage For="() => modelo.Nombre" class="rc-error" />
            </div>
            <div class="col-md-3">
                <label class="rc-label">Costo directo</label>
                <input class="form-control" readonly
                       value="@(costoPreview is not null ? Formato.Moneda(costoPreview.CostoDirecto) : (calculando ? "Calculando..." : "$ 0"))"
                       placeholder="$ 0" />
                <small class="text-muted">Recetas + empaques. Los fijos se muestran aparte.</small>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="pm-activo" @bind-Value="modelo.Activo" />
                    <label class="form-check-label" for="pm-activo">Activo (vigente en el menú)</label>
                </div>
            </div>
        </div>

        <h6 class="rc-section-title mt-4">Recetas del producto * (mínimo una)</h6>
        @if (!recetasDisponibles.Any())
        {
            <div class="alert alert-warning">Aún no tienes recetas. Crea al menos una en el apartado Recetas.</div>
        }
        <div class="table-responsive">
            <table class="table rc-table align-middle">
                <thead>
                    <tr>
                        <th>Receta</th>
                        <th style="width:160px">Porciones</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in modelo.FilasReceta)
                    {
                        <tr>
                            <td>
                                <select class="form-select" @bind="f.RecetaId" @bind:after="AlCambiarComposicion">
                                    <option value="0">Selecciona...</option>
                                    @foreach (var r in recetasDisponibles)
                                    {
                                        <option value="@r.Id">@r.Nombre</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" class="form-control" min="0" max="10000" step="1"
                                       @bind="f.Cantidad" @bind:event="oninput" @bind:after="AlCambiarComposicion" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => QuitarReceta(f)" title="Quitar">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AgregarReceta">+ Agregar receta</button>
        @if (errorRecetas is not null) { <div class="rc-error mt-2">@errorRecetas</div> }

        <h6 class="rc-section-title mt-4">Empaques / insumos directos <small class="text-muted">(opcional)</small></h6>
        <p class="text-muted small">
            Ej.: caja, bolsa o etiqueta. Se guardan con el producto y entran en el costo completo, el margen y la evaluación del menú.
        </p>
        <div class="table-responsive">
            <table class="table rc-table align-middle">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th style="width:140px">Cantidad</th>
                        <th style="width:120px">Unidad</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in modelo.FilasEmpaque)
                    {
                        <tr>
                            <td>
                                <select class="form-select" @bind="f.InsumoId" @bind:after="() => AlCambiarInsumo(f)">
                                    <option value="0">Selecciona...</option>
                                    @foreach (var i in insumosDisponibles)
                                    {
                                        <option value="@i.Id">@i.Nombre</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" class="form-control" min="0" step="1"
                                       @bind="f.Cantidad" @bind:event="oninput" @bind:after="AlCambiarComposicion" />
                            </td>
                            <td>
                                <select class="form-select" @bind="f.UnidadMedida" @bind:after="AlCambiarComposicion">
                                    @foreach (var u in Unidades) { <option value="@u">@u</option> }
                                </select>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => QuitarEmpaque(f)" title="Quitar">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AgregarEmpaque">+ Agregar empaque</button>

        <div class="cs-preview mt-3">
            @if (costoPreview is not null)
            {
                <span>Costo directo en vivo: <strong>@Formato.Moneda(costoPreview.CostoDirecto)</strong></span>
                <span class="text-muted"> (recetas @Formato.Moneda(costoPreview.CostoRecetas) + empaques @Formato.Moneda(costoPreview.CostoInsumosDirectos))</span>
                @if (costoPreview.CostoFijoProrrateado > 0)
                {
                    <span class="text-muted d-block">
                        Costo completo con fijos: @Formato.Moneda(costoPreview.CostoTotal)
                        (fijos @Formato.Moneda(costoPreview.CostoFijoProrrateado)). Solo para análisis.
                    </span>
                }
            }
            else if (calculando)
            {
                <span class="text-muted">Calculando costo...</span>
            }
            else
            {
                <span class="text-muted">Agrega al menos una receta para ver el costo en vivo.</span>
            }
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-4">
                <label class="rc-label">Margen de ganancia % <small class="text-muted">(sobre el precio de venta)</small></label>
                <input type="number" class="form-control" min="1" max="99" step="1" @bind="margenSugerido" />
            </div>
            <div class="col-md-8 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="SugerirPrecio" disabled="@sugiriendo">
                    @(sugiriendo ? "Sugiriendo..." : "Sugerir precio")
                </button>
                @if (precioSugerido?.PrecioSugerido.HasValue == true)
                {
                    <span class="text-muted">
                        Puedes colocar <strong>@Formato.Moneda(precioSugerido.PrecioSugerido.Value)</strong>
                        (base: @(precioSugerido.IncluyeCostosFijos ? "costo completo con fijos" : "costo directo")) en Precio de venta:
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="UsarSugerido">Usar</button>
                }
            </div>
        </div>

        <div class="form-check mt-2">
            <InputCheckbox class="form-check-input" id="pm-incluir-fijos"
                           @bind-Value="incluirFijosPrecio" @bind:after="LimpiarSugerencia" />
            <label class="form-check-label" for="pm-incluir-fijos">Incluir costos fijos en el precio sugerido</label>
            <small class="text-muted d-block">
                Por defecto el precio usa el costo directo. Los fijos se cubren con el punto de equilibrio;
                actívalo solo si quieres que este producto cargue con todos los fijos activos.
            </small>
        </div>
        @if (errorSugerido is not null) { <div class="rc-error mt-2">@errorSugerido</div> }

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <label class="rc-label">Precio de venta</label>
                <InputNumber class="form-control" @bind-Value="modelo.PrecioVenta"
                             min="0" max="999999.99" step="1" placeholder="Ej: 25000"
                             ParsingErrorMessage="El precio debe ser un número válido." />
                <ValidationMessage For="() => modelo.PrecioVenta" class="rc-error" />
                <small class="text-muted">Máximo 6 dígitos (999.999,99). Se reescribe con “Usar”.</small>
                @if (MargenRealResultante.HasValue)
                {
                    <small class="d-block mt-1">
                        @(incluirFijosPrecio ? "Margen con fijos resultante:" : "Margen directo resultante:")
                        <strong>@MargenRealResultante.Value.ToString("0.##") %</strong>
                        <span class="text-muted">(según la base elegida)</span>
                    </small>
                }
            </div>
        </div>

        @if (errorForm is not null) { <div class="alert alert-danger mt-3">@errorForm</div> }

        <div class="d-flex gap-2 justify-content-end mt-3">
            <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelar" disabled="@guardando">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar")
            </button>
        </div>
    </EditForm>
</div>

<ConfirmDialog Visible="mostrarAvisoMargen"
               Mensaje="@mensajeAvisoMargen"
               OnConfirmar="ConfirmarMargen"
               OnCancelar="CancelarMargen" />

@code {
    [Parameter] public ProductoMenuDetalleDto? Editando { get; set; }
    [Parameter] public EventCallback<string?> OnGuardado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private static readonly string[] Unidades = ["g", "kg", "ml", "l", "oz", "lb", "unidad", "taza"];

    private ProductoMenuFormModelo modelo = new();
    private List<RecetaDto> recetasDisponibles = new();
    private List<InsumoOpcionDto> insumosDisponibles = new();
    private bool guardando, calculando, sugiriendo;
    private string? errorForm, errorRecetas, errorSugerido;
    private CostoProductoDto? costoPreview;
    private PrecioSugeridoProductoDto? precioSugerido;
    private decimal margenSugerido = 30;
    private bool incluirFijosPrecio;
    private System.Threading.CancellationTokenSource? debounceCts;
    private bool mostrarAvisoMargen;
    private string mensajeAvisoMargen = "";
    private bool margenConfirmado;

    protected override async Task OnInitializedAsync()
    {
        var resRec = await RecetaApi.ListarAsync(null);
        if (resRec.Exito && resRec.Datos is not null) recetasDisponibles = resRec.Datos;
        insumosDisponibles = await RecetaApi.ListarInsumosAsync();

        if (Editando is not null)
        {
            modelo = new ProductoMenuFormModelo
            {
                Nombre = Editando.Nombre,
                PrecioVenta = Editando.PrecioVenta,
                Activo = Editando.Activo,
                FilasReceta = Editando.Recetas.Select(r => new ProductoMenuFormModelo.FilaReceta
                {
                    RecetaId = r.RecetaId, Cantidad = r.Cantidad
                }).ToList(),
                // Empaques guardados del producto (ProductMenuInsumo en la BD).
                FilasEmpaque = Editando.InsumosDirectos.Select(d => new ProductoMenuFormModelo.FilaEmpaque
                {
                    InsumoId = d.InsumoId,
                    Cantidad = d.Cantidad,
                    UnidadMedida = string.IsNullOrWhiteSpace(d.UnidadReceta) ? "unidad" : d.UnidadReceta
                }).ToList()
            };
        }
        else
        {
            modelo.FilasReceta.Add(new ProductoMenuFormModelo.FilaReceta());
        }
        _ = ActualizarPreview();
    }

    private void AgregarReceta() => modelo.FilasReceta.Add(new ProductoMenuFormModelo.FilaReceta());
    private void QuitarReceta(ProductoMenuFormModelo.FilaReceta f)
    {
        modelo.FilasReceta.Remove(f);
        _ = ActualizarPreview();
    }
    private void AgregarEmpaque() => modelo.FilasEmpaque.Add(new ProductoMenuFormModelo.FilaEmpaque());
    private void QuitarEmpaque(ProductoMenuFormModelo.FilaEmpaque f)
    {
        modelo.FilasEmpaque.Remove(f);
        _ = ActualizarPreview();
    }

    private void AlCambiarComposicion() => _ = ActualizarPreview();

    private void AlCambiarInsumo(ProductoMenuFormModelo.FilaEmpaque f)
    {
        // Trae la unidad preconfigurada del insumo; el usuario aún puede cambiarla manual.
        var ins = insumosDisponibles.FirstOrDefault(i => i.Id == f.InsumoId);
        if (ins is not null && !string.IsNullOrWhiteSpace(ins.UnidadMedida)
            && Unidades.Contains(ins.UnidadMedida, StringComparer.OrdinalIgnoreCase))
            f.UnidadMedida = Unidades.First(u => string.Equals(u, ins.UnidadMedida, StringComparison.OrdinalIgnoreCase));
        _ = ActualizarPreview();
    }

    private async Task ActualizarPreview()
    {
        debounceCts?.Cancel();
        debounceCts = new System.Threading.CancellationTokenSource();
        var token = debounceCts.Token;
        try { await Task.Delay(200, token); }
        catch (TaskCanceledException) { return; }

        var recetas = modelo.FilasReceta
            .Where(f => f.RecetaId > 0 && f.Cantidad > 0)
            .Select(f => new RecetaEnProductoDto { RecetaId = f.RecetaId, Cantidad = f.Cantidad })
            .ToList();
        if (recetas.Count == 0) { costoPreview = null; StateHasChanged(); return; }

        calculando = true; StateHasChanged();
        var empaques = modelo.FilasEmpaque
            .Where(f => f.InsumoId > 0 && f.Cantidad > 0)
            .Select(f => new InsumoDirectoDto { InsumoId = f.InsumoId, Cantidad = f.Cantidad, UnidadMedida = f.UnidadMedida })
            .ToList();
        var res = await MenuApi.CostoPreviewAsync(recetas, empaques);
        if (!token.IsCancellationRequested)
        {
            costoPreview = res.Exito ? res.Datos : null;
            calculando = false;
            StateHasChanged();
        }
    }

    private async Task SugerirPrecio()
    {
        errorSugerido = null;
        if (margenSugerido <= 0 || margenSugerido >= 100)
        {
            errorSugerido = "El margen debe estar entre 1 y 99.";
            return;
        }
        // Avisos de margen con confirmación: <5% insuficiente, >75% excesivo.
        if (!margenConfirmado)
        {
            if (margenSugerido < 5)
            {
                mensajeAvisoMargen = $"El margen de {margenSugerido:0.##}% puede ser insuficiente (menor al 5%). ¿Deseas continuar con la sugerencia?";
                mostrarAvisoMargen = true;
                return;
            }
            if (margenSugerido > 75)
            {
                mensajeAvisoMargen = $"El margen de {margenSugerido:0.##}% implica un costo excesivo para el cliente (mayor al 75%). ¿Deseas continuar con la sugerencia?";
                mostrarAvisoMargen = true;
                return;
            }
        }
        margenConfirmado = false;
        sugiriendo = true;
        var recetas = modelo.FilasReceta
            .Where(f => f.RecetaId > 0 && f.Cantidad > 0)
            .Select(f => new RecetaEnProductoDto { RecetaId = f.RecetaId, Cantidad = f.Cantidad })
            .ToList();
        if (recetas.Count == 0)
        {
            errorSugerido = "Agrega al menos una receta válida.";
            sugiriendo = false;
            return;
        }
        var empaques = modelo.FilasEmpaque
            .Where(f => f.InsumoId > 0 && f.Cantidad > 0)
            .Select(f => new InsumoDirectoDto { InsumoId = f.InsumoId, Cantidad = f.Cantidad, UnidadMedida = f.UnidadMedida })
            .ToList();
        // Lista vacía = precio con costo directo (recomendado por defecto).
        // null = incluir todos los costos fijos activos.
        var costosFijosIds = incluirFijosPrecio ? null : new List<int>();
        var res = await MenuApi.PrecioPreviewAsync(recetas, empaques, margenSugerido, costosFijosIds);
        sugiriendo = false;
        if (!res.Exito) { errorSugerido = res.Mensaje; return; }
        precioSugerido = res.Datos;
    }

    private void LimpiarSugerencia()
    {
        precioSugerido = null;
        errorSugerido = null;
    }

    private async Task ConfirmarMargen()
    {
        mostrarAvisoMargen = false;
        margenConfirmado = true;
        await SugerirPrecio();
    }

    private void CancelarMargen()
    {
        mostrarAvisoMargen = false;
        margenConfirmado = false;
    }

    private void UsarSugerido()
    {
        // Única vía que reescribe el precio: usa la sugerencia tal cual
        // para respetar el margen pedido (sugerencia con 2 decimales).
        if (precioSugerido?.PrecioSugerido.HasValue == true)
            modelo.PrecioVenta = precioSugerido.PrecioSugerido.Value;
    }

    // Margen sobre el precio de venta: (precio − costo base) ÷ precio × 100.
    // La base es el costo directo por defecto; si se activa la casilla,
    // se usa el costo completo con fijos.
    private decimal? MargenRealResultante
    {
        get
        {
            if (!modelo.PrecioVenta.HasValue || modelo.PrecioVenta.Value <= 0 || costoPreview is null)
                return null;

            var costoBase = incluirFijosPrecio ? costoPreview.CostoTotal : costoPreview.CostoDirecto;
            return costoBase > 0
                ? decimal.Round((modelo.PrecioVenta.Value - costoBase) / modelo.PrecioVenta.Value * 100m, 2)
                : null;
        }
    }

    private void AlInvalido() => errorForm = "Revisa los campos: hay valores no válidos.";

    private async Task Guardar()
    {
        errorForm = errorRecetas = null;

        // Validación de negocio: mínimo una receta, sin repetidas, cantidades numéricas.
        var validas = modelo.FilasReceta.Where(f => f.RecetaId > 0).ToList();
        if (validas.Count == 0) { errorRecetas = "El producto necesita al menos una receta."; return; }
        if (validas.Select(f => f.RecetaId).Distinct().Count() != validas.Count)
        {
            errorRecetas = "Hay recetas repetidas en el producto.";
            return;
        }
        foreach (var f in validas)
        {
            if (f.Cantidad <= 0) { errorRecetas = "La cantidad de cada receta debe ser mayor a 0."; return; }
            if (decimal.Round(f.Cantidad, 3) != f.Cantidad) { errorRecetas = "La cantidad admite máximo 3 decimales."; return; }
        }
        // Precio de venta editable: validación de 6 dígitos con aviso en español.
        if (modelo.PrecioVenta.HasValue && modelo.PrecioVenta.Value <= 0)
        {
            errorForm = "El precio de venta debe ser mayor a 0.";
            return;
        }
        if (modelo.PrecioVenta.HasValue && modelo.PrecioVenta.Value > 999999.99m)
        {
            errorForm = "El precio de venta no puede exceder los 6 dígitos (máximo 999.999,99).";
            return;
        }
        // El precio se guarda tal como lo escribe el usuario; ya no se fuerza
        // el redondeo a la centena (distorsionaba el margen pedido).
        // El backend conserva sus validaciones (6 dígitos, >0).

        guardando = true;
        var recetas = validas.Select(f => new RecetaEnProductoDto { RecetaId = f.RecetaId, Cantidad = f.Cantidad }).ToList();

        // Empaques válidos del formulario; se guardan en ProductoMenuInsumo.
        var empaques = modelo.FilasEmpaque
            .Where(f => f.InsumoId > 0 && f.Cantidad > 0)
            .Select(f => new InsumoDirectoDto { InsumoId = f.InsumoId, Cantidad = f.Cantidad, UnidadMedida = f.UnidadMedida })
            .ToList();

        ApiResultado<ProductoMenuDetalleDto> res;
        if (Editando is null)
        {
            res = await MenuApi.CrearAsync(new CrearProductoMenuDto
            {
                Nombre = modelo.Nombre.Trim(),
                PrecioVenta = modelo.PrecioVenta,
                Activo = modelo.Activo,
                Recetas = recetas,
                InsumosDirectos = empaques
            });
        }
        else
        {
            // PUT estandarizado: reemplazo total.
            res = await MenuApi.ActualizarPutAsync(Editando.Id, new ActualizarProductoMenuDto
            {
                Nombre = modelo.Nombre.Trim(),
                PrecioVenta = modelo.PrecioVenta,
                Activo = modelo.Activo,
                Recetas = recetas,
                InsumosDirectos = empaques
            });
        }
        guardando = false;

        if (!res.Exito) { errorForm = res.Mensaje; return; }
        await OnGuardado.InvokeAsync(Editando is null ? "Producto creado correctamente." : "Producto actualizado correctamente.");
    }
}
