@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@using System.Net.Http.Json
@inject AuthService AuthService
@inject MenuApiService MenuApi
@inject EvaluacionMenuApiService EvaluacionApi
@inject CosteoApiService CosteoApi
@inject InsumoService InsumoApi
@inject RecetaApiService RecetaApi
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="panel-empresa">
    <div class="panel-empresa-header">
        <div class="panel-empresa-avatar">
            @if (!string.IsNullOrWhiteSpace(logoNegocio))
            {
                <img src="@logoNegocio" alt="Logo de @AuthService.NombreEmpresa" class="panel-empresa-logo-img" />
            }
            else
            {
                @(string.IsNullOrWhiteSpace(AuthService.NombreEmpresa) ? "E" : AuthService.NombreEmpresa.Substring(0, 1).ToUpper())
            }
        </div>
        <div class="panel-empresa-titulos">
            <h1 class="panel-empresa-nombre">@AuthService.NombreEmpresa</h1>
            <div class="panel-empresa-badges">
                <span class="panel-empresa-badge">Emprendimiento Verificado</span>
                @* TODO: reemplazar por la categoría real del negocio cuando se conecte el endpoint correspondiente *@
                @if (!string.IsNullOrWhiteSpace(categoriaNegocio))
                {
                    <span class="panel-empresa-badge panel-empresa-badge-categoria">@categoriaNegocio</span>
                }
            </div>
        </div>
    </div>

    @* ---------- Alerta de riesgo: lo más urgente primero ---------- *@
    @if (cargandoRiesgo)
    {
        <div class="panel-alerta-riesgo">Revisando la rentabilidad de tu menú...</div>
    }
    else if (errorRiesgo is not null)
    {
        <div class="panel-alerta-riesgo">@errorRiesgo</div>
    }
    else if (productosEnRiesgo > 0)
    {
        <div class="panel-alerta-riesgo panel-alerta-riesgo-activa" role="button" @onclick='() => Navigation.NavigateTo("menu/evaluacion")'>
            <span>⚠️ <strong>@productosEnRiesgo producto(s)</strong> están por debajo de tu margen mínimo (@umbralActual.ToString("0.##") %).</span>
            <span class="panel-alerta-link">Revisar ahora →</span>
        </div>
    }
    else
    {
        <div class="panel-alerta-riesgo panel-alerta-ok">
            ✅ Todo tu menú está dentro del umbral de margen mínimo.
        </div>
    }

    @* ---------- Fila de KPIs ---------- *@
    <div class="panel-resumen-grid">
        <div class="panel-resumen-card">
            <div class="panel-resumen-card-header">
                <h4>Productos de menú</h4>
                <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("menu")'>Ver más →</button>
            </div>
            @if (cargandoMenu)
            {
                <p class="text-muted small-texto">Cargando...</p>
            }
            else
            {
                <div class="panel-resumen-cifras">
                    <div>
                        <span class="panel-resumen-numero">@totalActivos</span>
                        <span class="panel-resumen-etiqueta">Activos</span>
                    </div>
                    <div>
                        <span class="panel-resumen-numero panel-resumen-numero-apagado">@totalInactivos</span>
                        <span class="panel-resumen-etiqueta">Inactivos</span>
                    </div>
                </div>
            }
        </div>

        <div class="panel-resumen-card">
            <div class="panel-resumen-card-header">
                <h4>Costos fijos</h4>
                <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("costos-fijos")'>Ver más →</button>
            </div>
            @if (cargandoCostos)
            {
                <p class="text-muted small-texto">Cargando...</p>
            }
            else
            {
                <div class="panel-resumen-cifras">
                    <div>
                        <span class="panel-resumen-numero">@totalCostosFijosActivos</span>
                        <span class="panel-resumen-etiqueta">Activos</span>
                    </div>
                </div>
                <p class="panel-resumen-precio-texto mt-1">
                    Total mensual: <strong>@Formato.Moneda(totalMensualCostosFijos)</strong>
                </p>
                @if (ventasEquilibrio.HasValue)
                {
                    <p class="text-muted small-texto">Punto de equilibrio: @Formato.Moneda(ventasEquilibrio.Value) / mes</p>
                }
            }
        </div>

        <div class="panel-resumen-card">
            <div class="panel-resumen-card-header">
                <h4>Insumos</h4>
                <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("insumos")'>Ver más →</button>
            </div>
            @if (cargandoInsumos)
            {
                <p class="text-muted small-texto">Cargando...</p>
            }
            else
            {
                <span class="panel-resumen-numero">@totalInsumos</span>
                <span class="panel-resumen-etiqueta">Registrados</span>
            }
        </div>

        <div class="panel-resumen-card">
            <div class="panel-resumen-card-header">
                <h4>Proveedores</h4>
                <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("proveedores")'>Ver más →</button>
            </div>
            @if (cargandoProveedores)
            {
                <p class="text-muted small-texto">Cargando...</p>
            }
            else
            {
                <span class="panel-resumen-numero">@totalProveedores</span>
                <span class="panel-resumen-etiqueta">Registrados</span>
            }
        </div>

        <div class="panel-resumen-card">
            <div class="panel-resumen-card-header">
                <h4>Recetas</h4>
                <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("recetas")'>Ver más →</button>
            </div>
            @if (cargandoRecetas)
            {
                <p class="text-muted small-texto">Cargando...</p>
            }
            else
            {
                <span class="panel-resumen-numero">@totalRecetas</span>
                <span class="panel-resumen-etiqueta">Registradas</span>
            }
        </div>
    </div>

    @* ---------- Cambios de precio recientes (última semana, máx. 10) ---------- *@
    <div class="panel-resumen-card panel-cambios-card">
        <div class="panel-resumen-card-header">
            <h4>Cambios de precio recientes</h4>
            <button type="button" class="btn-texto-ver-mas" @onclick='() => Navigation.NavigateTo("insumos/historial")'>Ver todo el historial →</button>
        </div>

        @if (cargandoCambios)
        {
            <p class="text-muted small-texto">Cargando...</p>
        }
        else if (!cambiosRecientes.Any())
        {
            <p class="text-muted small-texto">No hay cambios de precio en los últimos 7 días.</p>
        }
        else
        {
            <div class="panel-cambios-lista">
                @foreach (var c in cambiosRecientes)
                {
                    <div class="panel-cambio-item" role="button" @onclick='() => Navigation.NavigateTo($"insumos/{c.InsumoId}/historial")'>
                        <div class="panel-cambio-info">
                            <strong>@c.NombreInsumo</strong>
                            <span class="text-muted small-texto">
                                Ahora: @Formato.Moneda(c.Precio) · @c.Fecha.ToLocalTime().ToString("dd/MM/yyyy")
                            </span>
                        </div>
                        @if (c.DiferenciaPaquete.HasValue && c.EsSubidaPaquete.HasValue)
                        {
                            <span class="@(c.EsSubidaPaquete.Value ? "pm-texto-riesgo" : "panel-texto-bajada")">
                                @(c.EsSubidaPaquete.Value ? "▲" : "▼") @Formato.Moneda(Math.Abs(c.DiferenciaPaquete.Value))
                                @if (c.VariacionPaquete.HasValue)
                                {
                                    <span class="small-texto">(@c.VariacionPaquete.Value.ToString("0.##")%)</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small-texto">Primer registro</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string? categoriaNegocio;

    private string? logoNegocio;

    private bool cargandoRiesgo = true;
    private string? errorRiesgo;
    private int productosEnRiesgo;
    private decimal umbralActual;

    private bool cargandoMenu = true;
    private int totalActivos;
    private int totalInactivos;

    private bool cargandoCostos = true;
    private int totalCostosFijosActivos;
    private decimal totalMensualCostosFijos;
    private decimal? ventasEquilibrio;

    private bool cargandoInsumos = true;
    private int totalInsumos;

    private bool cargandoProveedores = true;
    private int totalProveedores;

    private bool cargandoRecetas = true;
    private int totalRecetas;
    private bool cargandoCambios = true;
    private List<HistorialPrecioGeneralDto> cambiosRecientes = new();

    protected override async Task OnInitializedAsync()
    {
        // Primera tanda: lo que se ve arriba del todo.
        await Task.WhenAll(
            CargarDatosNegocio(),
            CargarRiesgo());

        // Segunda tanda: los KPIs de en medio.
        await Task.WhenAll(
            CargarResumenMenu(),
            CargarCostosFijos());

        // Tercera tanda: el resto.
        await Task.WhenAll(
            CargarInsumos(),
            CargarProveedores(),
            CargarRecetas(),
            CargarCambiosRecientes());
    }

    private async Task CargarDatosNegocio()
    {
        for (var intento = 1; intento <= 2; intento++)
        {
            try
            {
                var datos = await Http.GetFromJsonAsync<DatosNegocioDto>("api/onboarding/datos-negocio");
                if (datos is not null)
                {
                    categoriaNegocio = datos.CategoriaNegocio;
                    logoNegocio = datos.LogoUrl;
                }
                return;
            }
            catch
            {
                if (intento == 2) return;
                await Task.Delay(1500);
            }
        }
    }

    private class DatosNegocioDto
    {
        public string? CategoriaNegocio { get; set; }
        public string? LogoUrl { get; set; }
    }

    private async Task CargarRiesgo()
    {
        cargandoRiesgo = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await EvaluacionApi.ObtenerEvaluacionAsync();
            if (res.Exito && res.Datos is not null)
            {
                umbralActual = res.Datos.UmbralMargenMinimo;
                productosEnRiesgo = res.Datos.Productos.Count(p => p.EnRiesgo);
                errorRiesgo = null;
                cargandoRiesgo = false;
                return;
            }
            if (intento == 2)
            {
                errorRiesgo = "No se pudo cargar la rentabilidad del menú.";
                cargandoRiesgo = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarResumenMenu()
    {
        cargandoMenu = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await MenuApi.ListarAsync(busqueda: null, incluirInactivos: true);
            if (res.Exito && res.Datos is not null)
            {
                totalActivos = res.Datos.Count(p => p.Activo);
                totalInactivos = res.Datos.Count(p => !p.Activo);
                cargandoMenu = false;
                return;
            }
            if (intento == 2)
            {
                cargandoMenu = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarCostosFijos()
    {
        cargandoCostos = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await CosteoApi.ListarCostosFijosAsync();
            var equilibrio = await CosteoApi.ObtenerPuntoEquilibrioAsync();

            var huboExito = false;
            if (res.Exito && res.Datos is not null)
            {
                totalCostosFijosActivos = res.Datos.Count(c => c.Activo);
                totalMensualCostosFijos = res.Datos.Where(c => c.Activo).Sum(c => c.MontoMensual);
                huboExito = true;
            }
            if (equilibrio.Exito && equilibrio.Datos is not null)
            {
                ventasEquilibrio = equilibrio.Datos.VentasEquilibrioMensuales;
                huboExito = true;
            }

            if (huboExito || intento == 2)
            {
                cargandoCostos = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarInsumos()
    {
        cargandoInsumos = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await InsumoApi.ListarAsync("", "nombre", "asc", "", "", true, 1, 1);
            if (res.Success && res.Data is not null)
            {
                totalInsumos = res.Data.Total;
                cargandoInsumos = false;
                return;
            }
            if (intento == 2)
            {
                cargandoInsumos = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarProveedores()
    {
        cargandoProveedores = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            try
            {
                var resp = await Http.GetAsync("api/negocios/mio/proveedores");
                if (resp.IsSuccessStatusCode)
                {
                    var lista = await resp.Content.ReadFromJsonAsync<List<ProveedorDTO>>();
                    totalProveedores = lista?.Count ?? 0;
                    cargandoProveedores = false;
                    return;
                }
            }
            catch
            {
                // Se reintenta abajo.
            }

            if (intento == 2)
            {
                cargandoProveedores = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarRecetas()
    {
        cargandoRecetas = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await RecetaApi.ListarAsync(null);
            if (res.Exito && res.Datos is not null)
            {
                totalRecetas = res.Datos.Count;
                cargandoRecetas = false;
                return;
            }
            if (intento == 2)
            {
                cargandoRecetas = false;
                return;
            }
            await Task.Delay(1500);
        }
    }

    private async Task CargarCambiosRecientes()
    {
        cargandoCambios = true;
        for (var intento = 1; intento <= 2; intento++)
        {
            var res = await InsumoApi.ObtenerHistorialGeneralAsync(null, null);
            if (res.Success && res.Data?.Precios is not null)
            {
                var haceUnaSemana = DateTime.UtcNow.AddDays(-7);
                cambiosRecientes = res.Data.Precios
                    .Where(p => p.Fecha >= haceUnaSemana)
                    .GroupBy(p => p.InsumoId)
                    .Select(g => g.OrderByDescending(x => x.Fecha).First())
                    .OrderByDescending(p => p.Fecha)
                    .Take(10)
                    .ToList();
                cargandoCambios = false;
                return;
            }
            if (intento == 2)
            {
                cargandoCambios = false;
                return;
            }
            await Task.Delay(1500);
        }
    }
}