@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@inject CosteoApiService Api
@implements IDisposable

<div class="cs-panel">
    <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
        <div>
            <label class="form-label mb-1" for="@($"porciones-{RecetaId}")">Porciones deseadas</label>
            <input id="@($"porciones-{RecetaId}")" type="number" min="1" step="1"
                   class="form-control" style="max-width: 160px;"
                   value="@porcionesTexto" @oninput="OnPorcionesInput" />
        </div>
        <small class="text-muted">Base: @PorcionesBase porción(es) · Factor ×@((escalado?.FactorEscala ?? 1m).ToString("0.####"))</small>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorValidacion))
    {
        <div class="alert alert-danger mb-0">@errorValidacion</div>
    }
    else if (cargando)
    {
        <p class="text-muted mb-0">Calculando escalado...</p>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger mb-0">@error</div>
    }
    else if (escalado is not null)
    {
        @foreach (var a in escalado.Advertencias.Where(a => !a.StartsWith("No seleccionaste ningún costo fijo")))
        {
            <div class="cs-aviso cs-aviso-info"><div>@a</div></div>
        }

        <div class="cs-kpis">
            <div class="cs-kpi cs-kpi-main">
                <small>Costo directo por porción</small>
                <strong>@Formato.Moneda(CostoDirectoPorPorcion)</strong>
                <em>sin costos fijos · @escalado.PorcionesDeseadas porción(es)</em>
            </div>
            <div class="cs-kpi">
                <small>Costo de insumos (directo)</small>
                <strong>@Formato.Moneda(escalado.CostoInsumos)</strong>
                <em>incluye @Formato.Moneda(escalado.CostoMermaAplicada) de merma</em>
            </div>
            <div class="cs-kpi">
                <small>Costo fijo prorrateado</small>
                <strong>@Formato.Moneda(escalado.CostoFijoProrrateado)</strong>
                <em>solo para el costo completo</em>
            </div>
            <div class="cs-kpi">
                <small>Costo completo (con fijos, @escalado.PorcionesDeseadas porciones)</small>
                <strong>@Formato.Moneda(escalado.CostoTotal)</strong>
                <em>@Formato.Moneda(escalado.CostoPorPorcion) por porción</em>
            </div>
        </div>

        @if (!escalado.SinCostosFijos && escalado.CostoFijoProrrateado > 0)
        {
            <p class="text-muted mt-2 mb-0">
                <small>
                    La cuota fija se calcula sobre @escalado.FactorEscala.ToString("0.####")
                    preparación(es) equivalente(s): porciones deseadas ÷ rendimiento base
                    (@PorcionesBase porciones).
                </small>
            </p>
        }

        @if (fijosCargados && fijos.Count > 0)
        {
            <details class="cs-detalle" open>
                <summary>Costos fijos para el análisis (@seleccionados.Count de @fijos.Count)</summary>
                <div class="cs-fijos-acciones">
                    <small class="text-muted me-auto">Marca los que quieras sumar al costo completo.</small>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SeleccionarTodosFijos">Todos</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DeseleccionarTodosFijos">Ninguno</button>
                    @if (cargando) { <small class="text-muted">Recalculando...</small> }
                </div>
                <ul class="cs-fijos">
                    @foreach (var f in fijos)
                    {
                        <li>
                            <label>
                                <input type="checkbox" checked="@seleccionados.Contains(f.Id)"
                                       @onchange="(e) => AlternarFijo(f.Id, (bool)e.Value!)" />
                                <span>@f.Nombre</span>
                            </label>
                            <span class="cs-fijos-aporte">@Formato.Moneda(f.ValorDivisor > 0 ? f.MontoMensual / f.ValorDivisor : 0m)</span>
                        </li>
                    }
                </ul>
            </details>
        }

        <details class="cs-detalle" open>
            <summary>Ver insumos escalados</summary>
            <div class="table-responsive">
                <table class="table table-sm cs-table">
                    <thead>
                        <tr>
                            <th>Insumo</th>
                            <th class="text-end">Cantidad escalada</th>
                            <th class="text-end">A comprar (con merma)</th>
                            <th class="text-end">Costo</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in escalado.Lineas)
                    {
                        <tr>
                            <td>@l.Insumo</td>
                            <td class="text-end">@l.Cantidad.ToString("0.####") @l.UnidadReceta</td>
                            <td class="text-end">@l.CantidadParaComprar.ToString("0.####") @l.UnidadInsumo</td>
                            <td class="text-end">@Formato.Moneda(l.CostoInsumo)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
        <p class="text-muted mt-2 mb-0"><small>Simulación temporal: no modifica la receta base. El costo directo es la base del precio; los fijos se cubren con el punto de equilibrio.</small></p>
    }
</div>

@code {
    [Parameter] public int RecetaId { get; set; }
    [Parameter] public int PorcionesBase { get; set; }

    private EscaladoRecetaDto? escalado;
    private string? error, errorValidacion;
    private bool cargando;
    private string porcionesTexto = "";
    private int idCargado;
    private CancellationTokenSource? debounceCts;

    // Selección de costos fijos: por defecto no se marca ninguno.
    // El usuario los agrega solo si quiere analizar el costo completo.
    private List<CostoFijoDto> fijos = new();
    private readonly HashSet<int> seleccionados = new();
    private bool fijosCargados;

    // Costo de insumos por porción, sin la cuota de costos fijos.
    private decimal CostoDirectoPorPorcion => escalado is { PorcionesDeseadas: > 0 }
        ? decimal.Round(escalado.CostoInsumos / escalado.PorcionesDeseadas, 2)
        : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (RecetaId == idCargado) return;
        idCargado = RecetaId;
        porcionesTexto = PorcionesBase.ToString();
        await Cargar();
    }

    private async Task OnPorcionesInput(ChangeEventArgs e)
    {
        porcionesTexto = e.Value?.ToString() ?? "";
        errorValidacion = null;
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;
        try { await Task.Delay(300, token); }
        catch (TaskCanceledException) { return; }
        await Cargar();
        StateHasChanged();
    }

    private async Task Cargar()
    {
        error = null;
        if (!int.TryParse((porcionesTexto ?? "").Trim(), out var porciones) || porciones <= 0)
        {
            errorValidacion = "Ingresa un número de porciones mayor a 0.";
            escalado = null;
            return;
        }
        errorValidacion = null;
        cargando = true;
        // Se envía la selección actual. En la primera carga está vacía:
        // el escalado muestra el costo directo, sin absorber los fijos.
        var costosFijosIds = seleccionados.ToList();
        var tEscalado = Api.ObtenerEscaladoAsync(RecetaId, porciones, costosFijosIds);
        var tFijos = Api.ListarCostosFijosAsync();
        await Task.WhenAll(tEscalado, tFijos);
        cargando = false;
        var res = tEscalado.Result;
        if (!res.Exito) { error = res.Mensaje; escalado = null; return; }
        escalado = res.Datos;

        var resFijos = tFijos.Result;
        if (resFijos.Exito && resFijos.Datos is not null)
        {
            var anteriores = fijosCargados ? new HashSet<int>(seleccionados) : null;
            fijos = resFijos.Datos.Where(f => f.Activo).ToList();
            seleccionados.Clear();
            if (anteriores is not null)
            {
                // Conserva la selección del usuario; los fijos eliminados quedan fuera.
                foreach (var f in fijos.Where(f => anteriores.Contains(f.Id))) seleccionados.Add(f.Id);
            }
            // Primera carga: la selección queda vacía a propósito (costo directo).
        }
        fijosCargados = true;
    }

    private async Task AlternarFijo(int id, bool marcado)
    {
        if (marcado) seleccionados.Add(id);
        else seleccionados.Remove(id);
        await Cargar();
    }

    private async Task SeleccionarTodosFijos()
    {
        seleccionados.Clear();
        foreach (var f in fijos) seleccionados.Add(f.Id);
        await Cargar();
    }

    private async Task DeseleccionarTodosFijos()
    {
        seleccionados.Clear();
        await Cargar();
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}
