@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (hayImagenNueva)
{
    <div class="rc-crop-frame">
        <canvas id="@CanvasId" width="600" height="450" class="rc-crop-canvas"
                role="img" aria-label="Vista previa del recorte de @DescripcionImagen">
            Vista previa del recorte de @DescripcionImagen.
        </canvas>
    </div>
    <div class="rc-crop-zoom">
        <label for="@SliderId">Zoom del recorte</label>
        <input id="@SliderId" type="range" min="1" max="3" step="0.01" value="1" />
    </div>
    <div class="d-flex flex-wrap gap-2" role="group" aria-label="Mover la imagen dentro del recorte">
        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Mover a la izquierda" @onclick="() => Mover(-15, 0)">Izquierda</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Mover hacia arriba" @onclick="() => Mover(0, -15)">Arriba</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Mover hacia abajo" @onclick="() => Mover(0, 15)">Abajo</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Mover a la derecha" @onclick="() => Mover(15, 0)">Derecha</button>
    </div>
    <small class="rc-crop-hint">Ajusta el zoom y usa los botones de dirección o arrastra la imagen para encuadrarla.</small>
}
else
{
    <div class="rc-image-box">
        @if (MostrarActual)
        {
            <img src="@ImagenActualUrl" alt="Imagen actual de @DescripcionImagen" />
        }
        else
        {

            <div class="rc-image-placeholder"><span aria-hidden="true">🍽️</span><small>Sin imagen</small></div>
        }
    </div>
}

<div class="d-flex gap-2 mt-2 flex-wrap">
    <label for="@ArchivoId" class="rc-image-picker btn btn-sm btn-outline-secondary mb-0">
        @(hayImagenNueva || MostrarActual ? "Cambiar imagen" : "Elegir imagen")
        <InputFile id="@ArchivoId" class="visually-hidden" OnChange="AlElegirImagen" aria-describedby="@AyudaId"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
    </label>
    @if (hayImagenNueva)
    {
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Reiniciar">Reencuadrar</button>
    }
    @if (hayImagenNueva || MostrarActual)
    {
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="Quitar">Quitar</button>
    }
</div>
<small id="@AyudaId" class="text-muted d-block mt-1">JPG, PNG o WEBP, hasta 8 MB. Se recorta a 4:3 y se comprime sola.</small>
@if (error is not null)
{
    <div class="rc-error" role="alert">@error</div>
}

@code {
    [Parameter] public string? ImagenActualUrl { get; set; }
    [Parameter] public string DescripcionImagen { get; set; } = "la receta";

    public bool HayImagenNueva => hayImagenNueva;
    public bool QuitarImagenActual => quitarImagen;

    private const long MaxBytes = 8 * 1024 * 1024;
    private static readonly string[] Ext = { ".jpg", ".jpeg", ".png", ".webp" };
    private static readonly string[] Tipos = { "image/jpeg", "image/png", "image/webp" };

    private readonly string uid = Guid.NewGuid().ToString("N")[..8];
    private string CanvasId => $"crop-{uid}";
    private string SliderId => $"zoom-{uid}";
    private string ArchivoId => $"archivo-imagen-{uid}";
    private string AyudaId => $"ayuda-imagen-{uid}";

    private bool hayImagenNueva, quitarImagen, pendienteIniciar;
    private string? error;

    private bool MostrarActual => !quitarImagen && !string.IsNullOrEmpty(ImagenActualUrl);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pendienteIniciar) return;
        pendienteIniciar = false;
        try { await JS.InvokeVoidAsync("recetaCrop.iniciar", CanvasId, SliderId); } catch { }
    }

    private async Task AlElegirImagen(InputFileChangeEventArgs e)
    {
        error = null;
        var f = e.File;
        var ext = Path.GetExtension(f.Name).ToLowerInvariant();

        if (!Ext.Contains(ext) || !Tipos.Contains(f.ContentType))
        { error = "Solo se permiten imágenes JPG, PNG o WEBP."; return; }
        if (f.Size > MaxBytes)
        { error = "La imagen no puede superar los 8 MB."; return; }

        try
        {
            using var ms = new MemoryStream();
            await f.OpenReadStream(MaxBytes).CopyToAsync(ms);
            var dataUrl = $"data:{f.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            await JS.InvokeAsync<bool>("recetaCrop.cargar", CanvasId, dataUrl);
        }
        catch { error = "No se pudo leer la imagen. Prueba con otra."; return; }

        hayImagenNueva = true;
        quitarImagen = false;
        pendienteIniciar = true;   // se enlaza cuando el canvas ya existe en pantalla
    }

    private async Task Reiniciar()
    {
        try { await JS.InvokeVoidAsync("recetaCrop.reiniciar", CanvasId); } catch { }
    }

    private async Task Mover(int x, int y) => await JS.InvokeVoidAsync("recetaCrop.mover", CanvasId, x, y);

    private async Task Quitar()
    {
        hayImagenNueva = false;
        quitarImagen = true;
        error = null;
        try { await JS.InvokeVoidAsync("recetaCrop.liberar", CanvasId); } catch { }
    }

    // Devuelve el JPEG ya encuadrado (1200x900) o null si no hay imagen nueva.
    public async Task<byte[]?> ExportarAsync()
    {
        if (!hayImagenNueva) return null;
        var b64 = await JS.InvokeAsync<string?>("recetaCrop.exportar", CanvasId);
        return b64 is null ? null : Convert.FromBase64String(b64);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("recetaCrop.liberar", CanvasId); } catch { }
    }
}
