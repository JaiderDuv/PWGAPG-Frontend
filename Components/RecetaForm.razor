@using System.ComponentModel.DataAnnotations
@using System.Text
@using PWGAPG_Frontend.Models
@using PWGAPG_Frontend.Services
@inject RecetaApiService Api

<div class="rc-card rc-form">
    <div class="rc-card-header">
        <h5 class="mb-0">@(Editando is null ? "Nueva receta" : $"Editar receta #{Editando.Id}")</h5>
    </div>

    <EditForm EditContext="editContext" class="rc-card-body" novalidate>
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- Imagen -->
            <div class="col-lg-4">
                <label class="rc-label">Imagen de la receta</label>
                <ImageCropper @ref="cropper" ImagenActualUrl="@Api.UrlImagen(imagenActual)" />
            </div>

            <!-- Datos básicos -->
            <div class="col-lg-8">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="rc-label">Nombre *</label>
                        <InputText class="form-control" @bind-Value="modelo.Nombre"
                                   maxlength="100" placeholder="Ej: Salsa de tomate casera" />
                        <ValidationMessage For="() => modelo.Nombre" class="rc-error" />
                    </div>
                    <div class="col-md-4">
                        <label class="rc-label">Categoría</label>
                        <InputSelect class="form-select" @bind-Value="modelo.Categoria">
                            <option value="">Sin categoría</option>
                            @foreach (var c in CategoriasReceta.Lista)
                            {
                                <option value="@c.Valor">@c.Etiqueta</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="rc-label">Porciones *</label>
                        <InputNumber class="form-control" @bind-Value="modelo.PorcionesBase" min="1" max="1000" step="1" />
                        <ValidationMessage For="() => modelo.PorcionesBase" class="rc-error" />
                    </div>
                    <div class="col-12">
                        <label class="rc-label">Instrucciones <small class="text-muted">(@(modelo.Instrucciones?.Length ?? 0)/2000)</small></label>
                        <textarea class="form-control" rows="6" maxlength="2000"
                                  value="@modelo.Instrucciones"
                                  @oninput="e => modelo.Instrucciones = e.Value?.ToString()"
                                  placeholder="Paso a paso de la preparación..."></textarea>
                        <ValidationMessage For="() => modelo.Instrucciones" class="rc-error" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingredientes -->
        <h6 class="rc-section-title">Ingredientes</h6>
        <div class="table-responsive">
            <table class="table rc-table align-middle">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th style="width:150px">Cantidad</th>
                        <th style="width:120px">Unidad</th>
                        <th style="width:130px" class="text-end">Costo</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in modelo.Filas)
                    {
                        var tieneError = erroresFila.ContainsKey(fila);
                        <tr>
                            <td>
                                @if (fila.InsumoId == 0)
                                {
                                    <div class="rc-combo">
                                        <input type="text" class="form-control @(tieneError ? "is-invalid" : "")"
                                               placeholder="Buscar insumo..." maxlength="100" autocomplete="off"
                                               value="@fila.Busqueda"
                                               @oninput="e => AlEscribir(fila, e.Value?.ToString())"
                                               @onfocus="() => AbrirLista(fila)"
                                               @onblur="() => AlPerderFoco(fila)"
                                               @onkeydown="e => AlTecla(e, fila)" />
                                        @if (fila.MostrarLista)
                                        {
                                            var coincidencias = InsumosFiltrados(fila).ToList();
                                            <div class="rc-combo-lista">
                                                @for (var n = 0; n < coincidencias.Count; n++)
                                                {
                                                    var i = coincidencias[n];
                                                    var activo = n == fila.Indice;
                                                    var usado = YaElegido(i.Id, fila);
                                                    <button type="button" class="rc-combo-item @(activo ? "activo" : "")"
                                                            disabled="@usado"
                                                            title="@(usado ? "Ya está en otra línea de esta receta" : "")"
                                                            @onclick="() => SeleccionarInsumo(fila, i)">
                                                        <span class="rc-combo-nombre">@i.Nombre</span>
                                                        <small class="rc-combo-meta">@i.UnidadMedida · @Formato.Moneda(i.CostoUnitario)</small>
                                                    </button>
                                                }
                                                @if (coincidencias.Count == 0)
                                                {
                                                    <div class="rc-combo-vacio">Sin coincidencias para "@fila.Busqueda"</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="rc-combo-seleccionado">
                                        <span>@NombreInsumo(fila.InsumoId) <small class="text-muted">(@UnidadDeInsumo(fila.InsumoId))</small></span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => LimpiarInsumo(fila)">Cambiar</button>
                                    </div>
                                }
                            </td>
                            <td>
                                <InputNumber class="@ClaseInput(tieneError)" @bind-Value="fila.Cantidad"
                                             min="0.001" max="100000" step="0.001" />
                            </td>
                            <td>
                                <select class="form-select" @bind="fila.UnidadMedida">
                                    @foreach (var u in UnidadesCompatibles(fila))
                                    {
                                        <option value="@u">@u</option>
                                    }
                                </select>
                            </td>
                            <td class="text-end">@Formato.Moneda(CostoDeFila(fila))</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Quitar ingrediente" @onclick="() => QuitarFila(fila)">
                                    ✕
                                </button>
                            </td>
                        </tr>
                        @if (tieneError)
                        {
                            <tr class="rc-row-error"><td colspan="5"><div class="rc-error">@erroresFila[fila]</div></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AgregarFila"
                    disabled="@(modelo.Filas.Count >= 50)">
                + Agregar ingrediente
            </button>
            <div class="rc-costos">
                <span>Costo total: <strong>@Formato.Moneda(CostoTotal)</strong></span>
                <span>Por porción: <strong>@Formato.Moneda(CostoPorcion)</strong></span>
            </div>
        </div>
        @if (errorGeneral is not null)
        {
            <div class="rc-error mb-2">@errorGeneral</div>
        }

        @if (errorApi is not null)
        {
            <div class="alert alert-danger">@errorApi</div>
        }

        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-outline-secondary" @onclick="OnCancelar" disabled="@guardando">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="Enviar" disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar receta")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public RecetaDto? Editando { get; set; }
    [Parameter] public RecetaDto? Precarga { get; set; }   // para la IA más adelante
    [Parameter] public List<InsumoOpcionDto> Insumos { get; set; } = new();
    [Parameter] public EventCallback<string?> OnGuardado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private static string ClaseInput(bool conError) =>
        conError ? "form-control is-invalid" : "form-control";

    private FormModelo modelo = new();
    private EditContext editContext = default!;
    private readonly Dictionary<Fila, string> erroresFila = new();
    private string? errorGeneral, errorApi, imagenActual;
    private bool guardando;
    private ImageCropper? cropper;

    protected override void OnInitialized()
    {
        var origen = Editando ?? Precarga;
        imagenActual = Editando?.ImagenUrl;

        if (origen is null) modelo.Filas.Add(new Fila());
        else
        {
            modelo.Nombre = origen.Nombre;
            modelo.PorcionesBase = origen.PorcionesBase;
            modelo.Instrucciones = origen.Instrucciones;
            modelo.Categoria = origen.Categoria ?? "";
            modelo.Filas = origen.Insumos.Select(i => new Fila
            {
                InsumoId = i.InsumoId,
                Cantidad = i.Cantidad,
                UnidadMedida = i.UnidadMedida
            }).ToList();
            if (modelo.Filas.Count == 0) modelo.Filas.Add(new Fila());
        }
        editContext = new EditContext(modelo);
    }

    // ---------- Ingredientes ----------
    private void AgregarFila() => modelo.Filas.Add(new Fila());
    private void QuitarFila(Fila f) { modelo.Filas.Remove(f); erroresFila.Remove(f); }

    private bool YaElegido(int insumoId, Fila actual) =>
        modelo.Filas.Any(f => f != actual && f.InsumoId == insumoId);

    // ---------- Combo buscable de insumos ----------
    private static string Norm(string s)
    {
        var sb = new StringBuilder(s.Length);
        foreach (var ch in s.ToLowerInvariant())
            sb.Append(ch switch { 'á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ü' => 'u', _ => ch });
        return sb.ToString();
    }

    // Sin tildes ni mayúsculas; primero los que empiezan con lo escrito.
    private IEnumerable<InsumoOpcionDto> InsumosFiltrados(Fila fila)
    {
        var b = Norm((fila.Busqueda ?? "").Trim());
        var q = b.Length == 0 ? Insumos : Insumos.Where(i => Norm(i.Nombre).Contains(b));
        return q.OrderByDescending(i => b.Length > 0 && Norm(i.Nombre).StartsWith(b, StringComparison.Ordinal))
                .ThenBy(i => i.Nombre, StringComparer.OrdinalIgnoreCase);
    }

    private void AbrirLista(Fila f) { f.MostrarLista = true; f.Indice = 0; }

    private void AlEscribir(Fila f, string? texto)
    {
        f.Busqueda = texto ?? string.Empty;
        f.MostrarLista = true;
        f.Indice = 0;
    }

    private void AlTecla(KeyboardEventArgs e, Fila f)
    {
        var lista = InsumosFiltrados(f).ToList();
        switch (e.Key)
        {
            case "ArrowDown":
                if (lista.Count > 0) { f.MostrarLista = true; f.Indice = (f.Indice + 1) % lista.Count; }
                break;
            case "ArrowUp":
                if (lista.Count > 0) { f.MostrarLista = true; f.Indice = f.Indice <= 0 ? lista.Count - 1 : f.Indice - 1; }
                break;
            case "Enter":
                if (f.MostrarLista && f.Indice >= 0 && f.Indice < lista.Count && !YaElegido(lista[f.Indice].Id, f))
                    SeleccionarInsumo(f, lista[f.Indice]);
                break;
            case "Escape":
                f.MostrarLista = false;
                break;
        }
    }

    private void SeleccionarInsumo(Fila fila, InsumoOpcionDto insumo)
    {
        fila.InsumoId = insumo.Id;
        fila.UnidadMedida = insumo.UnidadMedida;   // unidad natural del insumo
        fila.Busqueda = "";
        fila.MostrarLista = false;
        erroresFila.Remove(fila);
    }

    private void LimpiarInsumo(Fila fila)
    {
        fila.InsumoId = 0;
        fila.UnidadMedida = "g";
        fila.Busqueda = "";
        fila.MostrarLista = false;   // se abre al hacer clic en el campo
    }

    // El blur se procesa con un retardo para que alcance a registrarse el clic en un item.
    private async Task AlPerderFoco(Fila fila)
    {
        await Task.Delay(150);
        fila.MostrarLista = false;
        await InvokeAsync(StateHasChanged);
    }

    private string NombreInsumo(int id) =>
        Insumos.FirstOrDefault(i => i.Id == id)?.Nombre ?? $"Insumo #{id}";

    private string UnidadDeInsumo(int id) =>
        Insumos.FirstOrDefault(i => i.Id == id)?.UnidadMedida ?? "";

    private IEnumerable<string> UnidadesCompatibles(Fila fila)
    {
        var insumo = Insumos.FirstOrDefault(i => i.Id == fila.InsumoId);
        return insumo is null ? ConversorUnidades.UnidadesDeLaMismaFamilia("g")
                              : ConversorUnidades.UnidadesDeLaMismaFamilia(insumo.UnidadMedida);
    }

    private decimal CostoDeFila(Fila f)
    {
        var i = Insumos.FirstOrDefault(x => x.Id == f.InsumoId);
        if (i is null || f.Cantidad <= 0) return 0;
        // CostoUnitario es el total del paquete (Cantidad): se divide para el precio por unidad.
        var costoPorUnidad = i.Cantidad.HasValue && i.Cantidad.Value > 0
            ? i.CostoUnitario / i.Cantidad.Value
            : i.CostoUnitario;
        return ConversorUnidades.CostoLinea(f.Cantidad, f.UnidadMedida, i.UnidadMedida, costoPorUnidad, i.PorcentajeMerma);
    }

    private decimal CostoTotal => modelo.Filas.Sum(CostoDeFila);
    private decimal CostoPorcion => modelo.PorcionesBase > 0 ? CostoTotal / modelo.PorcionesBase : 0;

    // ---------- Validación y guardado ----------
    private bool ValidarFilas()
    {
        erroresFila.Clear();
        errorGeneral = null;

        if (modelo.Filas.Count == 0) { errorGeneral = "Agrega al menos un ingrediente."; return false; }

        foreach (var f in modelo.Filas)
        {
            if (f.InsumoId == 0) erroresFila[f] = "Selecciona un insumo.";
            else if (modelo.Filas.Count(x => x.InsumoId == f.InsumoId) > 1) erroresFila[f] = "Este insumo está repetido.";
            else if (f.Cantidad <= 0) erroresFila[f] = "La cantidad debe ser mayor a 0.";
            else if (f.Cantidad > 100000) erroresFila[f] = "La cantidad no puede superar 100.000.";
            else if (decimal.Round(f.Cantidad, 3) != f.Cantidad) erroresFila[f] = "La cantidad admite máximo 3 decimales.";
        }
        if (erroresFila.Count > 0) errorGeneral = "Revisa los ingredientes marcados en rojo.";
        return erroresFila.Count == 0;
    }

    private async Task Enviar()
    {
        errorApi = null;
        var modeloOk = editContext.Validate();
        var filasOk = ValidarFilas();
        if (!modeloOk || !filasOk) return;
        await Guardar();
    }

    private async Task Guardar()
    {
        var dto = new GuardarRecetaDto
        {
            Nombre = modelo.Nombre.Trim(),
            PorcionesBase = modelo.PorcionesBase,
            Instrucciones = modelo.Instrucciones,
            Categoria = string.IsNullOrWhiteSpace(modelo.Categoria) ? null : modelo.Categoria,
            Insumos = modelo.Filas.Select(f => new RecetaInsumoDto
            {
                InsumoId = f.InsumoId,
                Cantidad = f.Cantidad,
                UnidadMedida = f.UnidadMedida
            }).ToList()
        };

        guardando = true;
        var res = Editando is null ? await Api.CrearAsync(dto) : await Api.ActualizarAsync(Editando.Id, dto);
        if (!res.Exito) { errorApi = res.Mensaje; guardando = false; return; }

        var id = res.Datos!.Id;
        string? aviso = null;

        if (cropper?.HayImagenNueva == true)
        {
            try
            {
                var bytes = await cropper.ExportarAsync();
                if (bytes is not null)
                {
                    var img = await Api.SubirImagenAsync(id, bytes, "receta.jpg", "image/jpeg");
                    if (!img.Exito) aviso = $"La receta se guardó, pero la imagen no se pudo subir: {img.Mensaje}";
                }
            }
            catch { aviso = "La receta se guardó, pero no se pudo procesar la imagen."; }
        }
        else if (cropper?.QuitarImagenActual == true && Editando?.ImagenUrl is not null)
        {
            await Api.EliminarImagenAsync(id);
        }

        guardando = false;
        await OnGuardado.InvokeAsync(aviso);
    }

    // ---------- Modelos del formulario ----------
    private class FormModelo
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "El nombre debe tener entre 3 y 100 caracteres.")]
        [RegularExpression(@"^(?=.*\p{L})[\p{L}\p{N} .,'\-()&]+$",
            ErrorMessage = "Solo letras, números, espacios y . , ' - ( ) & (debe incluir letras).")]
        public string Nombre { get; set; } = "";

        [Range(1, 1000, ErrorMessage = "Las porciones deben estar entre 1 y 1000.")]
        public int PorcionesBase { get; set; } = 1;

        [StringLength(2000, ErrorMessage = "Máximo 2000 caracteres.")]
        public string? Instrucciones { get; set; }

        public string Categoria { get; set; } = "";

        public List<Fila> Filas { get; set; } = new();
    }

    private class Fila
    {
        public int InsumoId { get; set; }
        public decimal Cantidad { get; set; }
        public string UnidadMedida { get; set; } = "g";
        // Estado del combo buscable de insumos (no se envía al backend).
        public string Busqueda { get; set; } = "";
        public bool MostrarLista { get; set; }
        public int Indice { get; set; }
    }
}