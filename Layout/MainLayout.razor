@inherits LayoutComponentBase
@inject PWGAPG_Frontend.Services.AuthService AuthService
@inject PWGAPG_Frontend.Services.PerfilService PerfilService
@inject NavigationManager Navigation
@implements IDisposable

<header class="navbar">
    <div class="logo-container">
        <NavLink href="" Match="NavLinkMatch.All" style="text-decoration: none; display: flex; align-items: center; gap: 12px;">
            <img src="assets/Logo.png" alt="Logo" class="logo-img" id="appLogo" />
            <span class="brand-title" id="appTitle">CHEF METRICS</span>
        </NavLink>
    </div>

    <nav class="nav-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        <NavLink class="nav-link" href="emprendimientos">Emprendimientos</NavLink>

        @if (AuthService.IsAuthenticated)
        {
            <NavLink class="nav-link" href="insumos">Insumos</NavLink>
            <div class="user-profile-menu">
                <button type="button" class="avatar-btn">
                    @if (!string.IsNullOrEmpty(AuthService.UrlFotoPerfil) && AuthService.UrlFotoPerfil != "images/default-avatar.png")
                    {
                        <img src="@AuthService.UrlFotoPerfil" alt="Foto perfil" class="avatar-img" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(AuthService.NombreEmpresa) ? "E" : AuthService.NombreEmpresa.Substring(0, 1).ToUpper())</span>
                    }
                </button>
                <button type="button" class="hamburger-btn" @onclick="ToggleMenu" aria-label="Abrir menú de usuario">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>

                @if (mostrarMenu)
                {
                    <div class="dropdown-menu-custom">
                        <div class="dropdown-header-custom">
                            <p class="dropdown-user-name">@(string.IsNullOrWhiteSpace(AuthService.NombreEmpresa) ? "Usuario" : AuthService.NombreEmpresa)</p>
                            <span class="dropdown-user-role">Emprendedor</span>
                        </div>

                        <NavLink class="dropdown-item-custom" href="editar-perfil-usuario" @onclick="() => mostrarMenu = false">
                            Mi Perfil
                        </NavLink>

                        <NavLink class="dropdown-item-custom" href="editar-perfil" @onclick="() => mostrarMenu = false">
                            Mi Emprendimiento
                        </NavLink>

                        <button type="button" class="dropdown-item-custom cerrar-sesion" @onclick="CerrarSesion">
                            Cerrar Sesión
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div id="authButtons" class="auth-group">
                <NavLink class="btn-outline" href="login">INICIAR SESIÓN</NavLink>
                <NavLink class="btn-solid" href="registro">REGISTRARSE</NavLink>
            </div>
        }
    </nav>
</header>

<main class="main-container">
    @Body
</main>

@code {
    private bool mostrarMenu = false;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        VerificarOnboardingPendiente();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        VerificarOnboardingPendiente();
    }

    private void VerificarOnboardingPendiente()
    {
        if (AuthService.IsAuthenticated &&
            !AuthService.OnboardingCompletado &&
            !Navigation.Uri.Contains("/onboarding", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("onboarding", replace: true);
        }
    }

    private void ToggleMenu()
    {
        mostrarMenu = !mostrarMenu;
    }

    private async Task CerrarSesion()
    {
        mostrarMenu = false;
        // Si había un permiso de edición de perfil activo, se revoca primero.
        await PerfilService.RevocarPermisoAsync();
        await AuthService.CerrarSesionAsync();
        Navigation.NavigateTo("/", replace: true);
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
