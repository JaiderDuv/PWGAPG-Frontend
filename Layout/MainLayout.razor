@inherits LayoutComponentBase
@inject PWGAPG_Frontend.Services.AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<header class="navbar">
    <div class="logo-container">
        <NavLink href="" Match="NavLinkMatch.All" style="text-decoration: none; display: flex; align-items: center; gap: 12px;">
            <img src="assets/Logo.png" alt="Logo" class="logo-img" id="appLogo" />
            <span class="brand-title" id="appTitle">CHEF METRICS</span>
        </NavLink>
    </div>

    <nav class="nav-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        <NavLink class="nav-link" href="emprendimientos">Emprendimientos</NavLink>

        @if (AuthService.IsAuthenticated)
        {
            <div class="user-profile-menu">
                <button type="button" class="avatar-btn" @onclick="ToggleMenu">
                    <span>@AuthService.NombreEmpresa.Substring(0, 1).ToUpper()</span>
                </button>

                @if (mostrarMenu)
                {
                    <div class="dropdown-menu-custom">
                        <button type="button" class="dropdown-item-custom" @onclick="CerrarSesion">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z" />
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
                            </svg>
                            Cerrar Sesión
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div id="authButtons" class="auth-group">
                <NavLink class="btn-outline" href="login">INICIAR SESIÓN</NavLink>
                <NavLink class="btn-solid" href="registro">REGISTRARSE</NavLink>
            </div>
        }
    </nav>
</header>

<main class="main-container">
    @Body
</main>

@code {
    private bool mostrarMenu = false;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    private void ToggleMenu()
    {
        mostrarMenu = !mostrarMenu;
    }

    private void CerrarSesion()
    {
        mostrarMenu = false;
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/", replace: true);
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}