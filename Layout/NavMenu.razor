@inject PWGAPG_Frontend.Services.AuthService AuthService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CHEF METRICS</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Inicio
            </NavLink>
        </div>

        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="insumos">Insumos</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="proveedores">Proveedores</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="recetas">Recetas</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu">Menú</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu/evaluacion">Rentabilidad</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="costos-fijos">Costos fijos</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="simulador">Simulador</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
