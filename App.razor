<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized Context="estado">
                    @if (estado.User.Identity?.IsAuthenticated == true)
                    {
                        <PageTitle>Acceso denegado | Chef Metrics</PageTitle>
                        <section class="access-denied" aria-labelledby="access-denied-title">
                            <div class="access-denied-card">
                                <h1 id="access-denied-title">Acceso denegado</h1>
                                <p>Tu rol actual no tiene permiso para acceder a esta sección.</p>
                                <a href="/" class="btn-solid">Volver al inicio</a>
                            </div>
                        </section>
                    }
                    else
                    {
                        <RedirigirALogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p role="status">Verificando sesión...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="#contenido-principal" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <h1>Página no encontrada</h1>
                <p>Lo sentimos, no hay nada en esta dirección.</p>
                <a href="/" class="btn-solid">Volver a Inicio</a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
